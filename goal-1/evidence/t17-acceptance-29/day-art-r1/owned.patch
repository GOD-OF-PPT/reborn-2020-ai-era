+/* The caller mounts this in the existing 160px desk plane with 850px perspective. */
+.day-continuity-art{position:absolute;inset:auto 0 0;width:100%;height:280px;transform-origin:50% 100%;transform:rotateX(58deg) rotateZ(-8deg);overflow:visible;pointer-events:none}
+.day-continuity-art .day-paper-shadow{fill:#14231e61}
+.day-continuity-art .day-paper-bottom{fill:#b9a884;stroke:#887c5c;stroke-width:1.2}
+.day-continuity-art .day-paper-sheet{fill:#f0e3c4;stroke:#bba57c;stroke-width:1.2}
+.day-continuity-art .day-paper-warm-sheet{fill:#e5d5ae;stroke:#b29d74;stroke-width:1.2}
+.day-continuity-art .day-paper-cover{fill:#63735b;stroke:#405844;stroke-width:1.5}
+.day-continuity-art .day-paper-ring{stroke:#a1874e;stroke-width:5;stroke-linecap:round}
+.day-continuity-art .day-paper-grid{stroke:#9c9876;stroke-width:1.1}
+.day-continuity-art .day-paper-clip{stroke:#aa894e;stroke-width:3;stroke-linecap:round}
+.day-continuity-art .day-paper-kept{fill:#f3e7c9;stroke:#aa9874;stroke-width:1.2}
+.day-continuity-art .day-paper-ink{stroke:#948d6c;stroke-width:1.4;stroke-linecap:round}
+.day-continuity-art .day-paper-perforation{stroke:#9b8964;stroke-width:1.2;stroke-dasharray:4 4}
+.day-continuity-art .day-paper-seam{stroke:#9c8d66;stroke-width:1.5}
+.day-continuity-art .day-paper-bookmark{fill:#b5965c;stroke:#8e7544;stroke-width:1}
+.day-continuity-art .day-paper-leaf{fill:#93a17e;stroke:#667851;stroke-width:1.2}
+.day-continuity-art .day-paper-tab{fill:#b49459;stroke:#8f7645;stroke-width:1.1}
+.day-continuity-art .day-paper-lens{fill:#9aaea34d;stroke:#d6d7b9;stroke-width:1.2}
+.day-continuity-art .day-paper-rim{stroke:#8d784f;stroke-width:5}
+.day-continuity-art .day-paper-handle{stroke:#50644d;stroke-width:9;stroke-linecap:round}
+.day-continuity-art .day-paper-archive-under{fill:#cfc8ad;stroke:#a59c7c;stroke-width:1.2}
+.day-continuity-art .day-paper-turned{fill:#e0d8bd;stroke:#a99e7b;stroke-width:1.2}
+.day-continuity-art .day-paper-fold-edge{stroke:#a28b59;stroke-width:1.5}
+.day-continuity-art .day-paper-stitches{stroke:#8d846a;stroke-width:2;stroke-linecap:round}
+.day-continuity-art .day-paper-continuation{fill:#d6b877;stroke:#9f8148;stroke-width:1.3}
+.day-continuity-art[data-state=history] .day-paper-bottom{fill:#ada68b}
+.day-continuity-art[data-state=carry] .day-paper-continuation{stroke-width:2}
