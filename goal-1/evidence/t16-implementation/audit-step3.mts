import {readFileSync,writeFileSync} from 'node:fs';
import {createHash} from 'node:crypto';
import {createCampaignCodec,createCampaignRun} from '../../../src/application/campaign.ts';
import {evaluateCommand} from '../../../src/core/commands.ts';
const root=new URL('./',import.meta.url),codec=createCampaignCodec(),sha=(x:string)=>createHash('sha256').update(x).digest('hex'),rows=readFileSync(new URL('exports.jsonl',root),'utf8').trim().split('\n').map(s=>JSON.parse(s)),result=[];
for(const row of rows){const raw=readFileSync(new URL(row.file,root),'utf8');if(sha(raw)!==row.sha256)throw Error('RAW_CHANGED');const saved=codec.import(raw),first=saved.receipts[0]!;let run=createCampaignRun({runId:saved.runId,actorId:saved.actorId,commandId:first.commandId,backgroundId:saved.backgroundId,seed:saved.seed,playerProfile:saved.playerProfile});for(const r of saved.receipts.slice(1)){const c={...JSON.parse(r.payloadSignature),commandId:r.commandId,expectedRevision:r.revisionBefore},out=evaluateCommand(run,c,codec.registry,run.actorId);if(out.status!=='proposed')throw Error('NORMAL_COMMAND_REJECTED');run=out.nextRun}if(codec.export(run)!==raw)throw Error('NOT_BYTE_EQUAL');result.push({file:row.file,source:row.source,runId:run.runId,revision:run.revision,origin:run.origin,sha256:row.sha256,fullNormalPrefixByteEqual:true})}
writeFileSync(new URL('step3-original-audit.json',root),JSON.stringify({task:'T16',scope:'steps1-3 only; not whole campaign acceptance',cases:result},null,2)+'\n',{flag:'wx'});console.log(JSON.stringify({exports:result.length,allFullNormalPrefixesByteEqual:true}));
