 expect(ui.all().filter(e=>e.type==='button'&&text(e.props.children).includes('为这一张已发生的原票，安排独立复核'))).toHaveLength(0)
 const safeDate=relayReviewDate(p,playableAdvanceDate(p.features.workbench,p.view.date,auditStart))
 if(safeDate===null)throw Error('ORIGINAL_PUBLIC_CLOCK_STOP_REQUIRED')
 expect(safeDate).toBe('2024-11-08');expect(safeDate<auditStart).toBe(true)
 const due=v.receivables.filter(invoice=>invoice.dueAt===safeDate&&invoice.amountFen>invoice.collectedFen+invoice.reversedFen&&v.customers.some(customer=>customer.id===invoice.customerId&&v.businesses.some(business=>business.id===customer.businessId&&p.view.accounts.some(account=>account.accountId===business.accountId))))
 expect(due).toHaveLength(1);expect(due[0]).toMatchObject({id:'rly:26fafc4431c01d61357e398bfe54d47b',date:'2024-10-25',dueAt:'2024-11-08',amountFen:720,collectedFen:0,reversedFen:0})
 expect(ui.all().some(e=>e.type==='button'&&text(e.props.children).includes(safeDate))).toBe(true)
 const deferred=relayDeferredFeedback(p,auditTarget)
 expect(deferred).toEqual({date:auditStart,label:'先继续原复核，待收款仍保留'})
 expect(ui.all().some(e=>e.type==='button'&&text(e.props.children).includes('先继续原复核，待收款仍保留 · '+auditStart))).toBe(true)
 ui.click('翻开这一次已委托的完整复核批次');expect(ui.text()).toContain(auditJobId)
