it('keeps a genuinely arranged single-meter audit as the same wait across progress, Reader, purpose and focus-open',()=>{
 const p=auditProps(),v=p.features.relay!,meter=v.meters.find(row=>row.id===auditTarget.meterId)!,existing=relayTicketAudit(p,auditTarget),raw=auditController.exportSaved(),request=vi.fn()
