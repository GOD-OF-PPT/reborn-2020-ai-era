 expect(relayFocusOpen(p,focus)).toBe(true);expect(purpose.attempt).toContain('已经委托');expect(purpose.finishWhen).toContain(auditStart);expect(purpose.finishWhen).toContain(existing.job!.completeAt);expect(purpose.finishWhen).toContain('不重复安排')
