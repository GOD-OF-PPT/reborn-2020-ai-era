 const p=panelProps(),base=targetFor(p),invoice=p.features.relay!.receivables.find(i=>i.dueAt<=p.view.date&&i.amountFen>i.collectedFen+i.reversedFen)!,meter=p.features.relay!.meters.find(m=>m.id===invoice.sourceId)!,target:RelaySceneTarget={...base,kind:'period',periodId:meter.periodId,meterId:meter.id},row=rowFor(p,target,'receivable',invoice.id),request=vi.fn(),change=vi.fn(),before=controller.exportSaved(),ui=consumerDriver('reader-original-evidence-retains-ticket',()=>RelayPanel({...p,request,initialTarget:target,initialFocusId:relayCasebookRecordId(row.key),onTargetChange:change}))
 ui.edit('本次收取金额','0.02');ui.click('展开这张票的完整原依据')
