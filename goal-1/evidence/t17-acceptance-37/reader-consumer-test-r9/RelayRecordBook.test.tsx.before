 const progress=relaySceneProgress(v,p.view.date,auditTarget,{runId:p.view.runId,accountId:p.accountId,operations:p.view.operations})!
 expect(progress.phase).toBe('audit-waiting');expect(progress.wait?.date).toBe(auditStart);expect(progress.command).toBeNull();expect(progress.recordId).toBe(meter.id)
