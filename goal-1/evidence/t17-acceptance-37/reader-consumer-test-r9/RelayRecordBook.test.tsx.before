 const operation:RelayCasebookOperation={id:operationId,kind:'pay_obligation',status:'applied',order:lastOrder+2,date:source.date,accountId:business.accountId,businessId:null,scopeBusinessId:business.id,contractId:null,sourceEventId:commandId,referenceId:null,amountFen:50,prepaymentId:null,obligationId:debt.id,dueAt:null,reservationId:null,originId:null,newOriginId:null,counterpartyId:null,targetAccountId:null,bucket:null,settlement:null}
 const afterBase={...before,revision:before.revision+1,receipts:[...before.receipts,{commandId,kind:'PayObligation',revisionAfter:before.revision+1,summary:'Public payment fixture only'}]}
 const after=alterBook(afterBase,b=>({...b,revision:afterBase.revision,obligationHistory:b.obligationHistory.map(o=>o.id===debt.id?{...o,remainingFen:50}:o),operations:[...b.operations,operation],transactions:[...b.transactions,{id:operationId,order:Math.max(...b.transactions.map(t=>t.order))+1,lineIndex:0,date:source.date,accountId:business.accountId,amountFen:-50,scopeBusinessId:business.id,businessId:business.id,contractId:null,sourceId:commandId,referenceId:debt.id}]}))
 return {before,after,operationId,commandId}
}
