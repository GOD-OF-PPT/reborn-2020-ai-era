// New consumer-fix cases use a separately scoped walker and controller. The
// original 15 cases, their driver, and their five-save setup remain untouched.
const consumerDriven=new Set([...driven,'RelayPreparationEditor','PreparationFields','SupplierField','SelectField','RelayPreparationSchedule','RelayBusiness','RelayPeriodCard','RelayJob','ClockAdvance','RelayCommandDetails'])
function consumerElements(value:unknown,path:string):Element[]{
 if(Array.isArray(value))return value.flatMap((child,index)=>consumerElements(child,path+'/'+index))
 if(!isValidElement<Record<string,unknown>>(value))return []
 const own=[value,...consumerElements(value.props.children,path+'/children'),...consumerElements(value.props.footer,path+'/footer')]
 if(typeof value.type==='function'&&consumerDriven.has(value.type.name)){const component=value.type as (props:Record<string,unknown>)=>unknown;own.push(...consumerElements(mounted(path+':'+component.name,()=>component(value.props)),path+'/render'))}
 return own
}
function consumerDriver(name:string,render:()=>unknown){
 let tree:unknown;const all=()=>consumerElements(tree,name),refresh=()=>{tree=mounted(name,render)};refresh()
 return {refresh,all,text:()=>all().map(node=>text(node.props.children)).join(' '),
  button(label:string){const node=all().find(e=>e.type==='button'&&text(e.props.children).includes(label));if(!node)throw Error('CONSUMER_BUTTON_REQUIRED:'+label);return node},
  click(label:string){const node=all().find(e=>e.type==='button'&&text(e.props.children).includes(label));if(!node||node.props.disabled||typeof node.props.onClick!=='function')throw Error('CONSUMER_ENABLED_BUTTON_REQUIRED:'+label);node.props.onClick();refresh()},
  edit(label:string,value:string){const parent=all().find(e=>e.type==='label'&&text(e.props.children).includes(label)),node=parent&&consumerElements(parent,name+'/field').find(e=>e.type==='input'||e.type==='select');if(!node||typeof node.props.onChange!=='function'||node.props.disabled)throw Error('CONSUMER_EDITABLE_FIELD_REQUIRED:'+label);node.props.onChange({target:{value}});refresh()},
 }
}
let auditController:GameController,auditStore:IndexedDbRunStore,auditBefore:PlayingView,auditAfter:PlayingView,auditTarget:Extract<RelaySceneTarget,{kind:'period'}>,auditStart:string,auditJobId:string,oldAdvance:Element,oldAdvanceCalls:unknown[][],oldAdvanceRequest:Mock<GamePanelProps['request']>
beforeAll(async()=>{
 const auditCodec=createCampaignCodec();auditStore=new IndexedDbRunStore({codec:auditCodec,factory:new IDBFactory(),keyRange:IDBKeyRange,name:'reader-single-meter-original86'})
 let sequence=0;auditController=new GameController({codec:auditCodec,store:auditStore,locks:new MemoryWriterAccess(),id:()=> 'reader-single-audit-'+(++sequence)})
 await auditController.initialize();await auditController.importNew(source86);auditBefore=auditController.snapshot.view!
 const f=features(auditBefore),business=f.relay!.businesses[0]!,station=f.relay!.stations.find(s=>s.businessId===business.id)!,period=f.relay!.periods.find(p=>p.businessId===business.id&&p.from==='2024-10-09')!,meter=f.relay!.meters.find(m=>m.periodId===period.id&&m.supplierId!==null&&m.auditedUnits===null&&!f.relay!.audits.some(a=>a.meterId===m.id))!
 expect(meter).toBeDefined()
 auditTarget={kind:'period',runId:auditBefore.runId,accountId:business.accountId,businessId:business.id,stationId:station.id,periodId:period.id,meterId:meter.id}
 const dates=[auditBefore.date,...(auditBefore.operations?.jobs.filter(job=>['planned','running'].includes(job.status)&&job.resources.includes('player-production')).map(job=>job.completeAt)??[])].sort()
 auditStart=addDays(dates.at(-1)!,1)
 expect(auditStart.slice(0,4)).toBe('2024')
 oldAdvanceRequest=vi.fn<GamePanelProps['request']>();const p:GamePanelProps={controller:auditController,view:auditBefore,features:f,accountId:business.accountId,request:oldAdvanceRequest,textOnly:true},panel=consumerDriver('reader-old-original-job',()=>RelayPanel({...p,initialTarget:auditTarget}))
 oldAdvance=panel.button('推进到本项中转任务完成');expect(oldAdvance.props.disabled).toBe(false)
 panel.click('推进到本项中转任务完成');expect(oldAdvanceRequest).toHaveBeenCalledTimes(1)
 oldAdvanceCalls=oldAdvanceRequest.mock.calls.map(row=>[...row])
 const command=auditController.prepare('StartRelayAudit',{meterId:meter.id,resources:['player-production'],startAt:auditStart})
 expect(auditController.preview(command).allowed).toBe(true);expect((await auditController.submit(command)).status).toBe('saved');auditAfter=auditController.snapshot.view!
 const jobs=features(auditAfter).relay!.auditJobs.filter(row=>!f.relay!.auditJobs.some(old=>old.jobId===row.jobId));expect(jobs).toHaveLength(1);auditJobId=jobs[0]!.jobId
},20000)
afterAll(async()=>{if(auditController)await auditController.close();else if(auditStore)await auditStore.close()})
function auditProps(view=auditController.snapshot.view!):GamePanelProps{const f=features(view);return {controller:auditController,view,features:f,accountId:auditTarget.accountId,request:vi.fn(),textOnly:true,relayRecordMemory:createRelayRecordMemory(view.runId),relayResponseDraftMemory:createRelayResponseDraftMemory(view.runId)}}

