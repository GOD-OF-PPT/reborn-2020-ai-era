})

it('renders captured renewal and requote terms through the real CommandDetails without rebinding to a newer public view',()=>{
 const p=panelProps(collection.before),v=p.features.relay!,base=targetFor(p),customer=v.customers.find(c=>c.businessId===base.businessId)!,resource=v.resources.find(r=>r.id==='player-production')!,offer=v.catalog.offers.find(o=>o.id==='managed_support')!,raw=controller.exportSaved(),account=(id:string)=>'原账户 '+id
 const renew:CommandEnvelope={runId:p.view.runId,actorId:'player',commandId:'captured-renewal-details',expectedRevision:p.view.revision,kind:'RenewRelayCustomer',payload:{customerId:customer.id,termEnd:'2025-01-01',mode:'postpaid',creditLimitFen:12345}},requote:CommandEnvelope={runId:p.view.runId,actorId:'player',commandId:'captured-requote-details',expectedRevision:p.view.revision,kind:'StartRelayRequote',payload:{businessId:base.businessId,customerIds:[customer.id],offerKind:'managed_support',unitPriceFen:7,effectiveAt:'2024-11-21',resources:['player-production'],startAt:'2024-11-13'}}
 const preview=(command:CommandEnvelope)=>controller.preview(command)
 const render=(command:CommandEnvelope,name:string)=>consumerDriver(name,()=>CommandDetails({command,confirm:preview(command),features:p.features,view:p.view,accountName:account,clock:null})).text()
 const renewal=render(renew,'reader-captured-renewal'),quote=render(requote,'reader-captured-requote'),number=v.customers.filter(c=>c.businessId===base.businessId).findIndex(c=>c.id===customer.id)+1
 expect(renewal).toContain('客户'+number);expect(renewal).toContain(customer.termEnd);expect(renewal).toContain('2025-01-01');expect(renewal).toContain('后付信用');expect(renewal).toContain(moneyText(12345));expect(renewal).toContain('旧余额')
 expect(quote).toContain('客户'+number);expect(quote).toContain(offer.label);expect(quote).toContain(moneyText(7));expect(quote).toContain(resource.label);expect(quote).toContain('2024-11-13');expect(quote).toContain('2024-11-20');expect(quote).toContain('2024-11-21');expect(quote).toContain('1点');expect(quote).toContain('7日')
 const altered=alter(p.view,r=>({...r,customers:r.customers.map(c=>c.id===customer.id?{...c,termEnd:'2025-12-31',creditLimitFen:99999}:c),resources:r.resources.map(r=>r.id===resource.id?{...r,label:'后来资源标签不应串入'}:r)}))
 expect(features(altered).relay!.customers.find(c=>c.id===customer.id)!.termEnd).toBe('2025-12-31')
 expect(render(renew,'reader-captured-renewal-after-new-view')).toBe(renewal);expect(render(requote,'reader-captured-requote-after-new-view')).toBe(quote);expect(quote).not.toContain('后来资源标签不应串入')
 for(const patch of [{hasCandidate:true},{readOnly:true,saveStatus:'read_only' as const}]){
  const view={...p.view,...patch},ui=consumerDriver('reader-confirmation-readonly-'+JSON.stringify(patch),()=>CommandDetails({command:renew,confirm:preview(renew),features:p.features,view,accountName:account,clock:null}))
  expect(ui.text()).toContain('2025-01-01');expect(ui.all().filter(e=>e.type==='button')).toHaveLength(0)
 }
 expect(controller.exportSaved()).toBe(raw)
})

it('keeps the original Panel job-advance payload but refuses the saved handler after another revision commits',()=>{
 expect(oldAdvanceCalls).toHaveLength(1)
 const [kind,payload,label]=oldAdvanceCalls[0]!,jobDates=auditBefore.operations!.jobs.filter(j=>['planned','running'].includes(j.status)).map(j=>j.completeAt)
 expect(kind).toBe('AdvanceTime');expect(label).toBe('推进到本项中转任务实际完成');expect(jobDates).toContain((payload as {date:string}).date)
 const raw=auditController.exportSaved(),baseline=oldAdvanceRequest.mock.calls.length
 if(typeof oldAdvance.props.onClick!=='function')throw Error('ORIGINAL_PANEL_JOB_HANDLER_REQUIRED')
 oldAdvance.props.onClick();expect(oldAdvanceRequest).toHaveBeenCalledTimes(baseline);expect(auditController.exportSaved()).toBe(raw)
})

it('lets an explicit deferred audit wait request the original Clock date while retaining the earlier invoice and saved bytes',()=>{
 const p=auditProps(),request=vi.fn<GamePanelProps['request']>(),raw=auditController.exportSaved(),deferred=relayDeferredFeedback(p,auditTarget),safeDate=relayReviewDate(p,playableAdvanceDate(p.features.workbench,p.view.date,auditStart))
 expect(deferred).toEqual({date:auditStart,label:'先继续原复核，待收款仍保留'});expect(safeDate).toBe('2024-11-08')
 const original:CommandEnvelope={runId:p.view.runId,actorId:'player',commandId:'display-preview',expectedRevision:p.view.revision,kind:'AdvanceTime',payload:{date:auditStart}}
 expect(p.controller.preview(original).allowed).toBe(true)
 const commitments=p.controller.clockCommitments(original)
 expect(commitments).toMatchObject({runId:p.view.runId,sourceRevision:p.view.revision,from:p.view.date,target:auditStart})
 const ui=consumerDriver('reader-explicit-deferred-audit-clock',()=>RelayRecordBook({p:{...p,request},target:auditTarget})),label='先继续原复核，待收款仍保留 · '+auditStart
 expect(ui.all().some(e=>e.type==='button'&&text(e.props.children).includes(safeDate!))).toBe(true)
 const main=ui.all().find(e=>typeof e.type==='function'&&e.type.name==='CommandButton'&&e.props.className==='clock-main'&&(e.props.payload as {date?:string}|undefined)?.date===auditStart),review=ui.all().find(e=>typeof e.type==='function'&&e.type.name==='CommandButton'&&e.props.className==='clock-review'&&(e.props.payload as {date?:string}|undefined)?.date===auditStart)
 if(!main||!review)throw Error('ORIGINAL_DEFERRED_CLOCK_BINDINGS_REQUIRED')
 expect(main.props.confirm).toBe(false);expect(review.props.confirm).toBe(true)
 expect(ui.button(label).props.disabled).toBe(false);ui.click(label)
 expect(request).toHaveBeenCalledExactlyOnceWith('AdvanceTime',{date:auditStart},main.props.label,false)
 expect(p.features.relay!.receivables.find(i=>i.id==='rly:26fafc4431c01d61357e398bfe54d47b')).toMatchObject({dueAt:'2024-11-08',amountFen:720,collectedFen:0,reversedFen:0})
 expect(auditController.exportSaved()).toBe(raw);expect(auditController.snapshot.view!.date).toBe(p.view.date);expect(auditController.snapshot.view!.budget).toEqual(p.view.budget)
})
