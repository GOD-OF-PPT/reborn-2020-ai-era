   ...jobLines(job),
   '公开批次完成标记 '+(batch.completed?'已完成':'未全部完成')+'；'+(completed?'已经实际复核，差额更正仍是独立决定':'未实际完成的实计仍未知，已耗成本与原记录保留'),
   ...all.map(audit=>{const meter=relay.meters.find(row=>row.id===audit.meterId);const revealed=completed&&audit.completedAt!==null&&audit.completedAt<=p.view.date&&meter?.auditedUnits!==null&&meter?.auditedUnits!==undefined;return '原审计 '+audit.id+'；原计量 '+audit.meterId+'；原期 '+shown(meter?.periodId)+'；原客户 '+shown(meter?.customerId)+'；完成 '+shown(audit.completedAt)+'；'+(revealed?'已公开实计 '+meter.auditedUnits+'单位':'实计待实际复核')})
  ]})
 }
 for(const correction of relay.corrections.filter(row=>meterIds.has(row.meterId))){
  const meter=meters.find(row=>row.id===correction.meterId)!
  const originalAudit=relay.audits.filter(a=>a.id===correction.auditId&&a.meterId===meter.id&&a.businessId===business.id&&a.completedAt!==null&&a.completedAt<=correction.date)
  if(originalAudit.length!==1||correction.date>p.view.date||meter.correctionId!==correction.id||correction.correctUnits!==originalAudit[0]!.actualUnits)throw Error('这张追加更正与原计量或已完成复核不一致，请核对。')
  for(const operationId of correction.operationIds)sourceIds.add(operationId)
  add({key:'correction:'+correction.id,recordId:correction.id,kind:'correction',correctionId:correction.id,periodId:meter.periodId,meterId:meter.id,auditId:correction.auditId,correctUnits:correction.correctUnits,title:correction.date+' · 原计量的追加更正',date:correction.date,state:'更正已经保存，结算与实收仍分别核对',attention:'record',ownership:'object',customerId:meter.customerId,...(meter.supplierId?{supplierId:meter.supplierId}:{}),...withTarget(periodTarget(meter.periodId,{meterId:meter.id})),lines:[
