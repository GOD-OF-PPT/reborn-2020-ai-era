  const movementLabels:Record<string,string>={supplier_prepay:'供应预付资产转入',consume_supplier:'原供应资产消耗',incur_supplier_usage:'原供应费用与应付',reverse_supplier_usage:'原供应成本更正',settle_supplier_credit:'用原贷项抵付原供应单（非现金）',refund_supplier:'供应未用资产实际退回',pay_obligation:'偿还这条供应的原应付'}
