  const poolOperations=history?.operations.filter(o=>o.scopeBusinessId===business.id&&(o.prepaymentId!==null&&pools.has(o.prepaymentId)||o.sourceEventId===supplierId))??[],poolOperationIds=new Set(poolOperations.map(o=>o.id)),supplierDebts=new Set(poolOperations.flatMap(o=>o.obligationId?[o.obligationId]:[]))
