import type {GamePanelProps} from './game-types.ts'
import type {ProductionJob} from '../core/operations-types.ts'
import {resolveRelaySceneTarget,type RelaySceneTarget} from './relay-scene-target.ts'
import {moneyText,reasonText} from './game-text.ts'
import type {RelayCasebookHistory} from '../application/relay-casebook-projection.ts'

export type RelayRecordKind='preparation'|'application'|'adapter'|'audience'|'customer'|'recharge'|'renewal'|'service'|'support'|'audit'|'meter'|'correction'|'receivable'|'collection'|'refund'|'supplier'|'obligation'|'quote'
export interface RelayRecordRow{
 key:string
 recordId:string
 kind:RelayRecordKind
 title:string
 date:string|null
 state:string
 summary?:readonly string[]
 lines:string[]
 attention:'due'|'known'|'pending'|'record'
 ownership:'object'|'station'
 customerId?:string
 supplierId?:string
 periodId?:string
 periodIds?:readonly string[]
 jobId?:string
 meterId?:string
 auditId?:string
 receivableId?:string
 obligationId?:string
 refundId?:string
 correctionId?:string
 quoteId?:string
 rechargeId?:string
 collectionId?:string
 renewalId?:string
 applicationId?:string
 audienceId?:string
 correctUnits?:number
 target?:RelaySceneTarget
}
type Input=Pick<GamePanelProps,'view'|'features'|'accountId'>
type Refund=NonNullable<Input['features']['relay']>['refunds'][number]
const kinds:readonly RelayRecordKind[]=['preparation','application','adapter','audience','customer','recharge','renewal','service','support','audit','meter','correction','receivable','collection','refund','supplier','obligation','quote']
const labels:Record<RelayRecordKind,string>={preparation:'开站准备',application:'供应来信',adapter:'线路适配',audience:'需求来信',customer:'客户原约',recharge:'客户充值',renewal:'续签原约',service:'服务原单',support:'原支持',audit:'复核批次',meter:'原计量',correction:'追加更正',receivable:'客户原款',collection:'实际收据',refund:'客户退款',supplier:'供应资产',obligation:'原未结责任',quote:'未来报价'}
export const relayRecordKindLabel=(kind:RelayRecordKind):string=>labels[kind]
const jobStates:Record<ProductionJob['status'],string>={planned:'已预留，尚未开工',running:'实际进行中',completed:'已经实际完成',interrupted:'已经中断，已耗投入保留',cancelled:'原安排已取消，旧责任另核'}
const refs=(values:readonly string[])=>values.length?values.join('、'):'无公开引用'
const shown=(value:string|null|undefined)=>value??'尚无原记录'
const waiting=(job:ProductionJob|null)=>job?.status==='planned'||job?.status==='running'
const compare=(a:string,b:string)=>a<b?-1:a>b?1:0
const unique=(rows:readonly unknown[],key:(row:never)=>string)=>{const seen=new Set<string>();for(const row of rows){const id=key(row as never);if(seen.has(id))throw Error('原记录身份重复，先核对同一张原票。');seen.add(id)}}
const plainState:Record<string,string>={prepaid:'预付',postpaid:'后付',planned:'已安排',running:'进行中',support:'支持与原账继续',settling:'仍在结算',closed:'已结',stopped:'已停止，旧责任保留',guided:'集中支持',self:'自行支持',assisted:'已授权辅助支持',delegated:'已授权委托支持'}

/** Only saved public rows are read. This model never previews or creates a command. */
export function relayRecordRows(p:Input,target:RelaySceneTarget|null):{reason:string|null;rows:RelayRecordRow[]}{
 try{return buildRows(p,target)}catch(error){return {reason:error instanceof Error&&/^[\u3400-\u9fff]/.test(error.message)?error.message:'原记录来源不一致，请重新核对。',rows:[]}}
}
function buildRows(p:Input,target:RelaySceneTarget|null):{reason:string|null;rows:RelayRecordRow[]}{
 const relay=p.features.relay,resolved=resolveRelaySceneTarget(relay,target,{runId:p.view.runId,accountId:p.accountId,operations:p.view.operations})
 if(resolved.status!=='valid'||!relay||!target)return {reason:resolved.reason??'先明确选择一份原服务或本站记录；没有翻到另一间站。',rows:[]}
 for(const rows of [relay.preparations,relay.applications,relay.adapters,relay.audiences,relay.offers,relay.customers,relay.periods,relay.meters,relay.audits,relay.corrections,relay.receivables,relay.refunds,relay.quotes])unique(rows,row=>(row as {id:string}).id)
 unique(relay.auditJobs,row=>(row as {jobId:string}).jobId)
 unique(p.features.workbench.finance,row=>(row as {accountId:string}).accountId)
 const business=resolved.business!,ownPeriods=relay.periods.filter(period=>period.businessId===business.id)
 if(business.company&&relay.businesses.filter(b=>b.company&&b.accountId===business.accountId).length!==1)throw Error('本站企业账户不唯一，不能把共享义务归到另一间站。')
 const originalJobs=p.view.operations?.jobs??[]
 unique(originalJobs,row=>(row as {id:string}).id)
 const checkJob=(source:ProductionJob|null,jobId:string)=>{const original=originalJobs.find(j=>j.id===jobId);if(!source||!original||source.id!==jobId||source.businessId!==business.id||original.businessId!==business.id||source.definitionId!==original.definitionId||source.actionId!==original.actionId||source.contractId!==original.contractId||source.status!==original.status||source.startAt!==original.startAt||source.completeAt!==original.completeAt||source.releasedAt!==original.releasedAt||source.outputId!==original.outputId||source.resources.length!==original.resources.length||!source.resources.every((r,i)=>r===original.resources[i]))throw Error('这份原任务与本站原记录不一致，请重新核对。')}
 const ownCustomers=relay.customers.filter(customer=>customer.businessId===business.id)
 for(const c of ownCustomers)unique(c.terms,row=>(row as {id:string}).id)
 const customerIds=new Set(target.kind==='application'?[]:target.kind==='customer'?[target.customerId]:target.kind==='audience'?ownCustomers.filter(customer=>customer.originAudienceId===target.audienceId).map(customer=>customer.id):target.kind==='period'&&resolved.meter?[resolved.meter.customerId]:target.kind==='period'?resolved.period!.customerIds:ownCustomers.map(customer=>customer.id))
 const childJob=target.kind==='period'&&target.jobId!==undefined,childMeter=target.kind==='period'&&target.meterId!==undefined
 const selectedAudit=childJob?resolved.audit:null
 const periods=target.kind==='application'?[]:target.kind==='period'?(selectedAudit?ownPeriods.filter(period=>selectedAudit.periodIds.includes(period.id)):[resolved.period!]):ownPeriods.filter(period=>target.kind==='business'||period.customerIds.some(id=>customerIds.has(id)))
 const periodIds=new Set(periods.map(period=>period.id))
 const selectedAuditMeters=new Set(selectedAudit?relay.audits.filter(audit=>audit.jobId===selectedAudit.jobId&&audit.businessId===business.id).map(audit=>audit.meterId):[])
 if(selectedAudit)for(const meter of relay.meters)if(periodIds.has(meter.periodId)&&selectedAuditMeters.has(meter.id))customerIds.add(meter.customerId)
 const meters=relay.meters.filter(meter=>periodIds.has(meter.periodId)&&(childMeter?meter.id===target.meterId:selectedAudit?selectedAuditMeters.has(meter.id):childJob?false:customerIds.has(meter.customerId)))
 const meterIds=new Set(meters.map(meter=>meter.id)),rows:RelayRecordRow[]=[]
 const base={runId:target.runId,accountId:target.accountId,businessId:target.businessId,stationId:target.stationId}
 const periodTarget=(periodId:string,child?:{meterId:string}|{jobId:string}):RelaySceneTarget=>({...base,kind:'period',periodId,...child})
 const withTarget=(candidate:RelaySceneTarget)=>{const resolution=resolveRelaySceneTarget(relay,candidate,{runId:p.view.runId,accountId:p.accountId,operations:p.view.operations});if(resolution.status!=='valid')throw Error(resolution.reason??'这张原票的来源已失效，请重新选择。');return {target:candidate}}
 for(const period of periods)withTarget(periodTarget(period.id))
 const customerName=(id:string)=>{const index=ownCustomers.findIndex(customer=>customer.id===id);if(index<0)throw Error('原客户身份不属于本站，请核对同一份原约定。');return '客户'+(index+1)}
 const customerRef=(id:string)=>customerName(id)+' · '+id
 const ownAuditJobs=relay.auditJobs.filter(audit=>audit.businessId===business.id)
 const ownInvoices=relay.receivables.filter(invoice=>ownCustomers.some(customer=>customer.id===invoice.customerId))
 const supplierName=(id:string|null)=>id===null?'未形成供应服务':relay.catalog.suppliers.find(supplier=>supplier.id===id)?.label??'原供应 '+id
 const add=(row:RelayRecordRow)=>rows.push({...row,summary:row.summary??summaryFor(row)})
 const finance=p.features.workbench.finance.find(finance=>finance.accountId===business.accountId)
 const supplied=(relay as typeof relay&{casebook?:RelayCasebookHistory}).casebook
 if(supplied?.status==='ready'&&(supplied.runId!==p.view.runId||supplied.revision!==p.view.revision||supplied.asOf!==p.view.date))throw Error('逐笔原账不属于当前这份已保存记录，请重新核对。')
 const history=supplied?.status==='ready'&&supplied.runId===p.view.runId&&supplied.revision===p.view.revision&&supplied.asOf===p.view.date?supplied:null
 const ownCollections=history?.collections.filter(collection=>collection.scopeBusinessId===business.id)??[]
 const historyNote=history?[]:[supplied?.reason??'逐笔付款与原投入明细尚未取得；已知原约和原账仍可翻阅，未列明不等于零或已经付清。']
 if(history){
  for(const list of [history.recharges,history.collections,history.renewals,history.obligationHistory,history.operations])unique(list,row=>(row as {id:string}).id)
  unique(history.actions,row=>(row as {definition:{id:string}}).definition.id)
  unique(history.transactions,row=>{const r=row as {id:string;lineIndex:number};return r.id+':'+r.lineIndex})
  const owns=(owner:string,account:string)=>relay.businesses.some(b=>b.id===owner&&b.accountId===account)
  for(const item of [...history.recharges,...history.collections,...history.renewals,...history.obligationHistory])if(!owns(item.scopeBusinessId,item.accountId))throw Error('逐笔原账的账户与本站不一致，请核对原来源。')
  for(const op of history.operations)if(!owns(op.scopeBusinessId,op.accountId)&&!(op.kind==='owner_transfer'&&op.accountId==='personal'&&op.targetAccountId&&owns(op.scopeBusinessId,op.targetAccountId)))throw Error('原财务操作不属于同一账户，请核对原记录。')
  for(const cash of history.transactions)if(!owns(cash.scopeBusinessId,cash.accountId)&&!(cash.accountId==='personal'&&history.operations.some(o=>o.id===cash.id&&o.kind==='owner_transfer'&&o.scopeBusinessId===cash.scopeBusinessId)))throw Error('原现金流水不属于本站，请核对原账户。')
 }
 const jobLines=(job:ProductionJob|null):string[]=>{if(!job)return ['原任务尚无完整记录，不能认作完成。'];const action=history?.actions.find(a=>a.jobId===job.id&&a.definition.id===job.actionId&&a.scopeBusinessId===business.id);const metrics=finance?.metrics.filter(m=>(m.sourceEventId===job.id||m.sourceEventId===job.actionId)&&m.kind==='cost')??[];return [
  ...(action?['原行动状态 '+({draft:'尚未预留',reserved:'已经预留',executed:'已经实际执行',completed:'已经实际完成',interrupted:'已经中断',cancelled:'已经取消'}[action.status])+'；原工作投入 '+moneyText(action.definition.costFen)+' / '+action.definition.actionPoints+'点；预留 '+action.plannedAt+'；实际执行 '+shown(action.executedAt)+'；实际结束 '+shown(action.finishedAt),'原占款 '+action.definition.cashReservationId+'；原执行日程 '+action.definition.startAt+'—'+action.definition.completeAt+'；原结算日期 '+action.definition.settlementAt]:historyNote),
  ...metrics.map(m=>'原成本记录 '+m.operationId+' · '+m.date+' · '+moneyText(m.deltaFen)+'；实际现金与尚欠费用另核'),
 ]}
 for(const list of [relay.preparations,relay.applications,relay.adapters,relay.quotes] as const)for(const item of list.filter(r=>r.businessId===business.id))checkJob(item.job,item.jobId)
 for(const item of relay.audiences.filter(a=>a.businessId===business.id&&a.jobId!==null))checkJob(item.job,item.jobId!)
 const refundDetails=(refund:Refund)=>{
  const obligations=history?.obligationHistory.filter(o=>o.scopeBusinessId===business.id&&refund.operationIds.includes(o.originOperationId))??[],later=history?.operations.filter(o=>o.scopeBusinessId===business.id&&o.kind==='pay_obligation'&&o.obligationId!==null&&obligations.some(d=>d.id===o.obligationId))??[],ids=new Set([...refund.operationIds,...later.map(o=>o.id)])
  const cash=history?.transactions.filter(t=>t.scopeBusinessId===business.id&&t.accountId===business.accountId&&ids.has(t.id)&&obligations.some(o=>o.id===t.referenceId&&(o.originOperationId===t.id||later.some(paid=>paid.id===t.id&&paid.obligationId===o.id))))??[]
  return {obligations,cash,paid:cash.reduce((n,t)=>n-t.amountFen,0),unpaid:obligations.reduce((n,o)=>n+o.remainingFen,0)}
 }
 function summaryFor(row:RelayRecordRow):readonly string[]{
  const customer=row.customerId?ownCustomers.find(c=>c.id===row.customerId):undefined
  if(row.kind==='customer'&&customer)return [
   (plainState[customer.mode]??'原付款方式')+'；合同至 '+customer.termEnd+(customer.closedAt?'；'+customer.closedAt+'已关闭':''),
   '原未消费充值（受保护）'+moneyText(customer.balance.prepaidFen)+'；应收 '+moneyText(customer.balance.receivableFen)+'，其中到期 '+moneyText(customer.dueReceivableFen),
   '当前原单位价 '+moneyText(customer.activeTerms.unitPriceFen)+'；支持周期基准 '+moneyText(customer.activeTerms.serviceFeeFen)+'，旧账不追改',
   '原信用上限 '+moneyText(customer.creditLimitFen)+'；月度单位上限 '+customer.monthlyUnits,
  ]
  if(row.kind==='meter'){const m=relay!.meters.find(m=>m.id===row.meterId)!;return [
   m.date+'的原计量；报告 '+m.reportedUnits+'单位',
   m.auditedUnits===null?'实计尚未独立复核，不能当作零用量。':'独立复核实计 '+m.auditedUnits+'单位；差额 '+(m.auditedUnits-m.reportedUnits)+'单位；'+(m.correctionId?'原更正已追加':'追加更正仍另行决定'),
   '冻结收费 '+moneyText(m.unitPriceFen)+' / 千单位；冻结供价 '+moneyText(m.unitCostFen)+' / 千单位',
   ...(m.supplierDueAt?['原供应到期日 '+m.supplierDueAt]:[]),...(m.reason?[reasonText(m.reason)]:[]),
  ]}
  if(row.kind==='receivable'){const r=relay!.receivables.find(r=>r.id===row.receivableId)!,remaining=r.amountFen-r.collectedFen-r.reversedFen;return [
   '原金额 '+moneyText(r.amountFen)+'；累计实收 '+moneyText(r.collectedFen)+'；冲回 '+moneyText(r.reversedFen),
   '净未收 '+moneyText(remaining)+'；开单 '+r.date+'；原到期 '+r.dueAt,
   remaining===0?'这张原单净未收为零；旧款不再次记收入。':r.dueAt>p.view.date?'这张原单尚未到期，不能提前收或当可花现金。':'可显选这张原单的本次收款金额；整客户到期收款是另一项决定。',
  ]}
  if(row.kind==='correction'){const c=relay!.corrections.find(c=>c.id===row.correctionId)!,newInvoices=relay!.receivables.filter(r=>c.operationIds.includes(r.operationId)),newDebts=history?.obligationHistory.filter(o=>o.scopeBusinessId===business.id&&c.operationIds.includes(o.originOperationId))??[];return [
   c.date+'追加；原报告 '+c.originalReportedUnits+'单位 → 已核 '+c.correctUnits+'单位',
   '客户收入调整 '+moneyText(c.customerDeltaFen)+'；供应成本调整 '+moneyText(c.supplierDeltaFen)+'；不是本次现金实收',
   ...newInvoices.map(r=>'追加原单 '+r.date+'开单 / '+r.dueAt+'到期；净未收 '+moneyText(r.amountFen-r.collectedFen-r.reversedFen)),
   ...newDebts.map(o=>'本次原义务 '+o.date+'到期；当前尚欠 '+moneyText(o.remainingFen)),...(!history?historyNote:[]),
  ]}
  if(row.kind==='refund'){const r=relay!.refunds.find(r=>r.id===row.refundId)!,facts=refundDetails(r);return [
   r.date+'登记退款 '+moneyText(r.amountFen),
   ...(history?['按原引用实际付出退款现金 '+moneyText(facts.paid)+'；尚欠退款 '+moneyText(facts.unpaid)]:historyNote),
   '原充值批次、客户未消费余额与保护另列；本站退款不自动归到眼前本期。',
  ]}
  if(row.kind==='supplier'){const option=relay!.supplyOptions.find(o=>o.businessId===business.id&&o.supplierId===row.supplierId)!,supplier=relay!.catalog.suppliers.find(s=>s.id===row.supplierId)!;return [
   supplier.label+' · 本站共用供应资产与贷项 '+moneyText(option.credit?.remainingFen??0)+'；该供应未付 '+moneyText(option.outstandingFen),
   '这是本站跨期余额，不是本期利润；退回未用资产不记收入。',
   (option.permitted?'已有亲读有效许可':'尚无亲读有效许可')+'；'+(option.adapted?'已有实际适配':'尚缺实际适配')+'；'+(plainState[supplier.billing]??'沿原账期'),
  ]}
  if(row.kind==='obligation'){const o=(history?.obligationHistory??finance?.obligations??[]).find(o=>o.id===row.obligationId)!,protection=o.protectionReservationId?finance?.reservations.find(r=>r.id===o.protectionReservationId):undefined;return [
   '原额 '+moneyText(o.amountFen)+'；当前未结 '+moneyText(o.remainingFen)+'；原义务日 '+o.date,
   o.protectionReservationId?(protection?'原保护约束当前 '+moneyText(protection.amountFen):'原保护引用保留；当前保护余额另按原账核对。'):'这项原义务没有客户保护付款引用。',
   row.ownership==='station'?'这是本站原义务；尚未唯一绑定眼前这期，不能冒称本期新增费用。':'原款按原允许账户处理；欠款不靠未来收入抹去。',
  ]}
  if(row.kind==='recharge'){const r=history!.recharges.find(r=>r.id===row.rechargeId)!;return [r.date+'收到原充值 '+moneyText(r.amountFen)+'，同时形成客户保护和负债；不是收入。','本批累计消费 '+moneyText(r.usedFen)+'；已记退款 '+moneyText(r.refundedFen)+'；当前未用净额 '+moneyText(r.amountFen-r.usedFen-r.refundedFen)]}
  if(row.kind==='collection'){const r=history!.collections.find(r=>r.id===row.collectionId)!;return [r.date+'实际收到原款 '+moneyText(r.amountFen),'对应原应收回收，不重复确认收入；原单已收、冲回与余款分别核对。']}
  if(row.kind==='renewal'){const r=history!.renewals.find(r=>r.id===row.renewalId)!;return [r.date+'保存原续签；合同期限至 '+r.termEnd,(plainState[r.mode]??'原付款方式')+'；信用上限 '+moneyText(r.creditLimitFen)+'；旧价格与旧应收不被续签重写。']}
  const job=row.jobId?p.view.operations?.jobs.find(j=>j.id===row.jobId&&j.businessId===business.id):undefined,action=job?history?.actions.find(a=>a.jobId===job.id&&a.definition.id===job.actionId&&a.scopeBusinessId===business.id):undefined
  const result:string[]=[row.state]
  if(job){
   result.push('原日程 '+job.startAt+'—'+job.completeAt+'；'+jobStates[job.status])
   if(action){
    const execution=action.status==='cancelled'?(action.executedAt===null?'已取消，尚未实际开工；未执行的原预留按原账释放':'原安排已取消；实际执行于'+action.executedAt+'，已发生投入保留')
     :action.status==='draft'?'尚未预留'
     :action.status==='reserved'?'已预留，尚未实际执行'
     :action.executedAt!==null?'已实际执行于'+action.executedAt+'，已耗投入保留；实际现金与未付费用分别核'
     :'原安排已停止或结束，尚无实际执行日期；费用与预留按原账核对'
    result.push('原动作约定成本 '+moneyText(action.definition.costFen)+' / '+action.definition.actionPoints+'点；'+execution)
   }else result.push(...historyNote)
  }
  if(row.kind==='application'){const a=relay!.applications.find(a=>a.id===row.applicationId)!;result.push(a.read?(a.approved?'已亲读批准，许可至 '+shown(a.expiresAt):'已亲读未获批准；申请成本保留'):'回信尚未亲读，批准与有效期未知。')}
  if(row.kind==='audit')result.push('原完整批次 '+relay!.auditJobs.find(a=>a.jobId===row.jobId)!.meterCount+'条，涉及 '+(row.periodIds?.length??0)+'期；当前子集不代表全部批次。')
  if(row.kind==='service'||row.kind==='support'){const period=relay!.periods.find(t=>t.id===row.periodId)!;result.push('原范围 '+period.from+'—'+period.to+'；'+period.customerIds.length+'位客户；容量上限 '+period.maxUnits+'，供应预算上限 '+moneyText(period.maxSupplierCostFen));if(row.kind==='support')result.push(finance?'本期原支持已确认收入 '+moneyText(finance.metrics.filter(m=>m.sourceEventId===period.id&&m.kind==='income').reduce((n,m)=>n+m.deltaFen,0))+'；支持费与本次现金到账分开。':'原支持收入明细尚未取得，不能当成零收入。')}
  if(row.kind==='quote'){const q=relay!.quotes.find(q=>q.id===row.quoteId)!;result.push('拟生效 '+q.effectiveAt+'；单位价 '+moneyText(q.unitPriceFen)+'；周期支持基准 '+moneyText(q.serviceFeeFen));result.push(q.completedAt!==null&&q.completedAt<=p.view.date&&q.job?.status==='completed'?'实际接受 '+q.responses.filter(r=>r.accepted).length+' / '+q.responses.length+'位，拒绝者保旧约。':'重谈尚未实际完成，答复未知；旧约照常。')}
  return result
 }
 const businessTarget:RelaySceneTarget={...base,kind:'business'}
 for(const application of relay.applications.filter(a=>a.businessId===business.id&&(target.kind==='business'||target.kind==='application'&&a.id===target.applicationId))){
