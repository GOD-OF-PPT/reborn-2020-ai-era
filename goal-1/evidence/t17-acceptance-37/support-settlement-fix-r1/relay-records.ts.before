 if(history)for(const collection of history.collections.filter(c=>c.scopeBusinessId===business.id&&invoices.some(i=>i.id===c.receivableId))){const invoice=invoices.find(i=>i.id===collection.receivableId)!;add({key:'collection:'+collection.id,recordId:collection.id,kind:'collection',collectionId:collection.id,receivableId:invoice.id,customerId:collection.customerId,title:customerName(collection.customerId)+' · 收据'+(ownCollections.findIndex(original=>original.id===collection.id)+1)+' · '+collection.date+'实收'+moneyText(collection.amountFen),date:collection.date,state:'这笔原客户款已经实际收到',attention:'record',ownership:'object',...withTarget({...base,kind:'customer',customerId:collection.customerId}),lines:['原收款 '+collection.id+' · '+collection.date+' · '+moneyText(collection.amountFen),'原应收 '+collection.receivableId+'；原现金操作 '+collection.operationId+'；这是原债权回收，不重复确认收入。']})}
