     '原支持方式 '+plainState[period.supportMode]+'；服务任务 '+period.jobId+'；支持任务 '+period.supportJobId+'；实际停期 '+shown(period.stoppedAt),
     '原支持费处理日 '+shown(period.feePostedAt)+'；原赔付处理日 '+shown(period.compensatedAt)+'；有处理记录不等于所有钱已实付',
     ...period.feeQuotes.map(quote=>'原支持报价 '+customerRef(quote.customerId)+'；条款 '+quote.termsId+'；周期基准 '+moneyText(quote.amountFen)+'，实际支持与已服务日另核'),
     ...(support?(finance?.metrics.filter(m=>m.sourceEventId===period.id&&m.kind==='income')??[]).map(m=>'原支持已确认收入 '+moneyText(m.deltaFen)+' · '+m.date+'；操作 '+m.operationId+'；客户/合同 '+shown(m.contractId)+'；这不是本次现金到账'):[]),
     ...jobLines(job),
     ...(support?['支持与服务是两份原任务；中断不会等待免费重做，支持费、赔付和旧应付仍按实际原账处理。']:['报告不代替独立实计；未服务不计用量收入，停止不退还已耗投入。']),
     ...relay.observations.filter(observation=>observation.periodId===period.id).map(observation=>'原观测 '+observation.id+' · '+observation.date+'；故障域 '+observation.domain+'；供应 '+refs(observation.supplierIds)+'；原因 '+reasonText(observation.reason)),
    ]})
  }
 }
 for(const meter of meters){
  sourceIds.add(meter.id);if(meter.costOperationId)sourceIds.add(meter.costOperationId)
  const completedAudits=relay.audits.filter(a=>a.meterId===meter.id&&a.completedAt!==null&&a.completedAt<=p.view.date)
  if(completedAudits.length>1||completedAudits.some(a=>a.businessId!==business.id||a.actualUnits!==meter.auditedUnits))throw Error('这张计量的复核来源不唯一或不一致，请核对原批次。')
  const audit=completedAudits[0]
  const known=meter.auditedUnits!==null,pending=known&&meter.auditedUnits!==meter.reportedUnits&&meter.correctionId===null
  if(known&&!audit)throw Error('这张计量没有匹配的已完成原复核，不能替填实计。')
  add({key:'meter:'+meter.id,recordId:meter.id,kind:'meter',periodId:meter.periodId,meterId:meter.id,...(audit?{auditId:audit.id,correctUnits:meter.auditedUnits!}:{}),...(meter.correctionId?{correctionId:meter.correctionId}:{}),title:meter.date+' · '+customerName(meter.customerId)+'的原计量',date:meter.date,state:meter.correctionId?'原更正已经追加':pending?'已知差额仍待更正':known?'已有独立复核':'实计待独立复核',attention:pending?'known':known?'record':'pending',ownership:'object',customerId:meter.customerId,...(meter.supplierId?{supplierId:meter.supplierId}:{}),...withTarget(periodTarget(meter.periodId,{meterId:meter.id})),lines:[
   '原计量 '+meter.id+'；原期 '+meter.periodId+'；原客户 '+meter.customerId+'；日期 '+meter.date,
   '原报告 '+meter.reportedUnits+'单位；'+(known?'原独立复核实计 '+meter.auditedUnits+'单位；原审计 '+audit!.id:'实计尚未独立复核，不能当作零用量'),
   '冻结收费 '+moneyText(meter.unitPriceFen)+'/千模拟token；原条款 '+meter.termsId+'；原供应 '+supplierName(meter.supplierId)+'；供应身份 '+shown(meter.supplierId),
   '冻结供价 '+moneyText(meter.unitCostFen)+'/千模拟token；供价版本 '+shown(meter.rateId)+'；供应付款方式 '+(meter.supplierBilling?plainState[meter.supplierBilling]:'尚未形成供应服务')+'；原供应到期日 '+shown(meter.supplierDueAt),
   '原原因 '+(meter.reason===null?'原记录无停止或不足原因':reasonText(meter.reason)+'（'+meter.reason+'）')+'；原交付引用 '+refs(meter.deliveryIds),
   '原供应成本操作 '+shown(meter.costOperationId)+'；追加更正 '+shown(meter.correctionId)+'；原量和原价不覆盖',
  ]})
 }
 const relevantAudits=relay.auditJobs.filter(audit=>audit.businessId===business.id&&(selectedAudit?audit.jobId===selectedAudit.jobId:relay.audits.some(row=>row.jobId===audit.jobId&&meterIds.has(row.meterId))))
 for(const batch of relevantAudits){
  const all=relay.audits.filter(audit=>audit.jobId===batch.jobId&&audit.businessId===business.id),job=batch.job
  if(all.length!==batch.meterCount||new Set(batch.periodIds).size!==batch.periodIds.length||all.some(a=>{const meter=relay.meters.find(m=>m.id===a.meterId);return !meter||!batch.periodIds.includes(meter.periodId)}))throw Error('这份原复核批次的完整范围不一致，请核对来源。')
  for(const periodId of batch.periodIds)withTarget(periodTarget(periodId,{jobId:batch.jobId}))
  const completed=job?.status==='completed'&&batch.completed
  const candidatePeriod=target.kind==='period'&&batch.periodIds.includes(target.periodId)?target.periodId:batch.periodIds.length===1?batch.periodIds[0]:undefined
  add({key:'audit:'+batch.jobId,recordId:batch.jobId,kind:'audit',jobId:batch.jobId,periodIds:[...batch.periodIds],...(candidatePeriod?{periodId:candidatePeriod}:{}),title:'第'+(ownAuditJobs.findIndex(audit=>audit.jobId===batch.jobId)+1)+'次原复核 · '+shown(job?.startAt)+'—'+shown(job?.completeAt),date:job?.startAt??null,state:job?jobStates[job.status]:'原复核任务未知',attention:waiting(job)?'pending':'record',ownership:'object',...(candidatePeriod?withTarget(periodTarget(candidatePeriod,{jobId:batch.jobId})):withTarget(businessTarget)),lines:[
