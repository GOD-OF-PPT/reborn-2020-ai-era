 }
 const sourceIds=new Set<string>()
 for(const period of periods){
  if(!childMeter&&(!childJob||resolved.job?.id===period.supportJobId))sourceIds.add(period.id)
  for(const [kind,job] of [['service',period.job],['support',period.supportJob]] as const){
   if(childMeter||childJob&&job?.id!==target.jobId)continue
   if(job){sourceIds.add(job.id);sourceIds.add(job.actionId)}
   const support=kind==='support',state=job?jobStates[job.status]:'原任务记录未知，不能认作已完成'
   add({key:kind+':'+period.id,recordId:period.id,kind,periodId:period.id,...(job?{jobId:job.id}:{}),title:(support?'原支持':'原服务')+' · '+period.from+'—'+period.to,date:job?.startAt??period.from,state,
    attention:waiting(job)?'pending':'record',ownership:'object',...(job?withTarget(periodTarget(period.id,{jobId:job.id})):withTarget(periodTarget(period.id))),lines:[
     '原账期 '+period.id+'；账期状态 '+(plainState[period.status]??'沿原状态继续')+'；创建 '+period.createdAt+'；原范围 '+period.from+'—'+period.to,
