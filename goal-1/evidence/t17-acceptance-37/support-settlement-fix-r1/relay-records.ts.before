   '客户收入调整 '+moneyText(correction.customerDeltaFen)+'；供应成本调整 '+moneyText(correction.supplierDeltaFen)+'；调整不是本次实收',
   '本次原账操作 '+refs(correction.operationIds),
   '新增应收/应付按新单自己的日期与到期日；负向供应调整可能冲应付或恢复资产，当前公开引用不能逐笔区分的部分不推断。',
  ]})
 }
 const invoices=relay.receivables.filter(invoice=>customerIds.has(invoice.customerId)&&(target.kind==='business'||target.kind==='customer'||target.kind==='audience'||sourceIds.has(invoice.sourceId)))
 for(const invoice of invoices){
  const originalMeter=relay.meters.find(m=>m.id===invoice.sourceId),originalPeriod=relay.periods.find(period=>period.id===invoice.sourceId),linked=relay.corrections.filter(c=>c.operationIds.includes(invoice.operationId))
  if(linked.length>1||linked.some(c=>c.meterId!==invoice.sourceId)||originalMeter&&originalMeter.customerId!==invoice.customerId||originalPeriod&&!originalPeriod.customerIds.includes(invoice.customerId)||!originalMeter&&!originalPeriod)throw Error('这张客户原款与原期、计量或追加更正的来源不一致。')
  const periodId=originalMeter?.periodId??originalPeriod!.id
  if(relay.periods.find(period=>period.id===periodId)?.businessId!==business.id)throw Error('这张客户原款不属于本站原期。')
  const remaining=invoice.amountFen-invoice.collectedFen-invoice.reversedFen,due=remaining>0&&invoice.dueAt<=p.view.date
  if(remaining<0)throw Error('这张原单的已收与冲回超过原金额，请核对原账。')
  const cash=history?.transactions.filter(t=>t.accountId===business.accountId&&t.sourceId===invoice.id)??finance?.transactions.filter(transaction=>transaction.sourceId===invoice.id)??[]
  const invoiceTarget=originalMeter?periodTarget(periodId,{meterId:originalMeter.id}):periodTarget(periodId)
  add({key:'receivable:'+invoice.id,recordId:invoice.id,kind:'receivable',receivableId:invoice.id,periodId,...(originalMeter?{meterId:originalMeter.id}:{}),...(linked[0]?{correctionId:linked[0].id,auditId:linked[0].auditId}:{}),title:customerName(invoice.customerId)+' · 原单'+(ownInvoices.findIndex(original=>original.id===invoice.id)+1)+' · '+invoice.date+'开单 / '+invoice.dueAt+'到期 · 净未收'+moneyText(remaining),date:invoice.date,state:remaining===0?'原单净未收为0':due?invoice.collectedFen>0?'原单部分实收，余款仍由你决定':'原单已经到期，收款仍由你决定':'原单尚未到期，不能提前使用',attention:due?'due':remaining>0?'pending':'record',ownership:'object',customerId:invoice.customerId,...withTarget(invoiceTarget),lines:[
