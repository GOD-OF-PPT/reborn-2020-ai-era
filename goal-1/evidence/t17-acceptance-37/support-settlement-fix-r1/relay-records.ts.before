   ...movements.flatMap(o=>[(movementLabels[o.kind]??'供应相关原账操作')+' '+o.id+' · '+o.date+' · '+(o.amountFen===null?'沿原记录':moneyText(o.amountFen))+'；原来源 '+o.sourceEventId+'；原引用 '+shown(o.referenceId)+'；原义务 '+shown(o.obligationId)+'；原到期 '+shown(o.dueAt),...paymentCash.filter(t=>t.id===o.id).map(t=>'这笔原应付的实际现金 '+t.id+' · '+t.date+' · '+moneyText(t.amountFen)+'；原账户 '+t.accountId+'；原义务引用 '+shown(t.referenceId))]),...historyNote,
  ]})
 }
 const obligations=history?.obligationHistory.filter(o=>o.accountId===business.accountId&&o.scopeBusinessId===business.id)??finance?.obligations.filter(obligation=>obligation.accountId===business.accountId&&(obligation.businessId===business.id||business.company&&obligation.businessId===null))??[]
