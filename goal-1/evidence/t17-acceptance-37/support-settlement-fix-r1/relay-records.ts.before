   add({key:'refund:'+refund.id,recordId:refund.id,kind:'refund',refundId:refund.id,title:(ownership==='station'?'本站客户退款 · ':'客户退款 · ')+customerName(refund.customerId),date:refund.date,state:history?(unpaid>0?'原退款仍有尚欠款项':'原退款已经按原引用付清'):'原退款已记录，实际支付与保护按原账核对',attention:unpaid>0?'due':'record',ownership,customerId:refund.customerId,...withTarget({...base,kind:'customer',customerId:refund.customerId}),lines:[
    '原退款 '+refund.id+'；原客户 '+refund.customerId+'；记录日期 '+refund.date+'；原退款金额 '+moneyText(refund.amountFen),
    '原充值批次引用 '+refs(refund.rechargeIds)+'；原操作引用 '+refs(refund.operationIds),
    ...(ownership==='station'?['这是本站同客户的退款记录；公开退款未绑定本期或该计量，不归作本期新增退款。']:[]),
    ...(history?['按原引用实际退款现金 '+moneyText(paid)+'；原退款尚欠 '+moneyText(unpaid),...cash.map(t=>'实际退款付款 '+t.id+' · '+t.date+' · '+moneyText(-t.amountFen)+'；原义务引用 '+shown(t.referenceId)),...obligations.map(o=>'原退款义务 '+o.id+'；原操作 '+o.originOperationId+'；原额 '+moneyText(o.amountFen)+'；当前尚欠 '+moneyText(o.remainingFen)+'；原保护 '+shown(o.protectionReservationId)),...history.recharges.filter(r=>refund.rechargeIds.includes(r.id)&&r.customerId===refund.customerId).map(r=>'原充值批次 '+r.id+'；原额 '+moneyText(r.amountFen)+'；累计已消费 '+moneyText(r.usedFen)+'；累计退款 '+moneyText(r.refundedFen)+'；本批当前未用 '+moneyText(r.amountFen-r.usedFen-r.refundedFen))]:historyNote),
