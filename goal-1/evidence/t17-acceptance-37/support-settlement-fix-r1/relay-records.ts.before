   '本张已到期原单可显选收款金额；另一个“收取该客户全部到期原款”会包含其他账期。两者都不再次确认收入。',
   ...cash.map(transaction=>'相关公开现金变动 '+transaction.id+' · '+transaction.date+' · '+moneyText(transaction.amountFen)+'；原来源 '+transaction.sourceId+'；原主体 '+shown(transaction.businessId)+'；原合同 '+shown(transaction.contractId)),
   ...(cash.length?['现金变动按原引用列示，不因金额正负推断收入或更正性质。']:['本页尚未列到这张原单的现金变动；没有把未列明当成已到账。']),...historyNote,
