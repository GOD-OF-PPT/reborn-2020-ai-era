import {useEffect,useId,useRef,useState} from 'react'
import {BusinessLedger,WorkflowOverview} from './BusinessLedger.tsx'
import {relayPeriodGroups} from './work-visibility.ts'
import type {GamePanelProps} from './game-types.ts'
import {CommandButton} from './CommandButton.tsx'
import {moneyText,lifecycleText,reasonText} from './game-text.ts'
import {resolveRelaySceneTarget,type RelaySceneTarget} from './relay-scene-target.ts'
import {RelayAuditEditor,RelayServiceChoice,relayChoiceContext,relayDraftScopeForTarget} from './RelayServiceChoice.tsx'
import {RelayTargetPicker} from './RelaySceneChoice.tsx'
import {revealBookTarget} from './ScreenBook.tsx'
import {RelayPreparationEditor} from './RelayPreparationEditor.tsx'
import {isRelayPreparationSlot,relayPreparationAnchor,relayPreparationScopeForTarget,type RelayChoiceDraftSlot} from './relay-preparation-draft.ts'
import {RelayResponseEditor} from './RelayResponseEditor.tsx'
import {RelayRecordBook} from './RelayRecordBook.tsx'
import {relayCasebookKey} from './relay-record-memory.ts'
type Props=GamePanelProps
const locked=(p:Props)=>p.view.busy||p.view.readOnly||p.view.hasCandidate||p.view.saveStatus==='conflict'||p.controller.snapshot.busy
const jobStatus:Record<string,string>={planned:'已预留，未开工',running:'进行中',completed:'已实际完成',cancelled:'未开工安排已取消',interrupted:'已中断，已耗成本保留'}
const periodJobAnchor=(periodId:string,jobId:string)=>'relay-period-job:'+periodId+':'+jobId
const meterAnchor=(meterId:string)=>'relay-meter:'+meterId
const customerDueAnchor=(customerId:string)=>'relay-customer-due:'+customerId
function RelayJob({job,props,anchor}:{job:NonNullable<Props['view']['operations']>['jobs'][number]|null;props:Props;anchor?:string|undefined}){return job?<div className="stack" id={anchor}><p>{jobStatus[job.status]} · {job.startAt}—{job.completeAt}</p>{['planned','running'].includes(job.status)?<div className="button-row"><button type="button" disabled={locked(props)||props.features.workbench.pause!==null} onClick={()=>props.request('AdvanceTime',{date:job.completeAt},'推进到本项中转任务实际完成')}>推进到本项中转任务完成</button><CommandButton {...props} kind="InterruptJob" payload={{jobId:job.id}} label="停止此任务，保留已有费用和义务" confirm/></div>:null}</div>:null}
export type RelayPanelProps=GamePanelProps&{initialTarget?:RelaySceneTarget|null;initialDraftSlot?:RelayChoiceDraftSlot;initialFocusId?:string;onTargetChange?:((target:RelaySceneTarget|null)=>void)|undefined}
export function relayPanelTargetLocation(p:Props,target:RelaySceneTarget|null):{reason:string|null;anchor:string|null}{
 const r=resolveRelaySceneTarget(p.features.relay,target,relayChoiceContext(p))
 if(r.status!=='valid'||!target)return {reason:r.reason,anchor:null}
 return {reason:null,anchor:target.kind==='period'?target.jobId?periodJobAnchor(target.periodId,target.jobId):target.meterId?meterAnchor(target.meterId):target.periodId+'-period':target.kind==='application'?target.applicationId:target.kind==='audience'?target.audienceId:target.kind==='customer'?r.customer&&r.customer.dueReceivableFen>0?customerDueAnchor(target.customerId):target.customerId:target.businessId}
}
export default function RelayPanel(props:RelayPanelProps){return <RelayPanelScope key={props.view.runId+'|'+props.accountId+'|'+JSON.stringify(props.initialTarget)+'|'+props.initialDraftSlot+'|'+props.initialFocusId} {...props}/>}
function RelayPanelScope(props:RelayPanelProps){
 const v=props.features.relay,[selection,setSelection]=useState<{selected:boolean;target:RelaySceneTarget|null;slot?:RelayChoiceDraftSlot|undefined}>({selected:false,target:null}),panel=useRef<HTMLDivElement>(null),link=useRef<HTMLAnchorElement>(null),located=useRef<string|null>(null),ticket=useRef<HTMLDetailsElement>(null),ticketId=useId(),[readTicket,setReadTicket]=useState(()=>relayCasebookKey(props.initialFocusId)!==undefined)
 const p=selection.selected?{...props,accountId:selection.target?.accountId??'personal'}:props
 // Undefined alone preserves the old recommendation, restricted to the current public account.
 const legacy=p.initialTarget===undefined&&!selection.selected,legacyBusiness=v?.businesses.find(b=>b.accountId===p.accountId&&b.lifecycle!=='closed')??v?.businesses.find(b=>b.accountId===p.accountId),legacyStation=legacyBusiness?v?.stations.find(s=>s.businessId===legacyBusiness.id):undefined
 const recommended:RelaySceneTarget|null=legacyBusiness&&legacyStation?{kind:'business',runId:p.view.runId,accountId:legacyBusiness.accountId,businessId:legacyBusiness.id,stationId:legacyStation.id}:null
 const target=selection.selected?selection.target:legacy?recommended:props.initialTarget??null,context=relayChoiceContext(p),resolved=resolveRelaySceneTarget(v,target,context)
 const accountReason=!p.view.accounts.some(a=>a.accountId===p.accountId)?'原中转账户已经不可核，请明确重新选择；没有改用个人账户。':target===null&&p.accountId!=='personal'?'新站准备须明确回到个人自有资金入口，没有把另一账户当作个人。':null
 const slot=selection.selected?selection.slot:props.initialDraftSlot,slotReason=slot?(isRelayPreparationSlot(slot)?relayPreparationScopeForTarget(p,target,slot):relayDraftScopeForTarget(p,target,slot)).reason:null,reason=accountReason??resolved.reason??slotReason,b=resolved.business,key=JSON.stringify(target)+'|'+slot,location=isRelayPreparationSlot(slot)?{reason:slotReason,anchor:relayPreparationAnchor(target,slot)}:relayPanelTargetLocation(p,target),recordKey=selection.selected?undefined:relayCasebookKey(props.initialFocusId)
 useEffect(()=>{if(reason||recordKey||!location.anchor||!panel.current||!link.current||located.current===key)return;const node=document.getElementById(location.anchor);if(!node||!panel.current.contains(node))return;for(let parent=node.parentElement;parent&&parent!==panel.current;parent=parent.parentElement)if(parent instanceof HTMLDetailsElement)parent.open=true;located.current=key;revealBookTarget(link.current,location.anchor)},[key,reason,location.anchor,recordKey])
 useEffect(()=>{if(!recordKey||reason||!ticket.current)return;setReadTicket(true);ticket.current.open=true;revealBookTarget(ticket.current,ticketId)},[recordKey,reason,ticketId])
 const choose=(next:RelaySceneTarget|null,nextSlot?:RelayChoiceDraftSlot)=>{if(p.view.busy||p.controller.snapshot.busy||p.view.hasCandidate||p.view.saveStatus==='conflict')return;setSelection({selected:true,target:next,slot:nextSlot});props.onTargetChange?.(next)}
 const header=<header className="route-introduction"><p className="eyebrow">客户、用量与供应 · 本局虚构模拟</p><h2>API中转站</h2><p>选择供应、客群与收费，实际服务后再结算。客户充值、供应预付、应收应付与利润分开；不连接真实API、密钥或支付。</p></header>
 if(!v)return <p>当前存档没有中转经营。</p>
 if(reason)return <div className="stack-lg route-workspace relay-workspace">{header}<section className="warning-box" role="status"><h3>原对象没有换成另一站</h3><p>{reason}</p><p>也可用原册账户选择器回到原账户。这里只列可核的原企业与账期，重新翻开不执行命令。</p></section><RelayTargetPicker p={p} current={target} onConfirm={choose}/></div>
 return <div ref={panel} className="stack-lg route-workspace relay-workspace">{header}{location.anchor?<a ref={link} href={'#'+location.anchor}>定位这份原记录 ↗</a>:null}{target?<details ref={ticket} id={ticketId} className="panel relay-original-ticket" open={readTicket} onToggle={event=>setReadTicket(event.currentTarget.open)}><summary>只翻这一对象的原票，再明确回应</summary>{readTicket?<RelayRecordBook p={p} target={target} initialRecordKey={recordKey} onFullRecord={(next,_record,preparation)=>choose(next,preparation)}/>:null}</details>:null}<details className="panel"><summary>明确翻选另一份原企业或账期</summary><RelayTargetPicker p={p} current={target} onConfirm={choose}/></details>{b?<RelayBusiness key={b.id} {...p} businessId={b.id} target={target!} initialDraftSlot={slot} onSelectTarget={choose}/>:<RelayPreparationEditor p={p} target={null} slot="open"/>}<RelayArchive {...p}/></div>
}
function RelayArchive(props:Props){const v=props.features.relay!,closed=v.businesses.filter(b=>b.lifecycle==='closed');return closed.length?<details className="panel business-archive"><summary>已收尾中转企业历史（{closed.length}）</summary>{closed.map(b=><article key={b.id}><h3>中转分账 · {b.id.slice(-6)}</h3><p>累计确认收入{moneyText(b.metrics.incomeFen)}，累计成本{moneyText(b.metrics.costFen)}；历史结果不会再次作为现金发放。</p>{v.periods.filter(p=>p.businessId===b.id).map(p=><p key={p.id}>{p.from}—{p.to} · {p.reportedUnits}报告用量 · {p.status==='closed'?'本期已结':'旧记录保留'}。</p>)}</article>)}</details>:null}

function RelayBusiness(props:Props&{businessId:string;target:RelaySceneTarget;initialDraftSlot?:RelayChoiceDraftSlot|undefined;onSelectTarget:(target:RelaySceneTarget)=>void}){
 const v=props.features.relay!,b=v.businesses.find(b=>b.id===props.businessId)!,station=v.stations.find(s=>s.businessId===b.id)!,customers=v.customers.filter(c=>c.businessId===b.id&&c.closedAt===null),visibleCustomers=v.customers.filter(c=>c.businessId===b.id&&(c.closedAt===null||props.target.kind==='customer'&&props.target.customerId===c.id))
 const periodGroups=relayPeriodGroups(v.periods.filter(p=>p.businessId===b.id),v.meters),selectedPeriod=props.target.kind==='period'?props.target.periodId:null
 const selectedArchive=periodGroups.archive.find(p=>p.id===selectedPeriod),currentPeriods=selectedArchive?[selectedArchive,...periodGroups.current]:periodGroups.current,archivedPeriods=periodGroups.archive.filter(p=>p.id!==selectedPeriod)
 const businessTarget:RelaySceneTarget={kind:'business',runId:props.target.runId,accountId:props.target.accountId,businessId:b.id,stationId:station.id}
 return <><WorkflowOverview label="中转经营进展" items={[{label:'供应与准备',value:v.supplyOptions.filter(o=>o.businessId===b.id&&o.permitted&&o.adapted).length+'项当前可核对供应',target:b.id+'-resources'},{label:'客户与余额',value:customers.length+'份未关闭客户合同',target:b.id+'-customers'},{label:'服务与账单',value:periodGroups.current.length+'个当前服务/待处理周期',target:b.id+'-periods'}]}/>
<div id={b.id}><BusinessLedger title={b.company?'中转企业账户':'中转个人经营分账'} status={lifecycleText[b.lifecycle]??b.lifecycle} funds={b.funds} open={b.lifecycle==='preparing'}><div className="section-heading"><h3>{b.company?'中转企业账户':'中转个人经营分账'}</h3><span className="tag">{lifecycleText[b.lifecycle]}</span></div><dl className="finance-grid">{[['本主体可花',b.funds.availableFen],['现金',b.funds.cashFen],['客户保护及其他预留',b.funds.heldFen],['尚未消费充值',b.funds.prepaidLiabilityFen],['客户应收',b.funds.receivableFen],['供应预付/调账贷项资产',b.funds.supplierPrepaidFen],['尚欠费用/供应款',b.funds.payableFen],['本业务已确认收入',b.metrics.incomeFen],['本业务成本（含应计）',b.metrics.costFen],['本业务账面利润',b.metrics.profitFen]].map(([label,amount])=><div key={String(label)}><dt>{label}</dt><dd>{moneyText(Number(amount))}</dd></div>)}</dl><p>客户余额不是利润，供应预付尚未消耗时也不是成本。收入与现金到账按实际日期分列。</p>{b.funds.protectionShortfallFen>0||b.funds.commitmentShortfallFen>0?<p className="error-box" role="alert">存在真实资金保护/承诺缺口，请翻开日历处理原账，不会用负现金假装付清。</p>:null}{b.company?<RelayPreparationEditor p={props} target={props.target} slot="capital"/>:null}<div className="button-row">{b.lifecycle==='preparing'?<CommandButton {...props} kind="ActivateBusiness" payload={{businessId:b.id}} label="核对材料、供应与产能后启用中转站"/>:b.lifecycle==='operating'?<CommandButton {...props} kind="PauseBusiness" payload={{businessId:b.id}} label="暂停接受新客户合同"/>:b.lifecycle==='paused'?<CommandButton {...props} kind="ResumeBusiness" payload={{businessId:b.id}} label="重验条件后恢复新合同"/>:null}{station.trafficPaused?<CommandButton {...props} kind="ResumeRelayTraffic" payload={{businessId:b.id}} label="恢复已批准范围内请求"/>:<CommandButton {...props} kind="PauseRelayTraffic" payload={{businessId:b.id}} label="停止新请求，余额和旧责任保留"/>}{b.lifecycle!=='winding_down'?<CommandButton {...props} kind="StopRelayStation" payload={{businessId:b.id}} label="停站收尾，不清除客户余额与供应账单" confirm/>:<CommandButton {...props} kind="CloseBusiness" payload={{businessId:b.id}} label="全部旧义务与资产结清后关闭企业" confirm/>}</div></BusinessLedger></div>
 {v.changes.some(c=>c.businessId===b.id&&c.acknowledgedAt===null)?<section className="warning-box"><h3>供应与竞争前提发生变化</h3>{v.changes.filter(c=>c.businessId===b.id&&c.acknowledgedAt===null).map(c=><p key={c.id}>{c.date} · 世界节点{c.anchorId}已发生。旧账单保持原价，未来报价和例行授权需重验。</p>)}<CommandButton {...props} kind="AcknowledgeRelayMarket" payload={{businessId:b.id}} label="确认保留现有合同，另行调整未来方案"/></section>:null}
 <details className="panel" id={b.id+'-resources'} open={b.lifecycle==='preparing'||props.initialDraftSlot==='basics'||props.initialDraftSlot==='materials'}><summary>技术、申请材料与明确投入</summary>{!v.technicallyReady||props.initialDraftSlot==='basics'?<RelayPreparationEditor p={props} target={props.target} slot="basics"/>:null}{!v.preparations.some(preparation=>preparation.businessId===b.id&&preparation.kind==='materials'&&preparation.job?.status==='completed')||props.initialDraftSlot==='materials'?<RelayPreparationEditor p={props} target={props.target} slot="materials"/>:null}{v.preparations.filter(preparation=>preparation.businessId===b.id).map(preparation=><article key={preparation.id}><h4>{preparation.kind==='basics'?'技术学习':'申请材料'}</h4><RelayJob props={props} job={preparation.job}/></article>)}<details><summary>需要员工：招聘与实际工资</summary><p>招聘占1点/500元，周助理月薪2500元，按实际在岗日计薪。员工不会提供免费注意力。</p><CommandButton {...props} kind="HireWorker" payload={{businessId:b.id,definitionId:'assistant-zhou'}} label="招聘周助理支持服务"/>{props.view.operations?.workers.filter(w=>w.to===null).map(w=><CommandButton key={w.id} {...props} kind="DismissWorker" payload={{workerId:w.id}} label={`结算并解聘${w.definitionId}`} confirm/>)}</details></details>
<section className="stack" id={b.id+'-periods'}><h3>当前服务与旧账处理</h3>{periodGroups.pendingByPeriod.size>0?<aside className="warning-box"><strong>独立复核已经揭示未更正差额</strong><p>即使原周期曾经结清，以下{periodGroups.pendingByPeriod.size}个周期仍有已知计量差额需要按原记录处理，不能藏进历史。</p></aside>:null}{currentPeriods.map(p=><RelayPeriodCard key={p.id} {...props} periodId={p.id} target={props.target} onSelectTarget={props.onSelectTarget}/>)}{archivedPeriods.length>0?<details className="panel"><summary>已结服务周期记录（{archivedPeriods.length}）</summary>{archivedPeriods.map(p=><RelayPeriodCard key={p.id} {...props} periodId={p.id} target={props.target} onSelectTarget={props.onSelectTarget}/>)}</details>:null}</section>
 <details className="panel" id={b.id+'-customers'} open={customers.some(c=>c.dueReceivableFen>0)||station.trafficPaused}><summary>客户余额、信用与未来报价（{customers.length}）</summary><RelayPreparationEditor p={props} target={props.target} slot="customer-funds"/>{visibleCustomers.map(c=><RelayCustomer key={c.id} {...props} customerId={c.id} number={v.customers.filter(original=>original.businessId===b.id).findIndex(original=>original.id===c.id)+1}/>)}{customers.length>0?<RequoteForm {...props} businessId={b.id}/>:null}</details>
 {props.target.kind==='business'?<section className="panel"><h3>安排另一份实际服务，与已经承诺的支持</h3><RelayServiceChoice p={props} target={businessTarget}>{view=><>{view.actions}{view.body}</>}</RelayServiceChoice></section>:<button type="button" onClick={()=>props.onSelectTarget(businessTarget)}>明确回到本站，另拟新的服务</button>}
 <RelayIntake {...props}/>
 <details className="panel" open={b.lifecycle==='preparing'||props.initialDraftSlot==='application'||props.initialDraftSlot==='adapter'||props.initialDraftSlot==='supplier-funds'}><summary>供应许可、故障域与供应资产</summary><p>名称和授权均为虚构。杉木与青桥共享cloud-east故障域，两家不等于独立备份；港湾有不同故障域与成本。只在明确选定、已批准且已适配的链内自动故障转移。</p><RelayPreparationEditor p={props} target={props.target} slot="application"/><RelayPreparationEditor p={props} target={props.target} slot="adapter"/><RelayPreparationEditor p={props} target={props.target} slot="supplier-funds"/>{v.catalog.suppliers.map(s=>{const option=v.supplyOptions.find(o=>o.businessId===b.id&&o.supplierId===s.id),applications=v.applications.filter(a=>a.businessId===b.id&&a.supplierId===s.id);return <section className="panel stack" key={s.id}><h4>{s.label}</h4><p>故障域{s.failureDomain} · {s.billing==='prepaid'?'供应预付后消耗':'实际用量后七天账期'} · 当前已知供价{s.currentRate?moneyText(s.currentRate.unitCostFen)+' / 千模拟token':'尚无本局已发布价'}；批准信用上限{moneyText(s.creditLimitFen)}</p><p>{option?.permitted?'当前许可有效':'尚无有效供应许可'} · {option?.adapted?'已有实际适配':'尚缺适配'} · 供应贷项/预付资产{moneyText(option?.credit?.remainingFen??0)} · 该供应未付{moneyText(option?.outstandingFen??0)}</p>{applications.map(a=><article key={a.id} id={a.id}><RelayJob props={props} job={a.job}/>{a.approved===null?<CommandButton {...props} kind="ReadRelaySupplyDecision" payload={{applicationId:a.id}} label="查看已完成的供应审查结果"/>:<p className={a.approved?'receipt-card':'warning-box'}>{a.approved?'已批准本局服务聚合范围，有效至'+a.expiresAt:'未获批准；费用已发生，稍后可重新申请'}。不代表现实第三方授权。</p>}</article>)}{v.adapters.filter(a=>a.businessId===b.id&&a.supplierId===s.id).map(a=><RelayJob key={a.id} props={props} job={a.job}/>)}<SupplierFunds {...props} businessId={b.id} supplierId={s.id}/></section>})}</details>

 </>
}
function SupplierFunds(props:Props&{businessId:string;supplierId:string}){const credit=props.features.relay!.supplyOptions.find(option=>option.businessId===props.businessId&&option.supplierId===props.supplierId)?.credit?.remainingFen??0;return credit>0?<CommandButton {...props} kind="RefundRelaySupplier" payload={{businessId:props.businessId,supplierId:props.supplierId,amountFen:credit}} label="取回此供应未用余额/调账贷项，不记收入" confirm/>:null}
function RelayIntake(props:Props&{target:RelaySceneTarget;initialDraftSlot?:RelayChoiceDraftSlot|undefined}){
 const audiences=props.features.relay!.audiences.filter(audience=>audience.businessId===props.target.businessId)
 return <details className="panel" open={props.initialDraftSlot==='marketing'||props.initialDraftSlot==='offer'||props.initialDraftSlot==='customers'}><summary>客群、报价与信用条件</summary><p>营销产生实际潜客，不保证销量；签约和充值本身不产生收入。客户身份、报价、收款条件与期限逐项明确。</p><RelayPreparationEditor p={props} target={props.target} slot="marketing"/>{audiences.map(audience=><article key={audience.id} id={audience.id} className="panel"><h4>{audience.mode==='paid'?'付费获客':'既有视频受众'} · {audience.segment==='local_merchants'?'企业客户':audience.segment==='ai_learners'?'AI学习者':'生活方式受众'}</h4><p>本批来源{audience.createdAt} · 原身份{audience.id.slice(-6)}。</p><RelayJob props={props} job={audience.job}/>{audience.completedAt!==null?<p>{audience.completedAt}实际留下{audience.members.length}位潜客；名单不是已签合同，签约与独立充值仍各自决定。已签身份不重复领取营销收入。</p>:<p>这批获客尚未实际完成，没有提前生成潜客或客户合同。</p>}</article>)}<RelayPreparationEditor p={props} target={props.target} slot="offer"/><RelayPreparationEditor p={props} target={props.target} slot="customers"/></details>
}
function RelayCustomer(props:Props&{customerId:string;number:number}){
 const v=props.features.relay!,c=v.customers.find(c=>c.id===props.customerId)!,stations=v.stations.filter(station=>station.businessId===c.businessId)
 const target:RelaySceneTarget|null=stations.length===1?{kind:'customer',runId:props.view.runId,accountId:props.accountId,businessId:c.businessId,stationId:stations[0]!.id,customerId:c.id}:null
 return <article className="panel stack" id={c.id}><h4>客户{props.number} · 身份{c.personId.slice(-6)}</h4><p>{c.mode==='prepaid'?'充值制':'后付信用制'} · 合同至{c.termEnd} · 当前已生效用量价{moneyText(c.activeTerms.unitPriceFen)}/千模拟token · 支持完成后的周期基准费（按实际服务天数分摊）{moneyText(c.activeTerms.serviceFeeFen)}</p><dl className="finance-grid"><div><dt>未消费余额（受保护）</dt><dd>{moneyText(c.balance.prepaidFen)}</dd></div><div><dt>未回款应收</dt><dd>{moneyText(c.balance.receivableFen)}</dd></div><div><dt>其中已到期可收</dt><dd>{moneyText(c.dueReceivableFen)}</dd></div><div><dt>已确认本客户净收入</dt><dd>{moneyText(c.balance.recognizedIncomeFen)}</dd></div></dl><div className="button-row" id={customerDueAnchor(c.id)}><CommandButton {...props} kind="CollectRelayDue" payload={{customerId:c.id}} label={'收取客户'+props.number+'实际已到期应收'}/>{c.balance.prepaidFen>0?<CommandButton {...props} kind="RefundRelayBalance" payload={{customerId:c.id,amountFen:c.balance.prepaidFen}} label={'退还客户'+props.number+'全部未消费余额'} confirm/>:null}<CommandButton {...props} kind="CloseRelayCustomer" payload={{customerId:c.id}} label={'结清旧责任后关闭客户'+props.number+'合同'} confirm/></div><details><summary>明确续签本客户，不自动续约</summary>{target?<RelayResponseEditor p={props} target={target} subject={{kind:'customer',id:c.id}} mode="renew"/>:<p className="warning-box">原站点身份不唯一，请先核对原对象；没有换到另一位客户。</p>}</details></article>
}
function RequoteForm(props:Props&{businessId:string}){
 const v=props.features.relay!,stations=v.stations.filter(station=>station.businessId===props.businessId)
 const target:RelaySceneTarget|null=stations.length===1?{kind:'business',runId:props.view.runId,accountId:props.accountId,businessId:props.businessId,stationId:stations[0]!.id}:null
 return <details><summary>与已有客户重谈未来报价</summary>{target?<RelayResponseEditor p={props} target={target} subject={{kind:'business',id:props.businessId}} mode="requote"/>:<p className="warning-box">原站点身份不唯一，请先核对同一份原账。</p>}{v.quotes.filter(q=>q.businessId===props.businessId).map(q=><article key={q.id} id={q.id}><h4>{q.effectiveAt}拟生效 · {moneyText(q.unitPriceFen)}/千模拟token</h4><RelayJob props={props} job={q.job}/>{q.completedAt?<p>实际接受{q.responses.filter(r=>r.accepted).length}/{q.responses.length}名；拒绝者保持旧合同，不静默涨价。</p>:<p>谈判结果尚未知。</p>}</article>)}</details>
}
function RelayPeriodCard(props:Props&{periodId:string;target:RelaySceneTarget;onSelectTarget:(target:RelaySceneTarget)=>void}){
 const [meterRows,setMeterRows]=useState(50)
 const v=props.features.relay!,p=v.periods.find(p=>p.id===props.periodId)!,state:Record<string,string>={planned:'已安排，尚未开始',running:'实际服务中',support:'用量周期结束，支持/账单继续',settling:'仍有应收应付',closed:'本期已结，客户余额另列',stopped:'已停止本期新请求，旧责任继续'},meters=v.meters.filter(m=>m.periodId===p.id),auditJobs=v.auditJobs.filter(a=>a.periodIds.includes(p.id))
 const target:RelaySceneTarget={kind:'period',runId:props.target.runId,accountId:props.target.accountId,businessId:p.businessId,stationId:props.target.stationId,periodId:p.id}
 const selected=props.target.kind==='period'&&props.target.periodId===p.id?props.target:null,originalJob=selected?.jobId!==undefined,auditTarget=selected?.meterId?selected:target,targetIndex=selected?.meterId?meters.findIndex(m=>m.id===selected.meterId):-1,visibleRows=Math.max(meterRows,targetIndex+1)
 return <section className="panel stack" id={p.id+'-period'}><div className="section-heading"><h3>{p.from}—{p.to}服务周期</h3><span className="tag">{state[p.status]}</span></div><p>已选择{p.customerIds.length}位客户，已授权供应{p.supplierIds.map(id=>v.catalog.suppliers.find(s=>s.id===id)?.label??id).join(' → ')}。上限{p.maxUnits}单位，供应成本授权上限{moneyText(p.maxSupplierCostFen)}；请求并非销量保证。</p><p>实际观测{p.observedDays}/28天，报告用量{p.reportedUnits}，有停止/不足原因的日期{p.failedDays}天；原记录保留。客户余额与企业欠款不会因为本期结束而消失。</p><h4>服务与基础设施</h4><RelayJob props={props} job={p.job} anchor={periodJobAnchor(p.id,p.jobId)}/><h4>已承诺的客户支持</h4><RelayJob props={props} job={p.supportJob} anchor={periodJobAnchor(p.id,p.supportJobId)}/><CommandButton {...props} kind="StopRelayPeriod" payload={{periodId:p.id}} label="停止本周期后续请求，保留支持与旧账" confirm/>
 {v.observations.filter(o=>o.periodId===p.id).map(o=><p className="warning-box" key={o.id}>{o.date} · {o.reason}（{o.domain}）</p>)}
 <h4>计量复核与原账更正</h4><p>复核只覆盖已经发生的记录，1点/100元/3天；原用量不覆盖，差额关联原记录。当前复核完成{p.auditedMeters}/{p.meterCount}条，已知不一致{p.knownCorrections}条。</p>{selected&&!originalJob?<section><h4>明确资源与日期，再委托这份已有计量</h4><RelayAuditEditor p={props} target={auditTarget}>{view=><>{view.actions}{view.body}</>}</RelayAuditEditor></section>:<button type="button" onClick={()=>props.onSelectTarget(target)}>明确翻回本期，再决定新的复核</button>}{auditJobs.map(a=><article key={a.jobId}><p>该次原复核覆盖{a.meterCount}条已有记录；完整批次可能包含原其他期，不是再次委托。</p><RelayJob props={props} job={a.job} anchor={periodJobAnchor(p.id,a.jobId)}/></article>)}<CommandButton {...props} kind="CorrectRelayPeriod" payload={{periodId:p.id}} label="按已完成复核逐笔更正本期已有账单" confirm/>
 <details open={selected?.meterId!==undefined}><summary>用量、原始价格版本与更正记录（{meters.length}）</summary><div className="table-scroll"><table><thead><tr><th>日期</th><th>报告用量</th><th>复核实计</th><th>收费/供价版本</th><th>原因与更正</th></tr></thead><tbody>{meters.slice(0,visibleRows).map(m=><tr key={m.id} id={meterAnchor(m.id)}><td>{m.date}</td><td>{m.reportedUnits}</td><td>{m.auditedUnits??'尚未独立复核'}</td><td>{moneyText(m.unitPriceFen)} / {m.rateId??'未服务'}</td><td>{m.reason?reasonText(m.reason):'按当前已选供应服务'} · {m.correctionId?'已追加更正':'原记录'}</td></tr>)}</tbody></table></div>{visibleRows<meters.length?<div className="button-row"><button type="button" onClick={()=>setMeterRows(n=>n+50)}>显示后续50条用量</button><button type="button" onClick={()=>setMeterRows(meters.length)}>显示全部本期用量</button></div>:null}{v.corrections.filter(c=>meters.some(m=>m.id===c.meterId)&&(c.customerDeltaFen!==0||c.supplierDeltaFen!==0)).map(c=><p key={c.id}>{c.date} · 客户收入差额{moneyText(c.customerDeltaFen)} · 供应成本差额{moneyText(c.supplierDeltaFen)} · 原账{c.meterId.slice(-6)}</p>)}</details>
 </section>
}
