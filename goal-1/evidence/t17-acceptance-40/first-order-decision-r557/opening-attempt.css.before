/* A reply on paper: choices read as different intentions, with the original confirmation after them. */
.opening-attempt-choices .opening-offer-decisions{display:grid;grid-template-columns:1fr 1fr;gap:10px 18px;margin:20px 0}
.opening-attempt-choices .opening-offer-decisions>.command:first-child{grid-column:1/-1}
.opening-attempt-choices .command>button,
.opening-attempt-choices .opening-next-choice{position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:7px;width:100%;padding:13px 20px;border:0;border-bottom:1px solid #aa996e77;background:linear-gradient(90deg,#c1a76c15,transparent);color:#eadbb7;text-align:left;font:16px/1.7 var(--opening-serif)}
.opening-attempt-choices .opening-offer-decisions>.command:first-child>button{border-left:2px solid #e1bd75;background:linear-gradient(90deg,#c1a76c28,transparent)}
.opening-attempt-choices .command>button small,
.opening-attempt-choices .opening-next-choice>span{display:block;color:#c0c5b0;font:14px/1.8 var(--opening-serif)}
.opening-attempt-choices .opening-next-choice>strong{font-weight:400}
.opening-attempt-choices .opening-next-choice>i{position:absolute;right:8px;top:13px;color:#c8b079;font-style:normal}
.opening-attempt-choices .command>button:hover:not(:disabled),
.opening-attempt-choices .opening-next-choice:hover:not(:disabled){background:linear-gradient(90deg,#c1a76c30,transparent);border-bottom-color:#ebce91}
.opening-attempt-choices :is(.command>button,.opening-next-choice):focus-visible{outline:2px solid #ffe0a2;outline-offset:4px}
.opening-attempt-choices :is(.command>button,.opening-next-choice):disabled{border-bottom-style:dashed;color:#a8b1a0;cursor:default}
.opening-attempt-choices .opening-choice-footer{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:10px 20px;padding:14px 0 0;border-top:1px solid #af9d694f}
.cinema-app .dialog.opening-market-choices>.dialog-direct-body{display:flex;flex:1;min-height:0;flex-direction:column;justify-content:center;gap:20px}
.cinema-app .opening-market-choices .opening-market-context{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:10px 0 16px;border-bottom:1px solid #baa57455;color:var(--muted);font:14px/1.7 var(--serif)}
.cinema-app .opening-market-choices .opening-market-context p{margin:0;color:#e8dec4;text-align:right}
.cinema-app .opening-market-choices .opening-market-context strong{font:400 25px/1.6 var(--serif);color:#efd6a2;margin-left:8px}
.cinema-app .opening-market-choices .opening-market-context small{display:block;color:var(--muted);font:13px/1.7 var(--serif)}
.cinema-app .opening-market-choices .opening-market-decisions{display:grid;gap:12px}
.cinema-app .opening-market-choices .opening-market-decisions :is(.command>button,.opening-next-choice){border:1px solid #baa57455;border-left:2px solid #bba67566;border-radius:0;background:#0b252a55;padding:13px 20px;gap:4px;color:#efdfbb;font:18px/1.5 var(--serif);transform:none}
.cinema-app .opening-market-choices .opening-market-decisions strong{font:400 20px/1.5 var(--serif)}
.cinema-app .opening-market-choices .opening-market-decisions :is(.command>button small,.opening-next-choice>span){font:14px/1.7 var(--serif);color:#bec7b8;margin-top:4px}
.cinema-app .opening-market-choices .opening-market-decisions :is(.command>button,.opening-next-choice):hover:not(:disabled){border-left-color:#edce8d;background:#41534788;color:#fff0d1}
.cinema-app .opening-market-choices .opening-market-decisions :is(.command>button,.opening-next-choice):focus-visible{outline:2px solid #f2dba0;outline-offset:3px}
.cinema-app .opening-market-choices .opening-market-decisions :is(.command>button,.opening-next-choice):disabled{background:#102a2c66;color:#b7b9a9;border-style:dashed}
.cinema-app .opening-market-choices>.opening-choice-footer{flex:none;margin-top:18px;font:14px/1.7 var(--serif)}
