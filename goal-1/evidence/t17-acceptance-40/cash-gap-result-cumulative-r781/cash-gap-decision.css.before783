.cinema-app .cash-gap-decision{--gap-ink:#eee3c6;--gap-muted:#c2ccb8;--gap-accent:#efd498;break-inside:avoid;border-left:2px solid var(--gap-accent);padding:12px 16px;margin:14px 0;background:#a58d4b17;color:var(--gap-ink)}
.cinema-app .cash-gap-decision[data-state=due]{--gap-accent:#e4b69c;background:#834f3522}
.cinema-app .cash-gap-decision[data-state=unknown]{border-left-style:dashed}
.cinema-app .cash-gap-decision h3{font:21px/1.6 var(--serif);color:var(--gap-ink);margin:0 0 8px}
.cinema-app .cash-gap-decision p{font:16px/1.85 var(--serif);color:var(--gap-muted);margin:0 0 10px}
.cinema-app .cash-gap-actions{display:flex;align-items:center;flex-wrap:wrap;gap:12px 24px}
.cinema-app .cash-gap-actions>a{color:var(--gap-accent);font:15px/1.8 var(--serif);text-decoration:none;border-bottom:1px solid currentColor}
.cinema-app .cash-gap-actions>a:focus-visible{outline:2px solid var(--gap-accent);outline-offset:4px}
