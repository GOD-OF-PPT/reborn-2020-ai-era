.cinema-app .person-moment-record .dialog-direct-body{display:flex;flex-direction:column;justify-content:center;gap:16px}
.cinema-app .person-record-heading{display:flex;align-items:center;gap:16px;border-bottom:1px solid #bfa77455;padding-bottom:12px}
.cinema-app .person-record-heading>.person-portrait{width:48px;min-width:48px;height:60px;overflow:hidden;border:1px solid #bfa77466;background:#18392f}
.cinema-app .person-record-heading>.person-portrait img{width:100%;height:100%;object-fit:cover}
.cinema-app .person-record-heading>.person-portrait .portrait-initial{display:grid;place-items:center;height:100%;position:relative;color:#c2c9ad}
.cinema-app .person-record-heading>.person-portrait svg{position:absolute;inset:0;width:100%;height:100%;stroke:#b2bc9f;stroke-width:1.4}
.cinema-app .person-record-heading p{font:14px/1.6 var(--serif);color:#b9c3a9;margin:0 0 3px}
.cinema-app .person-record-heading strong{font:400 23px/1.5 var(--serif);color:#eedcb2}
.cinema-app .person-record-heading small{font:15px/1.6 var(--serif);color:#c4c9ae;margin-left:10px}
.cinema-app .person-record-status{display:inline-block;margin-left:18px;padding-left:10px;border-left:2px solid #cdb77e;font:15px/1.8 var(--serif);color:#e6d1a1}
.cinema-app .person-record-status[data-missed=true]{border-color:#ce8f76;color:#e7b69e}
.cinema-app .person-record-columns{display:grid;grid-template-columns:1fr 1fr;gap:30px}
.cinema-app .person-record-columns>section{min-width:0}
.cinema-app .person-record-columns h3{font:400 20px/1.6 var(--serif);color:#e6d5ad;margin:0 0 8px}
.cinema-app .person-record-columns p{font:15px/1.8 var(--serif);color:#d4d5bd;margin:7px 0}
.cinema-app .person-record-columns .person-record-promise-title,.cinema-app .person-record-columns .person-record-work-title{color:#c4cbb4;margin:0 0 8px}
.cinema-app .person-record-dates{padding:0;margin:0;border:0}
.cinema-app .person-record-dates>div{display:flex;justify-content:space-between;align-items:baseline;gap:10px;padding:4px 0;border-bottom:1px solid #bdac7444}
.cinema-app .person-record-dates dt{font:15px/1.7 var(--serif);color:#bbc7ad}
.cinema-app .person-record-dates dd{font:18px/1.7 Georgia,var(--serif);color:#e9d4a5;margin:0}
.cinema-app .person-record-columns .person-record-paid{color:#e7d1a0;margin:10px 0 3px}
.cinema-app .person-record-paid strong{font:400 23px/1.5 var(--serif);color:#f0deb4}
.cinema-app .person-record-columns :is(.person-record-terms,.person-record-basis,.person-record-reference){font:14px/1.7 var(--serif);color:#bbc6ac}
.cinema-app .person-record-columns .person-record-boundary{color:#bec6ae;border-top:1px solid #b8aa7544;padding-top:8px}
.cinema-app .person-record-note{font:14px/1.8 var(--serif);color:#bcc7b0;margin:0}
.cinema-app .person-record-actions{display:flex;justify-content:space-between;align-items:center;gap:22px;width:100%}
.cinema-app .person-moment-record .person-record-more{background:none;border:0;border-bottom:1px solid #bda56a66;color:#e8d1a0;font:15px/1.8 var(--serif);padding:5px 0;min-height:0}
.cinema-app .person-record-pages{display:flex;align-items:center;gap:12px;margin:10px 0 0;color:#c9cbb2;font:14px/1.6 var(--serif)}
.cinema-app .person-record-pages button{font:14px/1.6 var(--serif);padding:4px 10px;min-height:30px;background:#1b3b31;color:#dfcc9f;border:1px solid #b5a27266}
.cinema-app .person-moment-record button:hover:not(:disabled){transform:none;background:#294b3c;color:#fff0cc;border-color:#ead098}
.cinema-app .person-moment-record button:disabled{background:#263b31;color:#9eac96;border-color:#7e8d73;border-style:dashed;box-shadow:none;transform:none}
.cinema-app .person-moment-record button:focus-visible{outline:2px solid #f1d69b;outline-offset:4px}
