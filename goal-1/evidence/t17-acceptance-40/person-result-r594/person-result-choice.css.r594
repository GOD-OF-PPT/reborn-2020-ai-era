.cinema-app .narrative-life .life-choice-stage .scene-choices>.person-result-choice{display:flex;flex-direction:column;gap:12px;padding:16px 18px 16px 46px;background:linear-gradient(90deg,#15382ee6,#193c3566)}
.cinema-app .narrative-life .person-result-choice>.person-result-cost{font:15px/1.8 var(--serif);color:#d7decc;margin:0}
.cinema-app .narrative-life .person-result-choice>.person-result-next{display:flex;align-items:center;gap:22px;width:100%}
.cinema-app .narrative-life .person-result-next>.scene-decision-main{flex:1;align-self:auto;grid-column:auto;grid-row:auto}
.cinema-app .narrative-life .person-result-next>.scene-decision-main>button{background:#e4d09b;color:#19382f;border:1px solid #eedba7;font:17px/1.6 var(--serif)}
.cinema-app .narrative-life .person-result-choice .person-result-rest,.cinema-app .narrative-life .person-result-choice>.person-result-record{align-self:flex-start;border:0;border-bottom:1px solid #bfaa7355;background:none;color:#e6d0a0;font:15px/1.8 var(--serif);padding:4px 0;min-height:0;box-shadow:none}
.cinema-app .narrative-life .person-result-choice button:hover:not(:disabled){background:#294b3c;color:#fff0cc;transform:none;border-color:#e6cb8b}
.cinema-app .narrative-life .person-result-choice button:disabled{background:#20362f;color:#adb69f;border-color:#89947a;border-style:dashed;transform:none}
.cinema-app .narrative-life .person-result-choice button:focus-visible{outline:2px solid #f1d69b;outline-offset:4px}
