.cinema-app .dialog.today-daily-dialog .today-life-options{grid-template-columns:repeat(3,minmax(0,1fr));gap:26px}
.cinema-app .dialog.today-daily-dialog .today-life-heading{gap:10px;align-items:center}
.cinema-app .dialog.today-daily-dialog .today-life-sketch{width:52px;height:58px}
.cinema-app .dialog.today-daily-dialog .today-life-terms{flex-wrap:wrap;column-gap:14px;row-gap:0}
.cinema-app .dialog.today-daily-dialog .today-life-effect{min-height:76px}
.cinema-app .dialog.today-daily-dialog .today-work-unavailable strong{font:400 22px/1.7 var(--serif);color:#dcc69d}
.cinema-app .dialog.today-daily-dialog .today-work-reading{display:block;width:100%;min-height:46px;padding:10px 15px;border:1px solid #c7af7955;background:#213d31;color:#ecdbb0;font:17px/1.7 var(--serif);text-align:left;transform:none}
.cinema-app .dialog.today-daily-dialog .today-life-option button:is(:hover,:focus-visible):not(:disabled){background:#dfc791;color:#152b24;transform:none;box-shadow:none}
.cinema-app .dialog.today-daily-dialog .today-life-option button:disabled{background:#2a3b30;color:#a7b199;border:1px dashed #7c8c75;box-shadow:none;transform:none}
.cinema-app .dialog.today-daily-dialog button:focus-visible{outline:2px solid #f0d398;outline-offset:4px}

.cinema-app .dialog.today-daily-dialog .today-daily-readings{display:flex;align-items:baseline;gap:24px;flex-wrap:wrap}
.cinema-app .dialog.today-daily-dialog .today-daily-readings>button{padding:5px 0;background:none;border:0;border-bottom:1px solid #baa36b66;color:#dfcca2;font:14px/1.8 var(--serif);transform:none}
