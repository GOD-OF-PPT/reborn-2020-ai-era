/* Decisions stay together on the scene; the original order and rule readers stay separate. */
.cinema-app .narrative-market .market-choice-stage{--market-ink:#eee4cb;--market-muted:#d4ddc7;--market-gold:#ebd29b;width:100%;flex:1;min-height:0;display:flex;align-items:flex-start}
.cinema-app .narrative-market .market-choice-stage>.scene-choices{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:24px;width:100%;margin:0;counter-reset:market-thought}
.cinema-app .narrative-market .market-choice-stage .scene-choices>:is(.scene-action-card,.scene-wait-decision,.scene-choice){counter-increment:market-thought;position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:6px;min-height:0;height:auto;width:100%;margin:0;padding:8px 18px 8px 42px;border:0;border-top:1px solid #c9af7280;border-bottom:1px solid #c9af7250;background:linear-gradient(90deg,#102e30e6,#193c3566);color:var(--market-ink);box-shadow:none;text-align:left;transform:none}
.cinema-app .narrative-market .market-choice-stage .scene-choices>:is(.scene-action-card,.scene-wait-decision,.scene-choice)::before{content:counter(market-thought,decimal-leading-zero);position:absolute;left:10px;top:10px;font:18px/1.5 Georgia;color:var(--market-gold)}
.cinema-app .narrative-market .market-choice-stage .scene-choice-overline{display:none}
.cinema-app .narrative-market .market-choice-stage .scene-choices strong{display:block;max-width:none;margin:0;font:500 20px/1.6 var(--serif);color:var(--market-ink)}
.cinema-app .narrative-market .market-choice-stage :is(.scene-choice-line,.scene-wait-decision>p){margin:0;font:15px/1.85 var(--serif);color:var(--market-muted)}
.cinema-app .narrative-market .market-choice-stage .scene-decision-main{margin:0;width:100%}
.cinema-app .narrative-market .market-choice-stage :is(.scene-decision-main>button,.clock-main>button){min-height:44px;padding:10px 14px;font:16px/1.75 var(--serif);white-space:normal}
.cinema-app .narrative-market .market-choice-stage .scene-choice-end{position:static;max-width:none;margin:0;padding:0;font:16px/1.75 var(--serif);color:var(--market-gold)}
.cinema-app .narrative-market .market-choice-stage .scene-choice:is(:hover,:focus-visible){background:linear-gradient(90deg,#294b3ee8,#193c35aa);color:#fff0cf;transform:none}
.cinema-app .narrative-market .market-choice-stage .reason{margin:6px 0 0;color:#f3d3ab;font:15px/1.8 var(--serif)}
.cinema-app .narrative-market .market-choice-stage :is(button,summary):focus-visible{outline:2px solid var(--market-gold);outline-offset:4px}

.cinema-app .narrative-market:has(>.market-choice-stage)>.scene-record-switch{padding-block:4px}
.cinema-app .narrative-market:has(>.market-choice-stage)>.scene-record-switch>span{display:flex;align-items:baseline;gap:12px}
