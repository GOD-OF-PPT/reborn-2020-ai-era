// Normal Create/original in-memory commands; UI owner lifetime is local. No store, codec or compatibility tests.
type Cells={values:unknown[];index:number;cleanups:Array<()=>void>}
const hooks=vi.hoisted(()=>({current:{values:[] as unknown[],index:0,cleanups:[] as Array<()=>void>}}))
vi.mock('react',async original=>{const actual=await original<typeof import('react')>();const state=<T,>(initial:T|(()=>T))=>{const cells=hooks.current.values,i=hooks.current.index++;if(!(i in cells))cells[i]=typeof initial==='function'?(initial as ()=>T)():initial;return [cells[i] as T,(next:T|((old:T)=>T))=>{cells[i]=typeof next==='function'?(next as (old:T)=>T)(cells[i] as T):next}] as const};return {...actual,useState:state,useRef:<T,>(initial:T)=>state(()=>({current:initial}))[0],useEffect:(fn:()=>void|(()=>void),deps?:readonly unknown[])=>{if(deps?.length===0){const clean=fn();if(typeof clean==='function')hooks.current.cleanups.push(clean)}},useLayoutEffect:()=>{},useId:()=> 'teaching-object-ui'}})
afterEach(()=>{hooks.current={values:[],index:0,cleanups:[]};vi.clearAllMocks()})
type Element=ReactElement<Record<string,unknown>>
const elements=(v:unknown):Element[]=>Array.isArray(v)?v.flatMap(elements):isValidElement<Record<string,unknown>>(v)?[v,...elements(v.props.children),...elements(v.props.footer)]:[]
const words=(v:unknown):string=>typeof v==='string'||typeof v==='number'?String(v):Array.isArray(v)?v.map(words).join(''):isValidElement<Record<string,unknown>>(v)?words(v.props.children):''
function scope<T>(cells:Cells,fn:()=>T){const old=hooks.current;hooks.current=cells;cells.index=0;try{return fn()}finally{hooks.current=old}}
const cells=():Cells=>({values:[],index:0,cleanups:[]})
const registry=createCampaignRegistry(),initial=createCampaignRun({runId:'studio-preparation-ui',actorId:'player',commandId:'create',seed:'studio-preparation-ui',backgroundId:'technical_employee',playerProfile:{wishId:'own_brand',approach:'free'}})
function act(run:GameRun,kind:string,payload:Record<string,unknown>){const result=evaluateCommand(run,{runId:run.runId,actorId:run.actorId,commandId:'studio-ui-'+run.revision,expectedRevision:run.revision,kind,payload},registry,run.actorId);if(result.status!=='proposed')throw Error('NORMAL_COMMAND_REQUIRED:'+JSON.stringify({kind,date:run.timeline.cursor.date,result}));return result.nextRun}
function input(run:GameRun,accountId='personal'):GamePanelProps{const f=registry.runtime!.project!(run),view:GamePanelProps['view']={...projectRun(run),features:f,saveStatus:'saved',busy:false,readOnly:false,readOnlyReason:null,hasCandidate:false,pendingRevision:null};return {view,features:f as unknown as PlayFeatures,accountId,request:vi.fn(),controller:{snapshot:{view,busy:false},asynchronous:false,runtimeFailed:false,preview:(command:CommandEnvelope)=>previewCommand(run,command,registry,run.actorId)} as unknown as GamePanelProps['controller']}}
function current(run:GameRun,target:CourseSceneTarget|null){const v=input(run).features.course!,owner=target?v.businesses.find(b=>b.id===target.businessId)!.accountId:'personal',p=input(run,owner),focus=courseFocusFor(p,target,owner);return {p,focus,thread:playerThread(p,focus)}}
function advance(run:GameRun,date:string){for(let n=0;n<12&&run.timeline.cursor.date<date;n++)run=act(run,'AdvanceTime',{date});expect(run.timeline.cursor.date).toBe(date);return run}
function career(run:GameRun,target:string){for(let n=0;n<600;n++){const p=input(run),w=p.features.workbench,date=p.view.date;if(w.pause){if(w.pause.reason!=='CONTENT_DECISION_PENDING')throw Error('UNHANDLED_NORMAL_PAUSE:'+w.pause.reason);const e=w.events.find(e=>e.isBlocking),choice=e?.choices.find(c=>c.isDefault);if(!e||!choice||choice.costFen!==0||choice.actionPoints!==0)throw Error('EXPLICIT_PUBLIC_ZERO_DEFAULT_REQUIRED');run=act(run,'ChooseEvent',{instanceId:e.id,choiceId:choice.id});continue}const limit=quarterLimit(date),employed=p.view.operations?.employment.some(e=>e.quarter===quarterOf(date)&&e.segments.some(s=>s.to===null));if(!employed&&date<dayBefore(limit)&&p.view.budget.available>=2){run=act(run,'WorkQuarter',{});continue}if(date===target&&run.timeline.cursor.phase==='snapshot')return run;run=act(run,'AdvanceTime',{date:target<limit?target:date===dayBefore(limit)?limit:dayBefore(limit)})}throw Error('NORMAL_CAREER_BOUND')}

let historical:GameRun,promoting:GameRun,reached:GameRun,supportStarted:GameRun,assessed:GameRun,recoveryPlanned:GameRun,recovered:GameRun,closed:GameRun,businessId:string,courseId:string,plannedClass:GameRun,enrolled:GameRun,stage1Planned:GameRun,stage1Done:GameRun,stage2Done:GameRun,classStart:string,classEnd:string,cohortId:string
beforeAll(()=>{
 let run=act(initial,'StartFirstOrder',{});run=advance(run,'2020-01-19');run=act(run,'SubmitDelivery',{contractId:input(run).features.firstOrder.contractId!});run=advance(run,'2020-01-20');run=career(run,'2022-11-30');run=act(run,'OpenCourseStudio',{capitalFen:500000});businessId=input(run).features.course!.businesses[0]!.id;run=act(run,'StartCourseOutline',{businessId,resources:['player-production'],startAt:'2022-11-30'});run=career(run,'2022-12-07');run=act(run,'ActivateBusiness',{businessId});const paid=input(run).features.course!.cases[0]!;
 run=act(run,'DefineCourse',{businessId,name:'把亲历讲清楚',productId:'intro_recorded',topicId:'image_workflows',edition:'foundation',segment:'local_merchants',cases:[{kind:paid.kind,id:paid.id}],consent:true});courseId=input(run).features.course!.courses[0]!.id;run=act(run,'OpenVideoChannel',{name:'教学准备的工具申请',segment:'local_merchants'});const channelId=input(run).features.video!.channels[0]!.id;
 for(let n=0;n<3;n++){
  if(input(run).view.budget.available<1)run=career(run,quarterLimit(input(run).view.date));const date=input(run).view.date;run=act(run,'ApplyVideoProgram',{channelId,program:'image_rights',resources:['player-production'],startAt:date});const app=input(run).features.video!.applications.at(-1)!;run=career(run,addDays(date,7));run=act(run,'DecideVideoProgram',{applicationId:app.id});if(input(run).features.video!.applications.at(-1)!.approved)break;run=career(run,addDays(date,90));
 }
 if(!input(run).features.video!.applications.at(-1)!.approved)throw Error('REAL_PUBLIC_APPLICATION_NOT_APPROVED');if(input(run).view.budget.available<1)run=career(run,quarterLimit(input(run).view.date));run=act(run,'BuildCourseSample',{courseId,resources:['player-production'],startAt:addDays(input(run).view.date,2)});run=career(run,input(run).features.course!.courses[0]!.job!.completeAt);
 const noNewWork=(run:GameRun,target:string)=>{for(let n=0;n<500;n++){const p=input(run),w=p.features.workbench,date=p.view.date;if(w.pause){const e=w.events.find(e=>e.isBlocking),choice=e?.choices.find(c=>c.isDefault);if(w.pause.reason!=='CONTENT_DECISION_PENDING'||!e||!choice||choice.costFen!==0||choice.actionPoints!==0)throw Error('PUBLIC_ZERO_EVENT_REQUIRED');run=act(run,'ChooseEvent',{instanceId:e.id,choiceId:choice.id});continue}if(date>=target&&run.timeline.cursor.phase==='snapshot')return run;const limit=quarterLimit(date);run=act(run,'AdvanceTime',{date:target<limit?target:date===dayBefore(limit)?limit:dayBefore(limit)})}throw Error('CLASS_NORMAL_WALK_BOUND')};
 run=act(run,'FundBusiness',{businessId,amountFen:1000000});if(input(run).view.budget.available<1)run=career(run,quarterLimit(input(run).view.date));promoting=act(run,'CreateCourseAudience',{courseId,mode:'paid',priceFen:19900,resources:['player-production'],startAt:addDays(quarterLimit(input(run).view.date),1)});reached=noNewWork(promoting,input(promoting).features.course!.audiences.at(-1)!.job!.completeAt);


 run=reached;
 const lesson=input(run).features.course!.courses.find(c=>c.id===courseId)!;
 if(lesson.unresolvedUpdates.length){run=act(run,'StartCourseRefresh',{courseId,resources:['player-production'],startAt:input(run).view.date});run=noNewWork(run,input(run).features.course!.courses.find(c=>c.id===courseId)!.refreshes.at(-1)!.job!.completeAt)}
 if(input(run).features.course!.courses.find(c=>c.id===courseId)!.paused)run=act(run,'ResumeCourseEnrollment',{courseId});
 run=act(run,'FundBusiness',{businessId,amountFen:1000000});classStart=input(run).view.budget.available<3?Array.from({length:10}).reduce<string>(date=>dayBefore(date),quarterLimit(input(run).view.date)):addDays(input(run).view.date,2);classEnd=addDays(classStart,21);const audienceId=input(run).features.course!.audiences.at(-1)!.id;
 plannedClass=act(run,'PlanCourseCohort',{courseId,audienceId,startAt:classStart,endAt:classEnd,supportStartAt:classEnd,seatLimit:10,supportMode:'guided_group',deploymentId:null,resources:['player-production'],promise:'clear_scope'});const co=input(plannedClass).features.course!.cohorts.at(-1)!;cohortId=co.id;enrolled=act(plannedClass,'EnrollCourseAudience',{cohortId,personIds:co.availablePeople.slice(0,10)});stage1Planned=act(enrolled,'StartCourseStage',{cohortId,index:0,resources:['player-production'],startAt:classStart});stage1Done=noNewWork(stage1Planned,addDays(classStart,7));run=act(stage1Done,'StartCourseStage',{cohortId,index:1,resources:['player-production'],startAt:addDays(input(stage1Done).view.date,1)});stage2Done=noNewWork(run,addDays(input(stage1Done).view.date,8));
 supportStarted=noNewWork(stage2Done,input(stage2Done).features.course!.cohorts.find(c=>c.id===cohortId)!.supportJobs[0]!.job!.startAt);assessed=noNewWork(supportStarted,input(supportStarted).features.course!.cohorts.find(c=>c.id===cohortId)!.supportCompleteAt);
 const assessedCo=input(assessed).features.course!.cohorts.find(c=>c.id===cohortId)!;expect(assessedCo.assessmentAt).not.toBeNull();console.log(JSON.stringify({assessment:input(assessed).view.date,needs:assessedCo.students.filter(s=>s.outcome==='needs_recovery').length,remedy:assessedCo.remedyDueAt}));
 recoveryPlanned=act(assessed,'StartCourseRecovery',{cohortId,supportMode:'guided_group',deploymentId:null,resources:['player-production'],startAt:input(assessed).view.date});recovered=noNewWork(recoveryPlanned,assessedCo.remedyDueAt);
 closed=noNewWork(recovered,addDays(assessedCo.refundUntil,1));historical=career(closed,quarterLimit(input(closed).view.date));


},120000)


const cohort=():CourseSceneTarget=>({kind:'cohort',businessId,courseId,cohortId})
const audience=(p:GamePanelProps):CourseSceneTarget=>({kind:'audience',businessId,courseId,audienceId:p.features.course!.audiences[0]!.id})
function records(p:GamePanelProps):CourseSceneTarget[]{const v=p.features.course!;return [...v.courses.filter(c=>c.status==='ready').map(c=>({kind:'course' as const,businessId:c.businessId,courseId:c.id})),...v.audiences.map(a=>({kind:'audience' as const,businessId:v.courses.find(c=>c.id===a.courseId)!.businessId,courseId:a.courseId,audienceId:a.id})),...v.cohorts.map(co=>({kind:'cohort' as const,businessId:v.courses.find(c=>c.id===co.courseId)!.businessId,courseId:co.courseId,cohortId:co.id}))].filter(t=>courseTargetReason(v,t,{operations:p.view.operations})===null)}
function driver(run=closed,target0=cohort(),transform?:(p:GamePanelProps)=>GamePanelProps){const original=current(run,target0).p,base={...original,courseTeachingDraftMemory:createCourseTeachingDraftMemory(original.view.runId)},p=transform?.(base)??base,parent=cells(),child=cells();let target:CourseSceneTarget|null=target0,open:((intent?:CourseTeachingIntent)=>void)|undefined;const chosen=vi.fn((next:CourseSceneTarget|null)=>{target=next}),today=vi.fn(),render=()=>scope(parent,()=>elements(CourseTeachingChoice({p,target,onTarget:chosen,onToday:today,children:fn=>{open=fn;return null}}))),object=()=>render().find(n=>n.type===CourseObjectChoices),choices=()=>{const e=object();if(!e)return [];return scope(child,()=>elements(CourseObjectChoices(e.props as unknown as ComponentProps<typeof CourseObjectChoices>)))};render();return {p,chosen,today,render,object,choices,get target(){return target},open(intent:CourseTeachingIntent='targets'){render();open!(intent);render()},close(){const d=render().find(n=>n.type===Dialog)!;(d.props.onClose as ()=>void)();render()},click(label:string){const n=[...render(),...choices()].find(n=>n.type==='button'&&(String(n.props['aria-label']??'').startsWith(label)||words(n).startsWith(label)));if(!n||n.props.disabled||typeof n.props.onClick!=='function')throw Error('BUTTON_REQUIRED:'+label);n.props.onClick();render()},field(label:string,value:string|boolean){const wrap=render().find(n=>n.type==='label'&&words(n).startsWith(label)),n=elements(wrap).find(n=>n.type==='input'||n.type==='select');if(!n||typeof n.props.onChange!=='function')throw Error('FIELD_REQUIRED:'+label);n.props.onChange({target:{value,checked:value}});render()},unmount(){for(const cleanup of parent.cleanups)cleanup()}}}

it('teaching returns exactly the original ready-course/audience/class target set without preparation or a fabricated sample target',()=>{const p=current(closed,cohort()).p,allowed=records(p),reading=courseTeachingObjectReading(p,cohort(),allowed)!;expect(reading.entries.map(e=>e.target)).toEqual(expect.arrayContaining(allowed.filter(t=>t.businessId===businessId)));expect(reading.entries).toHaveLength(allowed.filter(t=>t.businessId===businessId).length);expect(reading.entries.some(e=>e.group==='preparation')).toBe(false);const c=reading.entries.find(e=>e.target.kind==='course')!;expect(c.target).toEqual({kind:'course',businessId,courseId});expect('sampleJobId' in c.target).toBe(false);expect(p.request).not.toHaveBeenCalled()})
it('a single explicit original audience choice closes the targets sheet and returns to its same current scene',()=>{const ui=driver();ui.open();expect(ui.render().find(n=>n.type===Dialog)!.props.layout).toBe('direct');const reading=ui.object()!.props.reading as CourseObjectReading,e=reading.entries.find(e=>e.target.kind==='audience')!,before=JSON.stringify(ui.p.view);(ui.object()!.props.onChoose as (t:CourseSceneTarget)=>void)(e.target);expect(ui.chosen).toHaveBeenCalledExactlyOnceWith(e.target);expect(ui.render().some(n=>n.type===Dialog)).toBe(false);expect(ui.target).toEqual(e.target);expect(JSON.stringify(ui.p.view)).toBe(before);expect(ui.p.request).not.toHaveBeenCalled()})
it('no empty preparation category is introduced into a teaching-only selection',()=>{const ui=driver();ui.open();expect(words(ui.choices())).toContain('班期与学员');expect(words(ui.choices())).toContain('课程与受众');expect(words(ui.choices())).not.toContain('教室与准备');expect(ui.chosen).not.toHaveBeenCalled()})
it('the complete original radio selection remains reachable and returns without publishing a different object',()=>{const ui=driver();ui.open();ui.click('翻选全部课程、受众与班期');expect(ui.render().find(n=>n.type===Dialog)!.props.layout).toBe('book');expect(ui.render().some(n=>n.type==='input'&&n.props.type==='radio')).toBe(true);expect(words(ui.render())).toContain('明确选择这一份承诺');expect(words(ui.render())).toContain('原班已于');expect(words(ui.render())).not.toContain('原责任继续');ui.click('回到同教室的经历');expect(ui.object()).toBeDefined();expect(ui.chosen).not.toHaveBeenCalled();expect(ui.target).toEqual(cohort());expect(ui.p.request).not.toHaveBeenCalled()})
it('moving to the full list and back retires a stale direct-selection callback even after A-B-A',()=>{const ui=driver();ui.open();const node=ui.object()!,choose=node.props.onChoose as (t:CourseSceneTarget)=>void,e=(node.props.reading as CourseObjectReading).entries[0]!;ui.click('翻选全部课程、受众与班期');ui.click('回到同教室的经历');choose(e.target);expect(ui.chosen).not.toHaveBeenCalled();expect(ui.object()).toBeDefined()})
it('closing/reopening and unmounting each retire the old local reader without executing any command',()=>{const ui=driver();ui.open();const node=ui.object()!,old=node.props.onChoose as (t:CourseSceneTarget)=>void,e=(node.props.reading as CourseObjectReading).entries[0]!;ui.close();ui.open();old(e.target);expect(ui.chosen).not.toHaveBeenCalled();const live=ui.object()!.props.onChoose as (t:CourseSceneTarget)=>void;ui.unmount();live(e.target);expect(ui.chosen).not.toHaveBeenCalled();expect(ui.p.request).not.toHaveBeenCalled()})
it('a current open class keeps its original protection and deadlines while browsing another object does not remove its students or commitments',()=>{const ui=driver(enrolled,cohort());ui.open();expect(ui.object()).toBeDefined();const text=words(ui.render());expect(text).toContain('原责任继续');expect(text).not.toContain('原班已于');const before=JSON.stringify(ui.p.features.course!.cohorts),r=ui.object()!.props.reading as CourseObjectReading,e=r.entries.find(e=>e.target.kind==='audience')!;(ui.object()!.props.onChoose as (t:CourseSceneTarget)=>void)(e.target);expect(JSON.stringify(ui.p.features.course!.cohorts)).toBe(before);expect(ui.p.request).not.toHaveBeenCalled()})
it('a genuinely closed original class shows its actual closed date while retaining the same support and refund dates',()=>{const ui=driver(),co=ui.p.features.course!.cohorts.find(co=>co.id===cohortId)!;ui.open();const text=words(ui.render());expect(text).toContain('原班已于'+co.closedAt+'结清');expect(text).toContain(co.supportCompleteAt);expect(text).toContain(co.refundUntil);expect(text).not.toContain('原责任继续');expect(ui.p.request).not.toHaveBeenCalled()})
it('an unsubmitted class promise survives close, direct/full reading and reopening the original editor',()=>{const p=current(closed,cohort()).p,ui=driver(closed,audience(p));ui.open('plan');ui.field('明确范围与练习目标',true);ui.field('本班最多明确接下多少人','8');ui.close();ui.open('targets');const originalAudience=p.features.course!.audiences[0]!;expect(words(ui.render())).toContain('当前原报价');expect(words(ui.render())).toContain('来源'+originalAudience.createdAt);ui.click('翻选全部课程、受众与班期');ui.click('回到同教室的经历');ui.close();ui.open('plan');expect(ui.render().find(n=>n.type==='input'&&n.props.inputMode==='numeric')!.props.value).toBe('8');expect(ui.render().find(n=>n.type==='input'&&n.props.type==='radio')!.props.checked).toBe(true);expect(ui.p.request).not.toHaveBeenCalled()})
it('presentation-only unresolved updates retain the original full reader and visible responsibility rather than dropping the warning',()=>{const ui=driver(closed,cohort(),p=>{const v=p.features.course!,old=v.updates[0]!;expect(old).toBeDefined();return {...p,features:{...p.features,course:{...v,courses:v.courses.map(c=>c.id===courseId?{...c,unresolvedUpdates:[{...old,resolvedAt:null,dueAt:p.view.date}]}:c)}}}});ui.open();expect(ui.object()).toBeUndefined();expect(ui.render().find(n=>n.type===Dialog)!.props.layout).toBe('book');expect(words(ui.render())).toContain('原课程更新最早期限');expect(ui.p.request).not.toHaveBeenCalled()})
it('duplicate presentation-only original record identities decline the direct subset instead of borrowing another target',()=>{const p=current(closed,cohort()).p,allowed=records(p);expect(courseTeachingObjectReading(p,cohort(),[...allowed,allowed[0]!])).toBeNull();expect(courseTeachingObjectReading({...p,accountId:'personal'},cohort(),allowed)).toBeNull();expect(p.request).not.toHaveBeenCalled()})
it('the visible light entry reuses guarded object reading and leaves the original main result action intact',()=>{const c=current(closed,cohort()),chosen=vi.fn(),today=vi.fn(),outer=CourseEncounter({p:c.p,thread:c.thread,date:null,waitLabel:'',onChoose:chosen,onResult:vi.fn(),onToday:today});if(!isValidElement<ComponentProps<typeof CourseThreadAction>>(outer))throw Error('ORIGINAL_ACTION_REQUIRED');const tree=CourseThreadAction(outer.props),node=elements(tree).find(e=>e.type===CourseStudioAction&&((e.props.reading as {label:string}).label==='翻回这间教室的其它经历'))!;expect(node).toBeDefined();let binding:SharedActionBinding|undefined;scope(cells(),()=>CourseStudioAction({...node.props as unknown as ComponentProps<typeof CourseStudioAction>,children:v=>{binding=v.binding;return null}}));binding!.activate();expect(chosen).toHaveBeenCalledExactlyOnceWith('objects');expect(today).not.toHaveBeenCalled();expect(words(tree)).toContain('回到今天，看看接下来的日子');expect(c.p.request).not.toHaveBeenCalled()})
it('the original phase title stays attached to the original target after selecting a different audience',()=>{const ui=driver();ui.open();const r=ui.object()!.props.reading as CourseObjectReading,e=r.entries.find(e=>e.target.kind==='audience')!;expect(e.state).toBe(courseSceneProgress(ui.p.features.course,ui.p.view.date,e.target,{operations:ui.p.view.operations})!.title);expect(e.kind).toContain('报价');expect(ui.p.request).not.toHaveBeenCalled()})

it('a real completed audience from a prior quarter has a distinct read-only history surface with its own quote and feedback',()=>{const p=current(historical,cohort()).p,t=audience(p),c=current(historical,t),a=c.p.features.course!.audiences.find(a=>a.id===(t.kind==='audience'?t.audienceId:null))!;expect(c.thread.focusScope).toBe('history');const reading=courseAudienceReading(c.p,c.thread);expect(reading?.historical).toBe(true);expect(reading?.line).toContain(a.completedAt);expect(reading?.detail).toContain('原报价');expect(reading?.stageLabel).toContain(c.thread.focusQuarter);expect(c.p.request).not.toHaveBeenCalled();expect(courseAudienceReading(c.p,{...c.thread,focusQuarter:c.p.features.workbench.quarter})).toBeNull()})
it('a real historical audience primary opens only its original next-choice reading and never invents an existing class',()=>{const c=current(historical,audience(current(historical,cohort()).p)),result=vi.fn(),choose=vi.fn(),tree=CourseThreadAction({p:c.p,thread:c.thread,active:true,date:null,waitLabel:'',onChoose:choose,onResult:result,onToday:vi.fn(),children:v=>v?.main});expect(words(tree)).toContain('看清这份原回应，再决定下一步');expect(words(tree)).not.toContain('同一班');const button=elements(tree).find(n=>n.type==='button')!;(button.props.onClick as ()=>void)();expect(result).toHaveBeenCalledOnce();expect(choose).not.toHaveBeenCalled();const encounter=CourseEncounter({p:c.p,thread:c.thread,date:null,waitLabel:'',onChoose:choose,onResult:result,onToday:vi.fn()});if(!isValidElement<ComponentProps<typeof CourseThreadAction>>(encounter))throw Error('ORIGINAL_READING_REQUIRED');expect(words(CourseThreadAction(encounter.props))).toContain(courseAudienceReading(c.p,c.thread)!.detail);expect(c.p.request).not.toHaveBeenCalled()})
