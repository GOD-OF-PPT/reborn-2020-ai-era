.cinema-app .dialog.season-turn>.dialog-direct-body{display:flex;flex:1;min-height:0;align-items:center}
.cinema-app .season-turn-summary{display:flex;flex-direction:column;gap:13px;width:100%;color:#e9dfc7}
.cinema-app .season-turn-summary>p{margin:0;font:17px/1.8 var(--serif);color:#d4d8c2}
.cinema-app .season-turn-summary>.season-turn-date{font:14px/1.7 var(--serif);color:#c9b77f}
.cinema-app .season-turn-summary>.season-turn-result{padding-left:15px;border-left:2px solid #d4b777;font:21px/1.8 var(--serif);color:#eee0bd}
.cinema-app .season-turn-summary>h3{font:400 23px/1.6 var(--serif);margin:6px 0 0;color:#ead9ae}
.cinema-app .season-turn-pending{padding:9px 0 9px 15px;border-left:1px solid #c1a86b77}
.cinema-app .season-turn-pending strong{font:400 18px/1.7 var(--serif);color:#e7d9b7}
.cinema-app .season-turn-pending p{margin:4px 0 0;font:16px/1.75 var(--serif);color:#ccd1bd}
.cinema-app .dialog>.season-turn-actions{display:flex;flex-direction:column;align-items:stretch;gap:12px;padding-top:14px}
.cinema-app .season-turn-actions>.clock-advance{display:flex;align-items:center;gap:20px;flex-wrap:nowrap}
.cinema-app .season-turn-actions .clock-main{flex:1;min-width:0}
.cinema-app .season-turn-actions .clock-main>button{display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:6px 14px;width:100%;padding:12px 16px;font:18px/1.7 var(--serif)}
.cinema-app .season-turn-actions .clock-main>button>small{flex-basis:100%;text-align:left}
.cinema-app .season-turn-actions .clock-review{flex:none}
.cinema-app .dialog .season-turn-read{align-self:flex-start;font:16px/1.7 var(--serif);padding:5px 0;background:none;border:0;border-bottom:1px solid #c1a86b77;color:#ddc58d}
.cinema-app .season-turn :is(button,summary):focus-visible{outline:2px solid #f1d99f;outline-offset:4px}
