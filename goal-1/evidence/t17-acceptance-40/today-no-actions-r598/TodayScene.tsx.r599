import {sceneReadingLabel,sceneReadingName} from './scene-language.ts'
import {isValidElement,useEffect,useImperativeHandle,useRef,useState,type Ref,type ReactNode,type ComponentProps} from 'react'
import type {GamePanelProps,NavigateScene} from './game-types.ts'
import {openingFocusFor,type OpeningFocus} from './player-thread.ts'
import {VideoSceneChoice} from './VideoSceneChoice.tsx'
import {CourseSceneChoice} from './CourseSceneChoice.tsx'
import {todayReadingGroups,type TodayThreadView} from './today-thread.ts'
import {OpeningObject} from './OpeningObject.tsx'
import {Dialog} from './Dialog.tsx'
import {TodayHoldings} from './TodayHoldings.tsx'
import {TodayLifeChoices} from './TodayLifeChoices.tsx'
import {TodayDirections} from './TodayDirections.tsx'
import {TodayMarketChoices} from './TodayMarketChoices.tsx'
import {ClockAdvance} from './ClockAdvance.tsx'
import {MarketSceneChoice} from './MarketSceneChoice.tsx'
import {makeSharedAction} from './shared-action.ts'
import {moneyText} from './game-text.ts'
import {RoomTableau} from './RoomTableau.tsx'
import {sceneMeaning} from './scene-meaning.ts'
import {relayBusinessTarget} from './relay-player-thread.ts'
import {ecosystemCalendarStatus,ecosystemUiStatus} from './ecosystem-ui-status.ts'
import './today-scene.css'
import {personalRestCompleted,personalStartNoticeExpired} from './personal-day-copy.ts'
import {SceneTimeNotice} from './SceneEcho.tsx'
import {todayResultReading} from './today-result-reading.ts'
import {TodayIdleAction,todayIdleReading,type TodayIdlePrimary} from './TodayIdleAction.tsx'

type Props={p:GamePanelProps;today:TodayThreadView;headingRef:Ref<HTMLHeadingElement>;feedback?:ReactNode;onFocus:(focus:OpeningFocus)=>void;onPrepare:(focus:OpeningFocus)=>void;onResume:()=>void;onExplore:()=>void;onRecollection:()=>void;onNavigate:NavigateScene}
type Page='directions'|'life'|'market'|'ongoing'|'holdings'

/** Today is a reading/choice perspective. Only original command controls can make a new promise. */
export function TodayScene({p,today,headingRef,feedback,onFocus,onPrepare,onResume,onExplore,onRecollection,onNavigate}:Props){
 const [page,setPage]=useState<Page|null>(null)
 const [studyChoice,setStudyChoice]=useState<{runId:string;definitionId:string}|null>(null)
 const originalStudy=today.primary.thread.focus.kind==='market'&&today.primary.thread.focus.entityKind==='research'?p.features.market.researches.find(row=>row.id===today.primary.thread.focus.entityId)?.definitionId:undefined
 const studyId=studyChoice?.runId===p.view.runId?studyChoice.definitionId:originalStudy??'market-overview'
 const localHeading=useRef<HTMLHeadingElement>(null)
 useImperativeHandle(headingRef,()=>localHeading.current!,[])
 useEffect(()=>{localHeading.current?.focus({preventScroll:true})},[])
 const personal={...p,accountId:'personal'}
 const ui=(label:string,activate:()=>void)=>makeSharedAction(p,label,activate,{allowReadOnly:true})
 const choose=(focus:OpeningFocus)=>{const binding=ui('把这件事放回眼前',()=>{setPage(null);onFocus(focus)});binding.activate()}
 const prepare=(next:'life'|'market')=>{const binding=ui('选择新的方向',()=>setPage(next));binding.activate()}
 const request:GamePanelProps['request']=(...args)=>{setPage(null);p.request(...args)}
 const commandProps={...personal,request}
 const {continuing,holdings}=todayReadingGroups(today.ongoing)
 const one=continuing.length===1?continuing[0]:null
 const relayContinuation=one?.focus.kind==='relay'?one.relayContinuation:undefined
 const continuation=relayContinuation??one?.ecosystemContinuation??one?.equityContinuation??one?.marketContinuation
 const hasMoney=continuing.some(item=>item.relayContinuation?.kind==='money'||item.ecosystemContinuation?.kind==='money'||item.equityContinuation?.kind==='money'||item.marketContinuation?.kind==='money')
 const statusFeedback=today.primary.thread.focus.kind==='ecosystem'?ecosystemUiStatus(feedback,p.view.date):null
 const calendarStatus=today.primary.thread.focus.kind==='ecosystem'?ecosystemCalendarStatus(feedback,p.view.date):null
 const repeatedReadOnly=p.view.readOnly&&feedback==='当前为只读，请查看写入状态说明。'
 const afterRest=continuing.length===0&&today.primary.classification==='result'&&!today.responsibilityOverrideNeeded&&!p.features.workbench.atQuarterEnd&&today.source.runId===p.view.runId&&today.source.revision===p.view.revision&&today.source.date===p.view.date&&personalRestCompleted(p,today.primary.thread)
 const primary=p.features.workbench.atQuarterEnd?ui('看看这一季，实际留下了什么',onRecollection)
  :one?ui(one.focus.kind==='relay'?relayContinuation?.label??'回到这份原中转事项':one.ecosystemContinuation?.label??one.equityContinuation?.label??one.marketContinuation?.label??'继续'+({work:'这季的工作',life:'这段生活安排',course:'这份教学约定',video:'这份作品',market:'这份模拟委托',ecosystem:'这份原生态事项',equity:'这份架空权益与原款',free:'原来的安排','first-order':'这份委托'}[one.focus.kind]),()=>choose(one.focus))
  :continuing.length>1?ui('选回一件未完的约定',()=>setPage('ongoing'))
  :afterRest?ui('看看这季的工作',()=>choose({runId:p.view.runId,kind:'work',accountId:'personal',entityId:null}))
  :ui('给生活留一段真实的日子',()=>prepare('life'))
 const meaning=today.primary.classification==='history'?null:sceneMeaning({...p,accountId:today.primary.thread.focus.accountId},today.primary.thread)
 const resultNotice=isValidElement<ComponentProps<typeof SceneTimeNotice>>(feedback)&&feedback.type===SceneTimeNotice&&feedback.props.compact===true?feedback:null
 const resultReading=todayResultReading(p,today,resultNotice?.props)
 const idleReading=todayIdleReading(p,today)
 const situation=resultReading?.line??meaning?.situation??(continuation?one!.line:hasMoney||!continuing.length&&p.features.relay?.businesses.length?today.line:continuing.length?'还有'+continuing.length+'件已经答应的事，正在照约定继续。':holdings.length?'持仓留在原账上；今天仍可选择工作、生活或新的尝试。':null)
 const dueCustomers=p.features.relay?.customers.filter(customer=>customer.dueReceivableFen>0)??[]
 const dueTotal=dueCustomers.reduce((sum,customer)=>sum+customer.dueReceivableFen,0)
 const button=(label:string,activate:()=>void,description?:string)=>{const action=ui(label,activate);return <button type="button" aria-label={sceneReadingName(label)} disabled={action.disabled} onClick={action.activate}>{sceneReadingLabel(label)}{description?<span>{description}</span>:null}</button>}
 const videoFocus=today.primary.thread.focus.kind==='video'?today.primary.thread.focus:null
 const videoTarget=videoFocus?.videoTarget??undefined
 const videoProps={...p,accountId:videoFocus?.accountId??'personal',request}
 const courseFocus=today.primary.thread.focus.kind==='course'?today.primary.thread.focus:null
 const courseProps={...p,accountId:courseFocus?.accountId??'personal',request}
 const research=p.features.workbench.researches.find(r=>r.id===studyId)
 if(today.responsibilityOverrideNeeded)return <section className="room-current-moment opening-current-moment" aria-label="今天仍需面对的责任"><header className="moment-heading"><p>今天 {p.view.date}</p><h1 ref={localHeading} tabIndex={-1}>先面对已经答应的事。</h1></header><p>原来的交付、期限或资金责任仍在；这页不替你新增安排。</p>{button('回到眼前需要处理的事',onResume)}</section>
 const render=(idlePrimary:TodayIdlePrimary|null)=><VideoSceneChoice p={videoProps} {...(videoTarget?{target:videoTarget}:{})} onTargetChange={target=>{const next=openingFocusFor(p,'video',{videoTarget:target});if(next)onPrepare(next)}} onToday={()=>setPage(null)} onLife={()=>{setPage(null);onNavigate('life',{accountId:'personal'})}} onInspect={target=>{setPage(null);const owner=p.features.video?.channels.find(c=>c.id===target?.channelId);onNavigate('video',{openRecord:true,...(target?{videoTarget:target}:{}),accountId:owner?.accountId??videoProps.accountId})}}>{openVideo=><CourseSceneChoice p={courseProps} target={courseFocus?.courseTarget??null} onTarget={target=>{const next=openingFocusFor(p,'course',{courseTarget:target});if(next)onPrepare(next)}} onToday={()=>setPage(null)} onLife={()=>{setPage(null);onNavigate('life',{accountId:'personal'})}} onInspect={(target,slot,teachingSlot)=>{setPage(null);const owner=p.features.course?.businesses.find(b=>b.id===target?.businessId);onNavigate('course',{openRecord:true,courseTarget:target,accountId:owner?.accountId??courseProps.accountId,...(slot?{courseDraftSlot:slot}:{}),...(teachingSlot?{courseTeachingSlot:teachingSlot}:{})})}}>{openCourse=><MarketSceneChoice p={commandProps} onFullRecord={()=>onNavigate('market',{accountId:'personal',openRecord:true})}>{openOrder=><>
  <RoomTableau scene="today" state={today.primary.classification} perspective="today" textOnly={p.textOnly===true}
   intention={<p className="opening-room-intention"><span>我想{today.primary.thread.wish.label}</span>{button('回到书签里的那件事 ↗',onResume)}{button('翻季度留页 ↗',onRecollection)}</p>}
   heading={<header className="moment-heading"><p>{p.features.workbench.quarter} / 今天的日历 · {p.view.date}</p><h1 ref={localHeading} tabIndex={-1}>{idleReading?.title??(one?continuation?.kind==='unknown'?'原站的责任，先核清来源。':continuation?.kind==='money'?'这些原款，仍要分别核对。':'这份约定，今天还在继续。':continuing.length>1?hasMoney?'今天，原安排与旧款都在。':'今天，还有几件答应过的事。':afterRest?'歇过之后，想从哪里开始？':holdings.length?'持仓留着，今天想怎么过？':resultReading?.title??meaning?.title??'今天，仍由你安排。')}</h1></header>}
   feedback={!statusFeedback&&!calendarStatus&&!repeatedReadOnly&&feedback&&feedback!=='已从本机存档继续。'&&!personalStartNoticeExpired(p,feedback)?<div className={typeof feedback==='string'?'moment-status':'moment-feedback'}>{feedback}</div>:null}
   facts={<>{idleReading?<p className="moment-terms">{idleReading.line}</p>:null}{situation?<p className="moment-line">{situation}</p>:null}{one?<p className="moment-terms">{continuation?.kind==='money'?'原款仍保留：':'仍在继续：'}{one.title.replace(/[。！？]$/u,'')}{one.wait?' · 下一反馈 '+one.wait.date:''}。</p>:null}{holdings.length?<button type="button" className="scene-text-action today-held-link" onClick={ui('翻看保留的持仓',()=>setPage('holdings')).activate}>翻看保留的持仓 · {holdings.length}份 ↗</button>:null}{dueTotal>0?<p className="relay-scene-money">原客户款已到期、尚未收取 {moneyText(dueTotal)}。<button type="button" className="scene-text-action" onClick={ui('翻看这些原客户款',()=>setPage('ongoing')).activate}>逐位翻回原客户 ↗</button></p>:null}</>}
   decisions={<>{idlePrimary?.node??<div className="command moment-decision moment-primary"><button type="button" aria-label={sceneReadingName(primary.label)} disabled={primary.disabled} onClick={primary.activate}><b aria-hidden="true">01</b><span>{sceneReadingLabel(primary.label)}</span><i aria-hidden="true">→</i></button>{primary.reason?<small className="reason">{primary.reason}</small>:null}</div>}
    {idlePrimary?button('翻阅今天的选择',()=>setPage('directions')):today.wait?<div className="moment-wait"><ClockAdvance p={p} date={today.wait.date} label={'不新增安排，让原日子继续 · '+today.wait.date} room showReason={!p.view.readOnly&&!p.view.hasCandidate&&p.view.saveStatus!=='conflict'}/></div>:button('翻看今天的日历',()=>onNavigate('quarter',{accountId:p.accountId}),'原费用、期限和未完约定都在这里')}
    <button type="button" className="moment-explore" onClick={ui('环顾房间，想想别的可能',onExplore).activate} aria-label="环顾房间，想想别的可能 ↗">环顾房间 <span aria-hidden="true">↗</span></button>
   </>}
   object={<OpeningObject copyMode="tableau" kind="calendar" title="今天的日历" displayTitle="" detail={p.view.date} stageLabel={idlePrimary?'今天 · 先不新增':'今天 · 仍可安排'} actionLabel={sceneReadingLabel((idlePrimary?.binding??primary).label)} onActivate={(idlePrimary?.binding??primary).activate} disabled={(idlePrimary?.binding??primary).disabled} textOnly={p.textOnly===true} dayPaper={{kind:'today',state:'ongoing'}} {...(p.view.readOnly?{protection:'readonly' as const}:p.view.hasCandidate||p.view.saveStatus==='conflict'?{protection:'unsaved' as const}:{})}/>}
   record={<><button type="button" className="scene-text-action" onClick={ui('看看工作、其它尝试与原约定',()=>setPage('directions')).activate} aria-label="想想今天 · 看看工作、其它尝试与原约定 ↗">想想今天 ↗</button>{statusFeedback&&!repeatedReadOnly?<p className="moment-status" role="status">{statusFeedback}</p>:null}{calendarStatus?<div className="ecosystem-reading-status">{calendarStatus}</div>:null}</>}
  />
  {page?<Dialog title={page==='directions'?'今天，想把时间留给什么？':page==='life'?'留点时间给自己':page==='market'?'这次，怎样判断？':page==='holdings'?'保留的持仓':'手头的事'} layout={page==='holdings'||page==='life'||page==='directions'||page==='market'?'direct':'book'} className={'opening-paper today-choice-paper'+(page==='holdings'?' today-held-dialog':page==='life'?' today-life-dialog':page==='directions'?' today-directions-dialog':page==='market'?' today-market-dialog':'')} onClose={()=>setPage(null)} footer={<div className="today-choice-footer">{page!=='directions'?button('返回今天的选择',()=>setPage('directions')):null}{page==='market'?button('先保留现金，不新增委托',()=>setPage(null)):button('先不新增安排，合上这一页',()=>setPage(null))}</div>}>
   {page!=='life'&&page!=='directions'&&page!=='market'?<p className="opening-paper-date">今天 {p.view.date} · {p.features.workbench.quarter}</p>:null}
   {page==='directions'?<TodayDirections date={p.view.date} quarter={p.features.workbench.quarter} existing={today.ongoing.length?button(continuing.length?'继续手头的事':'翻看保留的持仓',()=>setPage(continuing.length?'ongoing':'holdings'),continuing.length?'工作、旧约和待收款':'持有的股份，仍在原账户'):null} choices={{
    work:button('看看工作',()=>choose({runId:p.view.runId,kind:'work',accountId:'personal',entityId:null}),'先看行动占用与工资日期'),
    life:button('留点时间给自己',()=>prepare('life'),'比较休整与住处改善'),
    video:button('做一段视频',()=>{setPage(null);openVideo('select-account')},'先选账号和作品'),
    course:button('准备一堂课',()=>{setPage(null);openCourse('objects')},'先看开放条件与教学准备'),
    relay:button('经营一份服务',()=>{const focus=openingFocusFor(p,'relay',{relayTarget:null,accountId:'personal'});if(focus)choose(focus)},'先看开站条件与客户约定'),
    ecosystem:button('听听合作需求',()=>{const focus=openingFocusFor(p,'deepseek',{ecosystemTarget:null,accountId:'personal',deepseekPane:'ecosystem'});if(focus)choose(focus)},'先看模型、用途与合作条件'),
    equity:button('看看架空参与',()=>{const focus=openingFocusFor(p,'deepseek',{equityTarget:null,accountId:'personal',deepseekPane:'equity'});if(focus)choose(focus)},'先看架空模式与参与条件'),
    market:button('准备一次模拟判断',()=>prepare('market'),'先看资料，或写一份委托'),
   }}/>:null}
   {page==='holdings'?<TodayHoldings items={holdings} onChoose={choose}/>:null}
   {page==='life'?<><TodayLifeChoices p={commandProps}/>{button('看看相识的人与全部生活记录',()=>{setPage(null);onNavigate('life',{accountId:'personal'})})}</>:null}
   {page==='market'?<TodayMarketChoices p={commandProps} studyId={studyId} onStudy={definitionId=>setStudyChoice({runId:p.view.runId,definitionId})} orderAction={button('显选一份新的模拟委托',()=>{setPage(null);openOrder()})} researchAction={research?.state?button(studyId==='market-overview'?'回到这份公开研究':'回到这份研习',()=>choose({runId:p.view.runId,kind:'market',accountId:'personal',entityId:research.state!.id,entityKind:'research'})):null}/>:null}
   {page==='ongoing'?<>{dueCustomers.length?<section><h3>已到期、尚未收取的原客户款</h3>{dueCustomers.map(customer=>{const number=p.features.relay!.customers.filter(original=>original.businessId===customer.businessId).findIndex(original=>original.id===customer.id)+1,identity=relayBusinessTarget(p,customer.businessId),target=identity?{...identity,kind:'customer' as const,customerId:customer.id}:null,next=target?openingFocusFor(p,'relay',{relayTarget:target,accountId:target.accountId}):null;return <article key={customer.id}><p>{p.features.relay!.businesses.length>1?'中转站'+customer.businessId.slice(-6)+' · ':null}原客户{number} · 已到期{moneyText(customer.dueReceivableFen)}，尚未实收；本入口不收款。</p>{next&&target?button('翻到这位原客户的到期款记录',()=>{setPage(null);onNavigate('relay',{accountId:target.accountId,relayTarget:target,recordId:customer.id,openRecord:true})}):<p className="warning-box">这位原客户的服务身份暂不可确认，请先从原服务记录重新选择；没有换到另一客户或账户。</p>}</article>})}</section>:null}<p>按原对象翻阅，不会重新付费或新增约定。</p>{continuing.length?<section><h3>仍在继续的事</h3><div className="today-ongoing">{continuing.map(item=><article key={JSON.stringify(item.focus)}><p className="opening-paper-date">{item.classification==='carry'?'从'+item.originQuarter+'留下，仍在继续':'本季原安排'}{item.wait?' · 下一反馈 '+item.wait.date:''}</p><h3>{item.title}</h3><p>{item.line}</p>{button(item.marketContinuation?.label??'回到这件原安排',()=>choose(item.focus))}</article>)}</div></section>:null}{holdings.length?<section><h3>保留的持仓</h3><p>这些股份仍在原账户；无需为了安排生活而卖出。</p><div className="today-ongoing">{holdings.map(item=><article key={JSON.stringify(item.focus)}><p className="opening-paper-date">{item.originQuarter?'来源 '+item.originQuarter:'原持仓'} · 截至{p.view.date}</p><h3>{item.title}</h3><p>{item.line}</p>{button('查看这份持仓',()=>choose(item.focus))}</article>)}</div></section>:null}</>:null}
  </Dialog>:null}
 </>}</MarketSceneChoice>}</CourseSceneChoice>}</VideoSceneChoice>
 return idleReading?<TodayIdleAction p={p} value={idleReading}>{render}</TodayIdleAction>:render(null)
}
