import {courseNeedsRecovery,courseTargetReason,courseStageLatestStart,type CourseSceneTarget,type CourseSceneContext} from './course-scene-progress.ts'
import {courseSceneDraftKey,emptyCourseSceneDraft,useCourseSceneDraft,type CourseSceneDraftScope,type CourseSceneDraft,type CourseDraftCase,type CourseSceneDraftSlot} from './course-scene-draft.ts'
import {useCourseTeachingDraft,type CourseTeachingDraft,type CourseTeachingDraftScope,type CourseTeachingDraftSlot} from './course-teaching-draft.ts'
import type {CourseProjection} from '../core/course-projection.ts'
import {agentSupportMode,supportModeText} from './AgentSupportChoice.tsx'
import {ResourceSelect} from './ResourceSelect.tsx'
import { useEffect,useRef,useState } from 'react';
import {BusinessLedger,WorkflowOverview} from './BusinessLedger.tsx';
import type { GamePanelProps } from './game-types.ts';
import { CommandButton } from './CommandButton.tsx';
import { moneyText, reasonText, lifecycleText } from './game-text.ts';
import { parseMoneyInput } from './money-input.ts';
import { addDays } from '../core/calendar.ts';
import {COURSE_JOBS} from '../content/course.ts'
import {revealBookTarget} from './ScreenBook.tsx';
const products: Record<string, string> = { intro_recorded: '入门录播 · 规模与基础目标', practical_cohort: '垂直实操班 · 案例与作业', enterprise_training: '企业内训 · 深交付与客户关系' };
const stateText: Record<string, string> = { draft: '待制作样课', building: '样课制作中', ready: '可安排教学', retired: '已停售', open: '报名中', teaching: '分阶段交付中', remedy: '需要补支持或退款', winding_down: '旧承诺收尾中', settling: '费用/退款待结清', closed: '班期已结清', pending: '待交付与反馈', helped: '学习目标已兑现', needs_recovery: '需要补交付', refunded: '已退款', partial: '已退未交付部分', planned: '已预留，尚未开始', running: '进行中', completed: '已实际完成', interrupted: '已中断', cancelled: '已取消' };
const blocked = (p: GamePanelProps) => p.view.busy || p.view.readOnly || p.view.hasCandidate || p.view.saveStatus === 'conflict';
const courseTargetKey=(target:CourseSceneTarget|null|undefined)=>target===undefined?'legacy':target===null?'entry':JSON.stringify(Object.fromEntries(Object.entries(target).sort(([a],[b])=>a.localeCompare(b))))
export const coursePanelContext=(runId:string,accountId:string,target?:CourseSceneTarget|null,initialFocusId?:string,slot?:CourseSceneDraftSlot,teachingSlot?:CourseTeachingDraftSlot)=>JSON.stringify([runId,accountId,courseTargetKey(target),initialFocusId??null,slot??null,teachingSlot??null])
export function courseTargetLocation(course:CourseProjection,target:CourseSceneTarget,context?:CourseSceneContext):{businessId:string;focusId:string}|null{
 if(courseTargetReason(course,target,context)!==null||!course)return null
 const business=course.businesses.find(b=>b.id===target.businessId)!
 return {businessId:business.id,focusId:target.kind==='outline'?target.outlineId:target.kind==='license'?target.licenseId:target.kind==='course'?target.sampleJobId??target.courseId+'-course':target.kind==='audience'?target.audienceId:target.kind==='cohort'?target.jobId??target.cohortId:business.id+(business.lifecycle==='preparing'?'-resources':'-define')}
}
export function courseDraftScopeForTarget(course:CourseProjection,target:CourseSceneTarget|null,accountId:string,requested?:CourseSceneDraftSlot,context?:CourseSceneContext):{scope:CourseSceneDraftScope|null;invalidReason:string|null;focusId?:string}{
 const bad=(invalidReason:string)=>({scope:null,invalidReason})
 if(!course)return bad('原课程准备当前不可核，请重新选择。')
 if(!target)return requested!==undefined&&requested!=='entry'||accountId!=='personal'?bad('原准备步骤不属于个人新教室入口，请明确重新选择。'):{scope:{accountId,businessId:null,courseId:null,slot:'entry'},invalidReason:null,focusId:'course-studio-entry'}
 const reason=courseTargetReason(course,target,context);if(reason)return bad(reason)
 const b=course.businesses.find(b=>b.id===target.businessId)!
 if(b.accountId!==accountId)return bad('原草稿与当前工作室账户不匹配，请重新选择。')
 if(target.kind==='audience'||target.kind==='cohort')return requested===undefined?{scope:null,invalidReason:null}:bad('这份记录属于班期经历，请明确选择教学步骤，没有借用原准备草稿。')
 const c=target.kind==='course'?course.courses.find(c=>c.id===target.courseId):undefined,l=target.kind==='license'?course.licenses.find(l=>l.id===target.licenseId):undefined,ref=l?course.cases.find(ref=>ref.id===l.caseId&&(ref.kind==='first_order'||ref.kind==='video')):undefined
 if(requested===undefined&&l&&!ref)return {scope:null,invalidReason:null}
 const slot=requested??(target.kind==='course'?'sample':l&&ref?`license:${ref.kind as CourseDraftCase['kind']}:${l.caseId}`:target.kind==='outline'||b.lifecycle==='preparing'?'outline':'definition')
 if(slot==='entry')return bad('这份原记录不是新教室入口，请明确重新选择准备步骤。')
 if(slot==='definition'&&target.kind!=='studio'||slot==='outline'&&!['studio','outline'].includes(target.kind)||slot==='sample'&&target.kind!=='course')return bad('原准备步骤与这份课程记录不一致，请明确重新选择。')
 if(requested!==undefined&&target.kind==='course'&&target.sampleJobId!==undefined&&target.sampleJobId!==c?.sampleJobId)return bad('较早的样课尝试只保留原记录，请明确选回当前课程后再安排。')
 if(slot.startsWith('license:')){
  const kind=slot.startsWith('license:first_order:')?'first_order':slot.startsWith('license:video:')?'video':null,id=kind?slot.slice(('license:'+kind+':').length):''
  const source=kind?course.cases.find(ref=>ref.kind===kind&&ref.id===id&&ref.licensed):undefined
  if(!source||!['studio','course','license'].includes(target.kind)||c&&!c.cases.some(ref=>ref.kind===kind&&ref.id===id)||l&&l.caseId!==id)return bad('这份许可草稿的案例不属于当前课程或已不可用，请明确重新选择。')
  return {scope:{accountId,businessId:b.id,courseId:null,slot},invalidReason:null,focusId:b.id+'-license-draft-'+kind+'-'+id}
 }
 if(!['outline','definition','sample'].includes(slot))return bad('原准备步骤无法核对，请明确重新选择。')
 return {scope:{accountId,businessId:b.id,courseId:slot==='sample'?c!.id:null,slot},invalidReason:null,focusId:b.id+(slot==='definition'?'-define':'-resources')}
}
export function courseTeachingScopeForTarget(course:CourseProjection,target:CourseSceneTarget|null,accountId:string,requested?:CourseTeachingDraftSlot,context?:CourseSceneContext):{scope:CourseTeachingDraftScope|null;invalidReason:string|null;focusId?:string}{
 const bad=(invalidReason:string)=>({scope:null,invalidReason})
 if(requested===undefined)return {scope:null,invalidReason:null}
 if(!course||!target)return bad('这一步需要明确的原课程或班期，请重新选择。')
 const reason=courseTargetReason(course,target,context);if(reason)return bad(reason)
 const business=course.businesses.find(b=>b.id===target.businessId)!
 if(business.accountId!==accountId)return bad('本次教学草稿与查看账户不匹配，请选回原账户。')
 if(!('courseId' in target))return bad('这份准备还没有对应课程，不能替你借用其他班期草稿。')
 const c=course.courses.find(c=>c.id===target.courseId&&c.businessId===target.businessId)!
 if(target.kind==='course'&&target.sampleJobId!==undefined&&target.sampleJobId!==c.sampleJobId)return bad('较早样课只保留原记录，请明确选回当前课程再作新安排。')
 const base={accountId,businessId:business.id,courseId:c.id}
 if(requested==='capital'||requested==='refresh')return {scope:{...base,audienceId:null,cohortId:null,slot:requested},invalidReason:null,focusId:c.id+'-'+requested}
 if(requested==='audience')return target.kind==='course'?{scope:{...base,audienceId:null,cohortId:null,slot:requested},invalidReason:null,focusId:c.id+'-audience'}:bad('新的获客需要明确翻选课程；原班期没有换成另一批意向者。')
 if(requested==='plan')return target.kind==='audience'?{scope:{...base,audienceId:target.audienceId,cohortId:null,slot:requested},invalidReason:null,focusId:target.audienceId+'-plan'}:bad('请明确选择这门课的原意向记录后再安排班期。')
 if(!['enroll','stage:0','stage:1','recovery','refund'].includes(requested))return bad('这项原教学步骤当前无法核对，请重新选择。')
 if(target.kind!=='cohort'||target.jobId!==undefined)return bad('请明确选回本班后再安排下一步；原任务没有替换为较新尝试。')
 const co=course.cohorts.find(co=>co.id===target.cohortId&&co.courseId===c.id)!
 return {scope:{...base,audienceId:co.audienceId,cohortId:co.id,slot:requested},invalidReason:null,focusId:co.id+'-'+requested.replace(':','-')}
}
export interface CourseRecordChoice{readonly id:string;readonly label:string;readonly target:CourseSceneTarget}
export function courseRecordChoices(course:CourseProjection,accountId:string,context?:CourseSceneContext):readonly CourseRecordChoice[]{
 if(!course)return []
 const choices:CourseRecordChoice[]=[]
 const add=(target:CourseSceneTarget,label:string)=>{if(courseTargetReason(course,target,context)!==null)return;const id=courseTargetKey(target);if(!choices.some(row=>row.id===id))choices.push({id,label,target})}
 for(const b of course.businesses.filter(b=>b.accountId===accountId)){
  add({kind:'studio',businessId:b.id},'原课程工作室 · '+(lifecycleText[b.lifecycle]??b.lifecycle))
  for(const outline of course.outlines.filter(o=>o.businessId===b.id))add({kind:'outline',businessId:b.id,outlineId:outline.id},'教学大纲 · '+(outline.job?outline.job.startAt+'—'+outline.job.completeAt:'原记录'))
  for(const license of course.licenses.filter(l=>l.businessId===b.id))add({kind:'license',businessId:b.id,licenseId:license.id},'原案例课程使用许可 · '+(license.job?license.job.startAt+'—'+license.job.completeAt:'原记录'))
  for(const c of course.courses.filter(c=>c.businessId===b.id)){
   add({kind:'course',businessId:b.id,courseId:c.id},c.name+' · '+(stateText[c.status]??c.status))
   for(const [index,jobId] of c.sampleAttempts.entries())add({kind:'course',businessId:b.id,courseId:c.id,sampleJobId:jobId},c.name+' · 原第'+(index+1)+'次样课任务')
   for(const a of course.audiences.filter(a=>a.courseId===c.id))add({kind:'audience',businessId:b.id,courseId:c.id,audienceId:a.id},c.name+' · '+(a.completedAt?'原实际意向':'原获客安排')+' · '+a.createdAt)
   for(const co of course.cohorts.filter(co=>co.courseId===c.id)){
    add({kind:'cohort',businessId:b.id,courseId:c.id,cohortId:co.id},c.name+' · '+co.startAt+'班 · '+(stateText[co.status]??co.status))
    const jobs=[...co.stageJobs.flat().filter(j=>j!==null),...co.supportJobs.flatMap(slot=>slot.job?[slot.job]:[])]
    for(const job of jobs)add({kind:'cohort',businessId:b.id,courseId:c.id,cohortId:co.id,jobId:job.id},c.name+' · '+co.startAt+'班原任务 · '+job.startAt+'—'+job.completeAt)
   }
  }
 }
 return choices
}
export interface CourseRecordSelection{readonly target:CourseSceneTarget|null|undefined;readonly draftId:string|null}
export function courseRecordSelection(course:CourseProjection,accountId:string,state:CourseRecordSelection,action:{type:'preview';id:string}|{type:'cancel'}|{type:'confirm'},context?:CourseSceneContext):CourseRecordSelection{
 if(action.type==='preview')return {...state,draftId:action.id}
 if(action.type==='cancel')return {...state,draftId:null}
 const choice=courseRecordChoices(course,accountId,context).find(row=>row.id===state.draftId)
 return choice?{target:choice.target,draftId:null}:state
}
function legacyCourseTarget(course:NonNullable<CourseProjection>,id:string):CourseSceneTarget|null{
 const business=course.businesses.find(b=>[b.id+'-define',b.id+'-resources'].includes(id));if(business)return {kind:'studio',businessId:business.id}
 const c=course.courses.find(c=>c.id+'-course'===id||c.id===id);if(c)return {kind:'course',businessId:c.businessId,courseId:c.id}
 const outline=course.outlines.find(o=>o.id===id||o.jobId===id);if(outline)return {kind:'outline',businessId:outline.businessId,outlineId:outline.id}
 const license=course.licenses.find(l=>l.id===id||l.jobId===id);if(license)return {kind:'license',businessId:license.businessId,licenseId:license.id}
 const sample=course.courses.find(c=>c.sampleAttempts.includes(id));if(sample)return {kind:'course',businessId:sample.businessId,courseId:sample.id,sampleJobId:id}
 const refreshed=course.courses.find(c=>c.refreshes.some(r=>r.job?.id===id&&r.job.businessId===c.businessId&&r.job.definitionId==='course-refresh-'+c.productId+'-'+c.topicId))
 if(refreshed)return {kind:'course',businessId:refreshed.businessId,courseId:refreshed.id}
 const study=course.studies.find(s=>s.job?.id===id&&s.job.businessId===s.businessId&&s.job.definitionId==='course-demand-study'),parent=study?course.courses.find(c=>c.id===study.predecessorId&&c.businessId===study.businessId):undefined
 if(parent)return {kind:'course',businessId:parent.businessId,courseId:parent.id}
 const audience=course.audiences.find(a=>a.id===id||a.jobId===id||a.id+'-plan'===id),audienceCourse=audience?course.courses.find(c=>c.id===audience.courseId):undefined
 if(audience&&audienceCourse)return {kind:'audience',businessId:audienceCourse.businessId,courseId:audienceCourse.id,audienceId:audience.id}
 const cohorts=course.cohorts.filter(co=>co.id===id||['enroll','stage-0','stage-1','recovery','refund'].some(step=>co.id+'-'+step===id)||co.students.some(s=>s.id===id)||course.refunds.some(r=>r.cohortId===co.id&&r.id===id)||co.stageJobs.flat().some(j=>j?.id===id)||co.supportJobs.some(slot=>slot.jobId===id))
 if(cohorts.length!==1)return null
 const co=cohorts[0]!,lesson=course.courses.find(c=>c.id===co.courseId);if(!lesson)return null
 const job=co.stageJobs.flat().some(j=>j?.id===id)||co.supportJobs.some(slot=>slot.jobId===id)
 return {kind:'cohort',businessId:lesson.businessId,courseId:lesson.id,cohortId:co.id,...(job?{jobId:id}:{})}
}
function sameCourseRecordContext(target:CourseSceneTarget,record:CourseSceneTarget):boolean{
 if(target.businessId!==record.businessId)return false
 if(target.kind==='studio')return true
 if(target.kind==='outline')return record.kind==='outline'&&record.outlineId===target.outlineId
 if(target.kind==='license')return record.kind==='license'&&record.licenseId===target.licenseId
 if(target.kind==='audience')return record.kind==='audience'?record.audienceId===target.audienceId:record.kind==='course'&&record.courseId===target.courseId&&record.sampleJobId===undefined
 if(target.kind==='cohort')return record.kind==='cohort'?record.cohortId===target.cohortId&&(target.jobId===undefined||record.jobId===undefined||record.jobId===target.jobId):record.kind==='course'&&record.courseId===target.courseId&&record.sampleJobId===undefined
 return 'courseId' in record&&record.courseId===target.courseId&&(target.sampleJobId===undefined||record.kind==='course'&&(record.sampleJobId===undefined||record.sampleJobId===target.sampleJobId))
}
export type CoursePanelProps=GamePanelProps&{initialFocusId?:string;initialTarget?:CourseSceneTarget|null;initialDraftSlot?:CourseSceneDraftSlot;initialTeachingSlot?:CourseTeachingDraftSlot;onTargetChange?:(target:CourseSceneTarget|null)=>void}
export function CoursePanel(props:CoursePanelProps){return <CoursePanelScope key={coursePanelContext(props.view.runId,props.accountId,props.initialTarget,props.initialFocusId,props.initialDraftSlot,props.initialTeachingSlot)} {...props}/>}
function CoursePanelScope(props:CoursePanelProps){
 const v=props.features.course,[selection,setSelection]=useState<CourseRecordSelection>({target:props.initialTarget,draftId:null}),panel=useRef<HTMLDivElement>(null),focus=useRef<HTMLAnchorElement>(null),located=useRef<string|null>(null)
 const [draftSlot,setDraftSlot]=useState<CourseSceneDraftSlot|undefined>(props.initialDraftSlot)
 const [teachingSlot,setTeachingSlot]=useState<CourseTeachingDraftSlot|undefined>(props.initialTeachingSlot)
 const [entry,setEntry]=useCourseSceneDraft(props.view.runId,{accountId:'personal',businessId:null,courseId:null,slot:'entry'},props.courseDraftMemory,{...emptyCourseSceneDraft(),capital:props.initialTarget===undefined?'20000':''})
 const context:CourseSceneContext={operations:props.view.operations},legacy=selection.target===undefined,legacyFocus=legacy&&v&&props.initialFocusId?legacyCourseTarget(v,props.initialFocusId):null,defaultBusiness=legacy?v?.businesses.find(b=>b.lifecycle!=='closed'):undefined
 const target=selection.target===undefined?legacyFocus??(defaultBusiness?{kind:'studio' as const,businessId:defaultBusiness.id}:null):selection.target,business=target&&v?v.businesses.find(b=>b.id===target.businessId):undefined
 const originalRecord=props.initialFocusId&&v?legacyCourseTarget(v,props.initialFocusId):null,recordReason=!legacy&&props.initialFocusId&&(!target||!originalRecord||!sameCourseRecordContext(target,originalRecord))?'原记录与这次课程或班期目标不匹配，请明确重新选择；没有翻到别的记录。':null
 const draftContext=courseDraftScopeForTarget(v,target,legacy&&business?business.accountId:props.accountId,draftSlot,context)
 const teachingContext=courseTeachingScopeForTarget(v,target,legacy&&business?business.accountId:props.accountId,teachingSlot,context)
 const invalid=(!props.view.accounts.some(a=>a.accountId===props.accountId)?'原账户已不可用，请在原册上方重新选择账户。':legacy&&props.initialFocusId&&!legacyFocus?'原课程记录已不可达，没有替换为另一份准备。':target?courseTargetReason(v,target,context)??(!legacy&&business?.accountId!==props.accountId?'原课程与当前查看账户不匹配，请明确选回原账户。':business&&!props.view.accounts.some(a=>a.accountId===business.accountId)?'原工作室账户已不可达，请重新选择。':null):!legacy&&props.accountId!=='personal'?'准备新工作室须明确查看个人账户；没有替你换主体。':null)??recordReason??(draftSlot&&teachingSlot?'请明确选择一个原准备或教学步骤，没有把两份草稿混在一起。':null)??draftContext.invalidReason??teachingContext.invalidReason
 const location=target&&!invalid?courseTargetLocation(v,target,context):null,choices=courseRecordChoices(v,props.accountId,context),picked=choices.find(c=>c.id===selection.draftId),locked=props.view.busy||props.controller.snapshot.busy||props.view.hasCandidate||props.view.saveStatus==='conflict'
 const choose=(next:CourseSceneTarget|null)=>{if(locked)return;setSelection({target:next,draftId:null});setDraftSlot(undefined);setTeachingSlot(undefined);props.onTargetChange?.(next)}
 const confirm=()=>{if(locked)return;const next=courseRecordSelection(v,props.accountId,selection,{type:'confirm'},context);if(next!==selection){setSelection(next);setDraftSlot(undefined);setTeachingSlot(undefined);props.onTargetChange?.(next.target??null)}}
 const targetContext=coursePanelContext(props.view.runId,props.accountId,target,undefined,draftSlot,teachingSlot),focusId=teachingSlot?teachingContext.focusId:draftSlot?draftContext.focusId:props.initialFocusId??location?.focusId
 useEffect(()=>{if(!focusId||invalid||!panel.current||!focus.current||located.current===targetContext)return;const node=document.getElementById(focusId);if(node&&panel.current.contains(node)){located.current=targetContext;revealBookTarget(focus.current,focusId)}},[targetContext,focusId,invalid])
 if(!v)return <p>当前存档没有课程经营。</p>
 const picker=<fieldset><legend>选择当前账户已经公开的工作室、课程或原任务</legend>{choices.map(choice=><label className="radio-line" key={choice.id}><input type="radio" name={'course-record-'+props.view.runId} checked={selection.draftId===choice.id} onChange={()=>setSelection(current=>courseRecordSelection(v,props.accountId,current,{type:'preview',id:choice.id},context))}/>{choice.label}</label>)}{!choices.length?<p>当前账户没有匹配记录，请先在原册上方选回原账户。</p>:null}<div className="button-row"><button type="button" onClick={()=>setSelection(current=>courseRecordSelection(v,props.accountId,current,{type:'cancel'},context))}>取消这次重选</button><button type="button" disabled={!picked||locked} onClick={confirm}>明确选回这份记录</button></div><p>预看和取消不执行命令，也不替你换对象。</p></fieldset>
 if(invalid)return <section className="warning-box" role="status"><h2>先找回原来的课程准备。</h2><p>{invalid}</p>{picker}</section>
 const oldSample=target?.kind==='course'&&target.sampleJobId&&v.courses.find(c=>c.id===target.courseId)?.sampleJobId!==target.sampleJobId?props.view.operations?.jobs.find(j=>j.id===target.sampleJobId):null
 if(oldSample&&target?.kind==='course')return <div ref={panel} className="stack-lg course-workspace"><h2>这一次原样课任务仍在。</h2><section id={oldSample.id} className="panel"><h3>{v.courses.find(c=>c.id===target.courseId)?.name} · 原样课任务</h3><p>{stateText[oldSample.status]} · {oldSample.startAt}—{oldSample.completeAt}</p><p>没有换成后来的一次样课。实际成本、预留与课程资格仍以原账和当前记录分别核对。</p><button type="button" disabled={locked} onClick={()=>choose({kind:'course',businessId:target.businessId,courseId:target.courseId})}>明确翻看这门课当前的准备</button></section>{picker}</div>
 const oldLicense=target?.kind==='license'?v.licenses.find(l=>l.id===target.licenseId):undefined
 if(oldLicense&&!v.cases.some(ref=>ref.id===oldLicense.caseId&&(ref.kind==='first_order'||ref.kind==='video')))return <div className="stack-lg course-workspace"><section className="panel" id={oldLicense.id}><h2>原课程素材许可记录仍在。</h2><p>{oldLicense.job?stateText[oldLicense.job.status]+' · '+oldLicense.job.startAt+'—'+oldLicense.job.completeAt:'原任务当前不可核，请重新选择。'}</p><p>对应案例当前不可用于新的课程准备；没有替换案例或混用另一份资源草稿。</p><button type="button" disabled={locked} onClick={()=>choose({kind:'studio',businessId:oldLicense.businessId})}>明确翻看这间工作室的其他准备</button></section>{picker}</div>
 return <div ref={panel} className="stack-lg route-workspace course-workspace"><div className="route-introduction"><p className="eyebrow">知识产品与履约 · 本局虚构模拟</p><h2>课程与学员</h2><p>真实案例、工具资格和样课先到位，再决定价格、班额与答疑。预售收款全额受保护，实际教学阶段完成后才确认收入。</p><details className="route-boundaries"><summary>课程权利、维护与本局模拟边界</summary><p className="field-help">不接现实招生或支付。维护修订免费惠及原承诺学员，同一知识产品不能向同一人重复收费；新进阶产品须另有需求研究和交付。</p></details></div>
 {focusId?<a ref={focus} className="scene-text-action" href={'#'+encodeURIComponent(focusId)}>翻到这次准备的案例与课程方案 ↗</a>:null}
 {business?<><details><summary>明确选择另一份原记录</summary>{picker}</details>{business.lifecycle==='closed'?<fieldset disabled><legend>已收尾工作室的原记录</legend><CourseBusiness key={business.id} {...props} businessId={business.id} target={target??undefined} draftScope={draftContext.scope??undefined} legacyInitial={legacy}/></fieldset>:<CourseBusiness key={business.id} {...props} businessId={business.id} target={target??undefined} draftScope={draftContext.scope??undefined} legacyInitial={legacy}/>}</>:<section className="panel" id="course-studio-entry"><h3>准备课程工作室</h3><label className="field">个人投入的自有资金（元）<input inputMode="decimal" value={entry.capital} onChange={e=>setEntry(previous=>({...previous,capital:e.target.value}))}/></label><p>公司账户独立记账，至少2000元启动。资金转移不是费用或收入；每月100元维护按实际日期发生。课程从2022-11-30公开工具节点后准备，具体使用工具仍需本局访问资格。</p><CommandButton {...props} kind="OpenCourseStudio" payload={{capitalFen:parseMoneyInput(entry.capital)??0}} label="以自有资金准备课程工作室" confirm primary/>{picker}</section>}<CourseArchive {...props}/></div>
}
function CourseArchive(props:GamePanelProps){const v=props.features.course!,closed=v.businesses.filter(b=>b.lifecycle==='closed');return closed.length?<details className="panel business-archive"><summary>已收尾课程企业的历史（{closed.length}）</summary>{closed.map(b=><article key={b.id}><h3>{b.company?'课程企业':'课程分账'} · {b.id.slice(-6)}</h3><p>原业务累计确认收入{moneyText(b.metrics.incomeFen)}，累计成本{moneyText(b.metrics.costFen)}；这是历史账目，不是本季新增回款。</p>{v.cohorts.filter(co=>v.courses.some(c=>c.id===co.courseId&&c.businessId===b.id)).map(co=><p key={co.id}>{co.startAt}班期 · {stateText[co.status]} · 原学员{co.students.length}人 · 支持约定{co.supportCompleteAt}。</p>)}</article>)}</details>:null}

function CourseBusiness(props: GamePanelProps & {
    businessId: string;
    target?:CourseSceneTarget|undefined;
    draftScope?:CourseSceneDraftScope|undefined;
    legacyInitial?:boolean;
}) {
    const { view, features, request } = props, v = features.course!, b = v.businesses.find(b => b.id === props.businessId)!;
    const definitionScope:CourseSceneDraftScope={accountId:b.accountId,businessId:b.id,courseId:null,slot:'definition'},legacy=props.legacyInitial;
    const initial:CourseSceneDraft=legacy?{...emptyCourseSceneDraft(),name:'从真实案例开始的图像工具课',productId:'practical_cohort',topicId:'image_workflows',segment:'ai_learners',resources:['player-production'],startAt:view.date}:emptyCourseSceneDraft();
    const [definition,setDefinition]=useCourseSceneDraft(view.runId,definitionScope,props.courseDraftMemory,initial),target=props.target;
    const license=target?.kind==='license'?v.licenses.find(l=>l.id===target.licenseId):undefined,licenseCase=license?v.cases.find(ref=>ref.id===license.caseId):undefined,licenseKind=licenseCase?.kind==='first_order'||licenseCase?.kind==='video'?licenseCase.kind:null;
    const taskScope:CourseSceneDraftScope=props.draftScope??{accountId:b.accountId,businessId:b.id,courseId:target?.kind==='course'?target.courseId:null,slot:target?.kind==='course'?'sample':license&&licenseKind?`license:${licenseKind}:${license.caseId}`:target?.kind==='outline'||b.lifecycle==='preparing'?'outline':'definition'};
    const [task,setTask]=useCourseSceneDraft(view.runId,taskScope,props.courseDraftMemory,initial),sameDefinition=courseSceneDraftKey(view.runId,definitionScope)===courseSceneDraftKey(view.runId,taskScope),assignmentDraft=sameDefinition?definition:task,setAssignment=sameDefinition?setDefinition:setTask;
    const resource=assignmentDraft.resources[0]??'',startAt=assignmentDraft.startAt,setResource=(value:string)=>setAssignment(previous=>({...previous,resources:value?[value]:[]})),setDate=(date:{at:string;value:string})=>setAssignment(previous=>({...previous,startAt:date.value}));
    const {name,productId,topicId,segment,consent}=definition,selectedCases=definition.cases.map(ref=>ref.kind+'|'+ref.id),setName=(name:string)=>setDefinition(previous=>({...previous,name})),setProduct=(productId:string)=>setDefinition(previous=>({...previous,productId})),setTopic=(topicId:string)=>setDefinition(previous=>({...previous,topicId})),setSegment=(segment:string)=>setDefinition(previous=>({...previous,segment})),setConsent=(consent:boolean)=>setDefinition(previous=>({...previous,consent}));
    const assignment = { resources: resource?[resource]:[], startAt }, courses = v.courses.filter(c => c.businessId === b.id), advance = (date: string) => request('AdvanceTime', { date }, '推进到课程实际反馈'), pause = features.workbench.pause !== null;
    const toggleCase=(ref:NonNullable<CourseProjection>['cases'][number],checked:boolean)=>{const kind=ref.kind;if(kind!=='first_order'&&kind!=='video')return;const selected:CourseDraftCase={kind,id:ref.id};setDefinition(previous=>({...previous,cases:checked?(previous.cases.some(old=>old.kind===kind&&old.id===ref.id)?previous.cases:[...previous.cases,selected]):previous.cases.filter(old=>old.kind!==kind||old.id!==ref.id)}))};
    const licenseRequest=(ref:NonNullable<CourseProjection>['cases'][number]):GamePanelProps['request']=>{const kind=ref.kind;if(kind!=='first_order'&&kind!=='video')return request;return(command,payload,label,confirm)=>{const scope:CourseSceneDraftScope={accountId:b.accountId,businessId:b.id,courseId:null,slot:`license:${kind}:${ref.id}`},previous=props.courseDraftMemory?.read(view.runId,scope)??emptyCourseSceneDraft();props.courseDraftMemory?.write(view.runId,scope,{...previous,resources:[...assignment.resources],startAt});request(command,payload,label,confirm)}};
    const renderJob = (job: typeof view.operations extends null ? never : NonNullable<typeof view.operations>['jobs'][number] | null | undefined) => job ? <div id={job.id}><p>{stateText[job.status]} · {job.startAt}—{job.completeAt}；{job.resources.map(id => v.resources.find(r => r.id === id)?.label ?? '已离岗员工').join('、')}</p>{['planned', 'running'].includes(job.status) ? <div className="button-row"><button type="button" disabled={blocked(props) || pause} onClick={() => advance(job.completeAt)}>推进到这项课程任务完成</button><CommandButton {...props} kind="InterruptJob" payload={{ jobId: job.id }} label="停止这项任务，保留已耗成本与旧义务" confirm/></div> : null}</div> : null;
    return <><WorkflowOverview label="课程经营进展" items={[{label:'案例与样课',value:courses.length+'个已定义课程',target:b.id+'-define'},{label:'教学与支持',value:v.cohorts.filter(co=>courses.some(c=>c.id===co.courseId)&&co.closedAt===null).length+'个未收尾班期',target:b.id+'-cohorts'},{label:'任务资源',value:v.resources.find(r=>r.id===resource)?.label??'需重新核对资源',target:b.id+'-resources'}]}/>
 {courses.flatMap(c=>c.unresolvedUpdates.map(u=>({course:c,update:u}))).map(({course,update})=><aside className="warning-box" key={update.id}><strong>工具变化需要处理 · {update.dueAt}期限</strong><p>{course.name}仍有原学员与更新承诺，新招生条件需重验。</p><a href={'#'+encodeURIComponent(course.id+'-course')}>处理此课程的更新与旧承诺 →</a></aside>)}
<BusinessLedger title={b.company?'课程企业账户':'课程个人经营分账'} status={lifecycleText[b.lifecycle]??b.lifecycle} funds={b.funds} open={b.lifecycle==='preparing'}><div className="section-heading"><h3>{b.company ? '课程企业账户' : '课程个人经营分账'}</h3><span className="tag">{lifecycleText[b.lifecycle]}</span></div><dl className="finance-grid"><div><dt>本主体可花</dt><dd>{moneyText(b.funds.availableFen)}</dd></div><div><dt>现金 / 保护及预留</dt><dd>{moneyText(b.funds.cashFen)} / {moneyText(b.funds.heldFen)}</dd></div><div><dt>尚未履约</dt><dd>{moneyText(b.funds.prepaidLiabilityFen)}</dd></div><div><dt>未结应付</dt><dd>{moneyText(b.funds.payableFen)}</dd></div><div><dt>本业务确认收入</dt><dd>{moneyText(b.metrics.incomeFen)}</dd></div><div><dt>本业务已发生成本 / 利润</dt><dd>{moneyText(b.metrics.costFen)} / {moneyText(b.metrics.profitFen)}</dd></div></dl>{b.funds.protectionShortfallFen > 0 || b.funds.commitmentShortfallFen > 0 ? <p role="alert" className="error-box">资金保护/承诺存在真实缺口，请翻开日历处理这笔欠款。</p> : null}<p>个人资金与公司资金分别管理。利润不等于现在可花，未来学费不支持当期制作。</p>{b.company ? <CourseFunding p={props} businessId={b.id} {...(target&&'courseId' in target?{courseId:target.courseId}:{})}/> : null}<div className="button-row">{b.lifecycle === 'preparing' ? <CommandButton {...props} kind="ActivateBusiness" payload={{ businessId: b.id }} label="核对大纲、产能与资金后启用工作室"/> : b.lifecycle === 'operating' ? <CommandButton {...props} kind="PauseBusiness" payload={{ businessId: b.id }} label="暂停企业接新业务"/> : b.lifecycle === 'paused' ? <CommandButton {...props} kind="ResumeBusiness" payload={{ businessId: b.id }} label="恢复企业接新业务"/> : null}{!['winding_down', 'closed'].includes(b.lifecycle) ? <CommandButton {...props} kind="WindDownBusiness" payload={{ businessId: b.id }} label="停止经营并处理旧班期" confirm/> : b.lifecycle === 'winding_down' ? <CommandButton {...props} kind="CloseBusiness" payload={{ businessId: b.id }} label="核对全部旧义务后关闭企业" confirm/> : null}</div></BusinessLedger>
 <details className="panel" id={b.id+'-resources'} open={b.lifecycle==='preparing'}><summary>本次任务资源 · {v.resources.find(r=>r.id===resource)?.label??'需重新核对'} / {startAt}</summary><h3>本次实际资源与开工日</h3><div className="form-grid"><label className="field">课程制作/授课资源<ResourceSelect options={v.resources} value={resource} onChange={setResource}/></label><label className="field">本次任务开工日期<input type="date" min={view.date} max={view.phase==='epilogue'?view.date:'2025-12-31'} readOnly={view.phase==='epilogue'} value={startAt} onChange={e => setDate({ at: view.date, value: e.target.value })} onBlur={e => setDate({ at: view.date, value: e.currentTarget.value })}/></label></div><p className="field-help">同一资源不能同时用于视频、教学或答疑。未来计划真实预留对应季度注意力和自有资金，开始不等于完成。</p>{!startAt?<p className="warning-box">请明确选择开工日期；没有替你填入今天。</p>:startAt<view.date?<p className="warning-box">草稿开工日{startAt}已经过去，请重新选择；没有替你挪到今天。</p>:null}{resource&&!v.resources.some(r=>r.id===resource)?<p className="warning-box">原制作资源已不可用，请明确重选。</p>:null}{b.lifecycle === 'preparing' ? <CommandButton {...props} kind="StartCourseOutline" payload={{ businessId: b.id, ...assignment }} label="补齐教学大纲与营业准备 · 1点/100元/7天"/> : null}{v.outlines.filter(o => o.businessId === b.id).map(o => <div key={o.id} id={o.id}>{renderJob(o.job)}</div>)}<details><summary>需要更多产能：真实招聘与结算</summary><p>招聘占1点及500元。周助理月薪2500元、林剪辑员月薪3000元，按实际在岗日计薪；公司工资另计，不能当免费答疑。</p><CommandButton {...props} kind="HireWorker" payload={{ businessId: b.id, definitionId: 'assistant-zhou' }} label="招聘周助理"/><CommandButton {...props} kind="HireWorker" payload={{ businessId: b.id, definitionId: 'editor-lin' }} label="招聘林剪辑员"/>{view.operations?.workers.filter(w => w.to === null).map(w => <CommandButton key={w.id} {...props} kind="DismissWorker" payload={{ workerId: w.id }} label={`结算并解聘${w.definitionId}`} confirm/>)}</details></details>
<section id={b.id+'-cohorts'} className="stack"><h3>当前班期与已承诺交付</h3>{v.cohorts.filter(co=>courses.some(c=>c.id===co.courseId)&&co.closedAt===null).map(co=><CourseClass key={co.id} {...props} cohortId={co.id}/>)}{v.cohorts.some(co=>courses.some(c=>c.id===co.courseId)&&co.closedAt!==null)?<details className="panel"><summary>已经结清的班期记录</summary>{v.cohorts.filter(co=>courses.some(c=>c.id===co.courseId)&&co.closedAt!==null).map(co=><CourseClass key={co.id} {...props} cohortId={co.id}/>)}</details>:null}</section>
 {courses.map(c => <section id={c.id+'-course'} key={c.id} className="panel stack"><div className="section-heading"><h3>{c.name}</h3><span className="tag">{stateText[c.status]} · 教学修订{c.versions.at(-1)?.revision ?? 0}</span></div><p>{products[c.productId]} · {v.catalog.topics.find(t => t.id === c.topicId)?.label} · {c.edition === 'advanced' ? '有新需求的进阶产品' : '基础知识产品'}</p>{c.qualificationReasons.map((r, n) => <p className="reason" key={r + n}>{reasonText(r)}</p>)}{c.status === 'draft' || c.status === 'building' ? <><p>样课制作占1点，入门2000元/14天、实操2500元/14天、内训3500元/21天；这是自有资金投入。</p><CommandButton {...props} kind="BuildCourseSample" payload={{ courseId: c.id, ...assignment }} label="制作实际样课与案例说明"/>{renderJob(c.job)}</> : null}
 {c.status!=='draft'&&c.status!=='building'&&c.job?<details><summary>原样课任务记录</summary>{renderJob(c.job)}</details>:null}
 {c.unresolvedUpdates.map(u => <div key={u.id} className="warning-box"><h4>工具变化 {u.anchorId} · {u.occurredAt}</h4><p>建议{u.dueAt}前完成七天更新；不处理会停新招，已有学生的更新、答疑和退款承诺仍保留。</p><CommandButton {...props} kind="PauseNewEnrollment" payload={{ courseId: c.id }} label="停止新招生，保留旧承诺"/></div>)}{c.refreshes.map(r => <div key={r.jobId}>{renderJob(r.job)}</div>)}
 <div className="button-row">{c.status === 'ready' ? <>{c.paused ? <CommandButton {...props} kind="ResumeCourseEnrollment" payload={{ courseId: c.id }} label="重新核对条件后恢复招生"/> : <CommandButton {...props} kind="StopCourseSales" payload={{ courseId: c.id }} label="停售新班，继续旧班履约"/>}</> : null}{c.status !== 'retired' ? <CommandButton {...props} kind="RetireCourse" payload={{ courseId: c.id }} label="归档课程并保留旧学生责任" confirm/> : null}</div>
 {c.unresolvedUpdates.length||c.status==='ready'?<CourseRefresh p={props} c={c}/>:null}
 {c.status === 'ready' ? <CourseIntake key={c.id} {...props} courseId={c.id}/> : null}
 <details><summary>新进阶产品：先验证毕业后的新需求</summary><p>当前已完成本知识产品且无退款的毕业学员{c.graduateCount}人。教学维护不产生复购资格；真实新需求研究还占1点/600元/7天，之后必须另制作进阶样课和交付。</p><CommandButton {...props} kind="StudyAdvancedCourseDemand" payload={{ courseId: c.id, ...assignment }} label="研究毕业学员的新需求"/>{v.studies.filter(s => s.predecessorId === c.id).map(st => <div key={st.id}>{renderJob(st.job)}{st.completedAt ? <><p>实际新需求{st.members.length}人</p><CommandButton {...props} kind="DefineCourse" payload={{ businessId: b.id, name: c.name + ' · 进阶', productId: c.productId, topicId: c.topicId, edition: 'advanced', segment: c.segment, cases: c.cases, consent: true, predecessorId: c.id, studyId: st.id }} label="按新需求建立进阶课程方案" confirm/></> : null}</div>)}</details></section>)}
 <details className="panel" id={b.id+'-define'} open={courses.length === 0 && b.lifecycle === 'operating'}><summary>用已付案例定义一门新课</summary><label className="field">课程名称<input value={name} maxLength={80} onChange={e => setName(e.target.value)}/></label><label className="field">课程形式<select value={productId} onChange={e => setProduct(e.target.value)}>{!Object.hasOwn(products,productId)?<option value={productId} disabled>{productId?'原形式不可用，请重选':'请选择课程形式'}</option>:null}{Object.entries(products).map(([id, label]) => <option key={id} value={id}>{label}</option>)}</select></label><label className="field">真实工具主题<select value={topicId} onChange={e => setTopic(e.target.value)}>{!v.catalog.topics.some(topic=>topic.id===topicId)?<option value={topicId} disabled>{topicId?'原主题不可用，请重选':'请选择工具主题'}</option>:null}{v.catalog.topics.map(t => <option key={t.id} value={t.id}>{t.label}</option>)}</select></label><label className="field">目标人群<select value={segment} onChange={e => setSegment(e.target.value)}>{!['ai_learners','local_merchants','lifestyle'].includes(segment)?<option value={segment} disabled>{segment?'原人群不可用，请重选':'请选择目标人群'}</option>:null}<option value="ai_learners">AI学习者</option><option value="local_merchants">本地商家</option><option value="lifestyle">生活方式受众</option></select></label><p>至少一项已付案例，企业内训至少两项。手工小单经验需要另做本局AI样课，不能当作此前已经使用AI的证明。</p>{definition.cases.some(ref=>!v.cases.some(c=>c.kind===ref.kind&&c.id===ref.id))?<div className="warning-box"><p>之前选择的案例当前已不可用，请重新核对；没有替换为另一项经验。</p><button type="button" onClick={()=>setDefinition(previous=>({...previous,cases:previous.cases.filter(ref=>v.cases.some(c=>c.kind===ref.kind&&c.id===ref.id))}))}>明确清除不可用案例的选择</button></div>:null}{v.cases.length === 0 ? <p className="warning-box">尚无已付案例。请先完成手工第一单或视频商单验收、收款与费用。</p> : v.cases.map(ref => { const key = ref.kind + '|' + ref.id; return <div key={key} id={b.id+'-license-draft-'+ref.kind+'-'+ref.id}><label className="radio-line"><input type="checkbox" checked={selectedCases.includes(key)} onChange={e=>toggleCase(ref,e.target.checked)}/>{ref.label} · {ref.id.slice(-6)}</label>{ref.licensed ? <><p>本单授权素材须另取得课程使用范围，不能直接复用。</p>{taskScope.slot==='license:'+ref.kind+':'+ref.id?<p>当前这份许可草稿：{v.resources.find(r=>r.id===resource)?.label??'请重新选择资源'} · {startAt||'尚未选择开工日'}。</p>:null}<CommandButton {...props} request={licenseRequest(ref)} kind="LicenseCourseMaterials" payload={{ businessId: b.id, caseKind: ref.kind, caseId: ref.id, ...assignment }} label="安排课程素材使用范围 · 1点/300元/7天"/></> : null}</div>; })}<p className="field-help">已明确选择{definition.cases.length}份案例；最多三份，超出时请自己决定保留哪些。</p>{definition.cases.length>3?<p className="warning-box">目前选择超过三份，原选择仍全部保留；请取消多余选择后再定义课程。</p>:null}<label className="radio-line"><input type="checkbox" checked={consent} onChange={e => setConsent(e.target.checked)}/>只使用有权使用的案例与匿名化说明，不编造客户或教学资历</label>{consent&&definition.cases.length<=3 ? <CommandButton {...props} kind="DefineCourse" payload={{ businessId: b.id, name, productId, topicId, edition: 'foundation', segment, cases: definition.cases.map(ref=>({...ref})), consent }} label="建立课程方案，尚不招生" confirm/> : <p className="field-help">先核对案例与使用范围。</p>}</details>
 {v.licenses.filter(l => l.businessId === b.id).map(l => <section className="panel" key={l.id} id={l.id}><h4>课程素材授权任务</h4>{renderJob(l.job)}</section>)}
</>;
}
type TeachingSetter=ReturnType<typeof useCourseTeachingDraft>[1]
type Lesson=NonNullable<CourseProjection>['courses'][number]
type ClassRecord=NonNullable<CourseProjection>['cohorts'][number]
function teachingScope(p:GamePanelProps,c:Lesson,slot:CourseTeachingDraftSlot,co?:ClassRecord):CourseTeachingDraftScope{
 const business=p.features.course!.businesses.find(b=>b.id===c.businessId)!
 return {accountId:business.accountId,businessId:c.businessId,courseId:c.id,audienceId:co?.audienceId??null,cohortId:co?.id??null,slot}
}
function TeachingSchedule({p,draft,setDraft,min=p.view.date,max=p.view.phase==='epilogue'?p.view.date:'2025-12-31'}:{p:GamePanelProps;draft:CourseTeachingDraft;setDraft:TeachingSetter;min?:string;max?:string}){
 const resources=p.features.course!.resources,selected=draft.resources.length===1?draft.resources[0]??'':''
 return <div className="form-grid"><label className="field">这次实际使用的资源<ResourceSelect options={resources} value={selected} onChange={id=>setDraft(previous=>({...previous,resources:id?[id]:[]}))}/></label><label className="field">这次开工日期<input type="date" min={min} max={max} value={draft.startAt} onChange={e=>setDraft(previous=>({...previous,startAt:e.target.value}))}/></label>{!draft.startAt?<p className="field-help">请明确选择日期，没有替你填入今天。</p>:draft.startAt<min||draft.startAt>max?<p className="warning-box">原草稿日期{draft.startAt}已不在当前可安排范围，请重新选择；没有挪动原日期。</p>:null}{!draft.resources.length?<p className="field-help">请明确选择实际资源。</p>:draft.resources.some(id=>!resources.some(r=>r.id===id))?<p className="warning-box">原资源现在不可用，请明确重选。</p>:null}{draft.resources.length>1?<p className="field-help">草稿保留{draft.resources.length}项原资源；在此重新选择会替换整组，原确认仍核对全部资源。</p>:null}</div>
}
function TeachingSupportFields({p,businessId,draft,setDraft}:{p:GamePanelProps;businessId:string;draft:CourseTeachingDraft;setDraft:TeachingSetter}){
 const modes=['guided_group','self_small','assisted_group','delegated_group'],deployments=p.features.story.deployments.filter(d=>d.businessId===businessId&&d.lifecycle==='active'&&d.currentGrant?.scopes.includes('course_support')),available=deployments.filter(d=>draft.supportMode!=='delegated_group'||d.currentGrant?.level==='cross_flow'),selected=available.find(d=>d.id===draft.deploymentId)
 return <><label className="field">明确选择支持方式<select value={draft.supportMode} onChange={e=>setDraft(previous=>({...previous,supportMode:e.target.value,deploymentId:null}))}><option value="">请选择支持方式</option>{draft.supportMode&&!modes.includes(draft.supportMode)?<option value={draft.supportMode} disabled>原支持方式不可用，请重选</option>:null}<option value="guided_group">集中支持 · 原费用、行动与日期</option><option value="self_small">限额自答疑 · 更多行动与日期，较小容量</option><option value="assisted_group" disabled={!deployments.length}>衡星辅助 · 1500元/1点/4日</option><option value="delegated_group" disabled={!deployments.some(d=>d.currentGrant?.level==='cross_flow')}>衡星跨流程委托 · 1000元/1点/2日</option></select></label>{agentSupportMode(draft.supportMode)?<><label className="field">明确选择本主体原部署<select value={draft.deploymentId??''} onChange={e=>setDraft(previous=>({...previous,deploymentId:e.target.value||null}))}><option value="">请选择已有权限，不自动扩权</option>{draft.deploymentId&&!selected?<option value={draft.deploymentId} disabled>原部署当前不可用，请重新选择</option>:null}{available.map(d=><option key={d.id} value={d.id}>{d.id.slice(-6)} · {d.currentGrant?.level} · 至{d.currentGrant?.expiresAt}</option>)}</select></label>{selected?.currentGrant?<p className="field-help">原权限剩余额度{moneyText(selected.currentGrant.cashLimitFen-selected.currentGrant.committedFen)}；实际支持日期、部署费用与全部预留仍按原确认检查。</p>:<p className="warning-box">尚无匹配的明确部署；手动支持仍可选择，准备与扩权须另行决定。</p>}</>:null}</>
}
function CourseFunding({p,businessId,courseId}:{p:GamePanelProps;businessId:string;courseId?:string}){
 return courseId?<CourseCapital p={p} businessId={businessId} courseId={courseId}/>:<LegacyCapital p={p} businessId={businessId}/>
}
function LegacyCapital({p,businessId}:{p:GamePanelProps;businessId:string}){
 const [capital,setCapital]=useState('')
 return <div className="button-row"><label className="field">从个人追加自有资金（元）<input inputMode="decimal" value={capital} onChange={e=>setCapital(e.target.value)}/></label><CommandButton {...p} kind="FundBusiness" payload={{businessId,amountFen:parseMoneyInput(capital)??0}} label="个人给课程企业注资" confirm/></div>
}
function CourseCapital({p,businessId,courseId}:{p:GamePanelProps;businessId:string;courseId:string}){
 const c=p.features.course!.courses.find(c=>c.id===courseId&&c.businessId===businessId)!,[draft,setDraft]=useCourseTeachingDraft(p.view.runId,teachingScope(p,c,'capital'),p.courseTeachingDraftMemory)
 return <div id={courseId+'-capital'} className="button-row"><label className="field">从个人追加自有资金（元）<input inputMode="decimal" value={draft.capital} onChange={e=>setDraft(previous=>({...previous,capital:e.target.value}))}/></label><CommandButton {...p} kind="FundBusiness" payload={{businessId,amountFen:parseMoneyInput(draft.capital)??0}} label="个人给课程企业注资" confirm/></div>
}
function CourseRefresh({p,c}:{p:GamePanelProps;c:Lesson}){
 const [draft,setDraft]=useCourseTeachingDraft(p.view.runId,teachingScope(p,c,'refresh'),p.courseTeachingDraftMemory)
 return <details id={c.id+'-refresh'}><summary>原课程更新与教学版本</summary><TeachingSchedule p={p} draft={draft} setDraft={setDraft}/><CommandButton {...p} kind="StartCourseRefresh" payload={{courseId:c.id,resources:draft.resources,startAt:draft.startAt}} label={c.unresolvedUpdates.length?'更新旧课与已有学员材料 · 1点/2000元/7天':'另行改善现有教学版本 · 1点/2000元/7天'}/><p>更新不产生新产品或再次收费资格，旧学生与退款责任仍保留。</p></details>
}
function CourseIntake(props:GamePanelProps&{courseId:string}){
 const v=props.features.course!,c=v.courses.find(c=>c.id===props.courseId)!,product=v.catalog.products.find(p=>p.id===c.productId)!,[draft,setDraft]=useCourseTeachingDraft(props.view.runId,teachingScope(props,c,'audience'),props.courseTeachingDraftMemory),audiences=v.audiences.filter(a=>a.courseId===c.id),sources=v.videoCohorts.filter(co=>co.segment===c.segment&&co.date<=props.view.date),invalidSources=draft.sourceIds.filter(id=>!sources.some(s=>s.id===id))
 return <details className="panel" id={c.id+'-audience'}><summary>班额、价格与获客</summary><p>入门录播规模上限200/资源，实操40，内训20；自答疑仅20人（内训5人），占2点/14天、不用额外支持现金；集中支持入门/实操3000元、1点/7天，内训5000元、2点/14天。真实员工工资另算。</p><label className="field">本次营销报价（元）<input inputMode="decimal" value={draft.price} onChange={e=>setDraft(previous=>({...previous,price:e.target.value}))}/></label><p>原参考报价{moneyText(product.basePriceFen)}，可选{moneyText(product.minPriceFen)}—{moneyText(product.maxPriceFen)}。报价随这份原意向记录冻结；不是保底收入，同一知识产品不能向同一人重复收费。</p><fieldset><legend>明确选择这次实际获客来源</legend>{[['paid','付费推广'],['video_referral','复用同受众的实际视频记录']].map(([mode,label])=><label className="radio-line" key={mode}><input type="radio" checked={draft.audienceMode===mode} onChange={()=>setDraft(previous=>({...previous,audienceMode:mode!}))}/>{label}</label>)}</fieldset>{draft.audienceMode==='paid'?<><TeachingSchedule p={props} draft={draft} setDraft={setDraft}/><CommandButton {...props} kind="CreateCourseAudience" payload={{courseId:c.id,mode:'paid',priceFen:parseMoneyInput(draft.price)??0,resources:draft.resources,startAt:draft.startAt}} label="付费推广 · 1点/6000元/7天"/></>:draft.audienceMode==='video_referral'?<><h4>复用实际视频受众</h4>{sources.map(co=><label key={co.id} className="radio-line"><input type="checkbox" checked={draft.sourceIds.includes(co.id)} onChange={e=>setDraft(previous=>({...previous,sourceIds:e.target.checked?[...previous.sourceIds,co.id]:previous.sourceIds.filter(id=>id!==co.id)}))}/>{co.date} · 实际受众{co.members}人 · {co.id.slice(-6)}</label>)}{!sources.length?<p className="warning-box">当前没有与本课程受众匹配的实际视频来源，没有替换成其他人群。</p>:null}{invalidSources.length?<><p className="warning-box">原选择的视频来源已不匹配，请明确重选。</p><button type="button" onClick={()=>setDraft(previous=>({...previous,sourceIds:previous.sourceIds.filter(id=>sources.some(s=>s.id===id))}))}>明确清除不可用来源</button></>:null}<CommandButton {...props} kind="CreateCourseAudience" payload={{courseId:c.id,mode:'video_referral',priceFen:parseMoneyInput(draft.price)??0,videoCohortIds:draft.sourceIds}} label="核对这些已有受众对本课程的需求" confirm/></>:<p className="field-help">先明确选择来源，没有默认付费或使用其他受众。</p>}{audiences.map(a=><CourseAudiencePlan key={a.id} {...props} courseId={c.id} audienceId={a.id}/>)}</details>
}
function CourseAudiencePlan(props:GamePanelProps&{courseId:string;audienceId:string}){
 const v=props.features.course!,c=v.courses.find(c=>c.id===props.courseId)!,a=v.audiences.find(a=>a.id===props.audienceId&&a.courseId===c.id)!,scope={...teachingScope(props,c,'plan'),audienceId:a.id},[draft,setDraft]=useCourseTeachingDraft(props.view.runId,scope,props.courseTeachingDraftMemory),assignment={resources:draft.resources,startAt:draft.supportStartAt}
 return <section id={a.id}><h4>{a.mode==='paid'?'付费推广':'视频已有受众'} · 原报价{moneyText(a.priceFen)}</h4>{a.job?<div id={a.job.id}><p>{stateText[a.job.status]} · {a.job.startAt}—{a.job.completeAt}</p>{['planned','running'].includes(a.job.status)?<div className="button-row"><button type="button" disabled={blocked(props)||props.features.workbench.pause!==null} onClick={()=>props.request('AdvanceTime',{date:a.job!.status==='planned'?a.job!.startAt:a.job!.completeAt},'推进到推广实际反馈')}>推进到课程推广反馈</button><CommandButton {...props} kind="InterruptJob" payload={{jobId:a.job.id}} label="停止这次获客，保留已耗成本" confirm/></div>:null}</div>:null}{a.completedAt?<><p>实际覆盖{a.members.length}人，当前基础意向{a.eligibleMembers.length}人。已购买身份仍会排除。</p><form id={a.id+'-plan'} className="stack" onSubmit={e=>{e.preventDefault();props.request('PlanCourseCohort',{courseId:c.id,audienceId:a.id,startAt:draft.startAt,endAt:draft.endAt,supportStartAt:draft.supportStartAt,seatLimit:Number(draft.seatLimit),supportMode:draft.supportMode,deploymentId:agentSupportMode(draft.supportMode)?draft.deploymentId:null,resources:draft.resources,promise:draft.promise},'冻结班额、阶段期限和真实支持预留',true)}}><div className="form-grid"><label className="field">开课日期<input type="date" value={draft.startAt} min={addDays(props.view.date,1)} max="2025-12-31" required onChange={e=>setDraft(previous=>({...previous,startAt:e.target.value}))}/></label><label className="field">最终教学期限<input type="date" value={draft.endAt} max="2025-12-31" required onChange={e=>setDraft(previous=>({...previous,endAt:e.target.value}))}/></label><label className="field">答疑开始日期<input type="date" value={draft.supportStartAt} max="2025-12-31" required onChange={e=>setDraft(previous=>({...previous,supportStartAt:e.target.value}))}/></label><label className="field">本班名额<input type="number" min="1" max="240" value={draft.seatLimit} required onChange={e=>setDraft(previous=>({...previous,seatLimit:e.target.value}))}/></label><TeachingSupportFields p={props} businessId={c.businessId} draft={draft} setDraft={setDraft}/><label className="field">支持资源<ResourceSelect options={v.resources} value={draft.resources.length===1?draft.resources[0]??'':''} onChange={id=>setDraft(previous=>({...previous,resources:id?[id]:[]}))}/></label><label className="field">对学员的承诺<select value={draft.promise} onChange={e=>setDraft(previous=>({...previous,promise:e.target.value}))}><option value="">请选择承诺范围</option>{draft.promise&&!['clear_scope','accelerated_results'].includes(draft.promise)?<option value={draft.promise} disabled>原承诺不可用，请重选</option>:null}<option value="clear_scope">明确范围与练习目标</option><option value="accelerated_results">更激进的加速承诺 · 更多意向及投诉风险</option></select></label></div>{draft.startAt&&draft.startAt<=props.view.date||draft.endAt&&draft.endAt<draft.startAt||draft.supportStartAt&&draft.supportStartAt<draft.endAt?<p className="warning-box">原草稿日历现在不符合先后期限，请重新选择；没有改成今天或下一季度。</p>:null}{assignment.resources.some(id=>!v.resources.some(r=>r.id===id))?<p className="warning-box">原支持资源已不可用，请明确重选。</p>:null}<p className="field-help">教学两阶段各有实际授课任务。先预留未来答疑行动、日期与自有资金，再接受预款；原学员的退款窗口延续至答疑整改期结束。</p><button type="submit" disabled={blocked(props)}>预览本班合同与支持预留</button></form></>:null}</section>
}
function CourseClass(props:GamePanelProps&{cohortId:string}){
 const v=props.features.course!,co=v.cohorts.find(c=>c.id===props.cohortId)!,course=v.courses.find(c=>c.id===co.courseId)!,[enroll,setEnroll]=useCourseTeachingDraft(props.view.runId,teachingScope(props,course,'enroll',co),props.courseTeachingDraftMemory),[stage0,setStage0]=useCourseTeachingDraft(props.view.runId,teachingScope(props,course,'stage:0',co),props.courseTeachingDraftMemory),[stage1,setStage1]=useCourseTeachingDraft(props.view.runId,teachingScope(props,course,'stage:1',co),props.courseTeachingDraftMemory),[recovery,setRecovery]=useCourseTeachingDraft(props.view.runId,teachingScope(props,course,'recovery',co),props.courseTeachingDraftMemory),[refundDraft,setRefund]=useCourseTeachingDraft(props.view.runId,teachingScope(props,course,'refund',co),props.courseTeachingDraftMemory)
 const active=co.students.filter(e=>e.paidRemainingFen>0),netIncome=co.students.reduce((sum,e)=>sum+e.delivered[0]+e.delivered[1]-e.refundedDelivered[0]-e.refundedDelivered[1],0),prepaid=co.students.reduce((sum,e)=>sum+e.priceFen-e.delivered[0]-e.delivered[1]-e.refundedUnearned,0),refund=co.students.reduce((sum,e)=>sum+e.refundedFen,0),disabled=blocked(props)||props.features.workbench.pause!==null,invalidPeople=enroll.personIds.filter(id=>!co.availablePeople.includes(id)),invalidRefunds=refundDraft.personIds.filter(id=>!active.some(e=>e.personId===id)),count=Number(enroll.seatLimit),canChooseCount=Number.isInteger(count)&&count>0&&count<=Math.min(co.availablePeople.length,co.seatLimit)
 const recoveryDef=COURSE_JOBS.find(j=>j.id==='course-support-'+course.productId+'-'+recovery.supportMode)
 return <section id={co.id} className="panel stack"><div className="section-heading"><h3>{course.name} · {co.startAt}班</h3><span className="tag">{co.status==='remedy'&&!courseNeedsRecovery(co)?'原退款与结算待收尾':stateText[co.status]}</span></div><p>冻结单价{moneyText(co.priceFen)} · {active.length}/{co.seatLimit}名当前学员 · 最后教学期限{co.endAt} · 支持完成约定{co.supportCompleteAt} · 整改/退款窗口{co.refundUntil}</p><dl className="finance-grid"><div><dt>尚未履约保护</dt><dd>{moneyText(prepaid)}</dd></div><div><dt>已确认净收入</dt><dd>{moneyText(netIncome)}</dd></div><div><dt>已记退款</dt><dd>{moneyText(refund)}</dd></div><div><dt>结算费入账</dt><dd>{co.feePostedAt?moneyText(co.feeFen):'退款窗口结束后按留存收入5%结算'}</dd></div></dl>
 {co.closedAt===null?<div id={co.id+'-enroll'}><label className="field">从实际未购买意向中选择人数<input type="number" min="1" max={Math.min(co.availablePeople.length,co.seatLimit)} value={enroll.seatLimit} onChange={e=>setEnroll(previous=>({...previous,seatLimit:e.target.value}))}/></label><button type="button" disabled={!canChooseCount||disabled} onClick={()=>setEnroll(previous=>({...previous,personIds:co.availablePeople.slice(0,count)}))}>明确选中这{canChooseCount?count:0}位实际意向者</button>{co.availablePeople.map((id,n)=><label key={id} className="radio-line"><input type="checkbox" checked={enroll.personIds.includes(id)} onChange={e=>setEnroll(previous=>({...previous,personIds:e.target.checked?[...previous.personIds,id]:previous.personIds.filter(old=>old!==id)}))}/>实际意向{n+1} · {id.slice(-6)}</label>)}{invalidPeople.length?<><p className="warning-box">原选择中有人已不属于本班当前可报名意向，没有换成另一位学员。</p><button type="button" onClick={()=>setEnroll(previous=>({...previous,personIds:previous.personIds.filter(id=>co.availablePeople.includes(id))}))}>明确清除不可报名的选择</button></>:null}<CommandButton {...props} kind="EnrollCourseAudience" payload={{cohortId:co.id,personIds:enroll.personIds}} label={'为'+enroll.personIds.length+'名已选学员收受保护预款（不是收入）'} confirm/><p>当前仍未购买本知识产品的实际意向{co.availablePeople.length}人。暂停或过开课日不再接新生；已有交付和退款继续。</p></div>:<p className="receipt-card">本班已于{co.closedAt}结清。学习事实和退款仍保留，不因此再次收费。</p>}
 {co.stages.map((st,index)=>{const draft=index===0?stage0:stage1,setDraft=index===0?setStage0:setStage1,product=v.catalog.products.find(p=>p.id===course.productId)!,min=co.startAt>props.view.date?co.startAt:props.view.date;return <article id={co.id+'-stage-'+index} key={index}><h4>第{index+1}教学阶段</h4><p>{st.deliveredAt?st.deliveredAt+'实际交付，确认'+moneyText(st.amountFen):'最迟'+st.dueAt+'完成，开始不等于交付'}</p>{st.deliveredAt===null&&co.closedAt===null?<><TeachingSchedule p={props} draft={draft} setDraft={setDraft} min={min} max={courseStageLatestStart(st.dueAt,product.stageDays)}/><CommandButton {...props} kind="StartCourseStage" payload={{cohortId:co.id,index,resources:draft.resources,startAt:draft.startAt}} label={'安排第'+(index+1)+'阶段实际教学'}/></>:null}{co.stageJobs[index]?.filter(Boolean).map((j,n)=><div key={j!.id} id={j!.id}><p>本段原第{n+1}次任务 · {stateText[j!.status]} · {j!.startAt}—{j!.completeAt}</p>{['planned','running'].includes(j!.status)?<div className="button-row"><button type="button" disabled={disabled} onClick={()=>props.request('AdvanceTime',{date:j!.status==='planned'?j!.startAt:j!.completeAt},'推进到实际教学完成')}>推进到第{index+1}阶段完成</button><CommandButton {...props} kind="InterruptJob" payload={{jobId:j!.id}} label={'中断第'+(index+1)+'阶段，未履约仍保留'} confirm/></div>:null}</div>)}</article>})}
 <h4>已承诺的支持与整改</h4>{co.supportJobs.map(slot=><article key={slot.jobId} id={slot.jobId}><p>{slot.recovery?'补支持':'原定支持'} · {supportModeText[slot.mode]} · 容量{slot.capacity} · {stateText[slot.job?.status??'']} · {slot.job?.startAt}—{slot.job?.completeAt}</p>{slot.job&&['planned','running'].includes(slot.job.status)?<div className="button-row"><button type="button" disabled={disabled} onClick={()=>props.request('AdvanceTime',{date:slot.job!.status==='planned'?slot.job!.startAt:slot.job!.completeAt},'推进到实际支持完成')}>推进到本项答疑完成</button><CommandButton {...props} kind="InterruptJob" payload={{jobId:slot.job.id}} label="中断这项支持，学生责任保留" confirm/></div>:null}</article>)}{courseNeedsRecovery(co)?<div id={co.id+'-recovery'} className="warning-box"><p>已有学员尚未得到承诺帮助。可安排真实补支持，或在{co.remedyDueAt}前退款；无人处理不会免费标记完成。</p><TeachingSupportFields p={props} businessId={course.businessId} draft={recovery} setDraft={setRecovery}/><TeachingSchedule p={props} draft={recovery} setDraft={setRecovery} {...(recoveryDef?{max:courseStageLatestStart(co.remedyDueAt,recoveryDef.durationDays)}:{})}/><CommandButton {...props} kind="StartCourseRecovery" payload={{cohortId:co.id,supportMode:recovery.supportMode,deploymentId:agentSupportMode(recovery.supportMode)?recovery.deploymentId:null,resources:recovery.resources,startAt:recovery.startAt}} label="按所选日期和资源安排补支持"/></div>:null}
 <details id={co.id+'-refund'}><summary>学员进度、结果与退款（{co.students.length}）</summary><p>每位学员沿用同一受众身份。已交付退款冲收入；尚未交付退款释放原保护。已记退款不等于学员实际到账；缺现金时保留应付，不负现金假装付清。</p>{co.students.map((e,n)=><label key={e.id} id={e.id} className="radio-line"><input type="checkbox" checked={refundDraft.personIds.includes(e.personId)} disabled={e.paidRemainingFen===0} onChange={ev=>setRefund(previous=>({...previous,personIds:ev.target.checked?[...previous.personIds,e.personId]:previous.personIds.filter(id=>id!==e.personId)}))}/>学员{n+1} · {stateText[e.outcome]} · 已交付{moneyText(e.delivered[0]+e.delivered[1])} · 已记退款{moneyText(e.refundedFen)}{e.recovered?' · 已实际补支持':''}</label>)}{invalidRefunds.length?<><p className="warning-box">原选择中有人已没有可退原款，请明确核对，没有自动替换退款对象。</p><button type="button" onClick={()=>setRefund(previous=>({...previous,personIds:previous.personIds.filter(id=>active.some(e=>e.personId===id))}))}>明确清除不可退款的选择</button></>:null}<label className="field">退款原因<input value={refundDraft.reason} maxLength={200} onChange={e=>setRefund(previous=>({...previous,reason:e.target.value}))}/></label><CommandButton {...props} kind="RefundCourseLearners" payload={{cohortId:co.id,personIds:refundDraft.personIds,reason:refundDraft.reason}} label="按原阶段流水为已选学员退款" confirm/><CommandButton {...props} kind="RefundCourseLearners" payload={{cohortId:co.id,personIds:active.map(e=>e.personId),reason:'结束本班并处理全部学员退款'}} label="退款收尾本班全部未结学员" confirm/>{v.refunds.filter(r=>r.cohortId===co.id).map(r=><article key={r.id} id={r.id}><p>{r.date} · {r.personIds.length}名原学员 · 已记应退{moneyText(r.undeliveredFen+r.deliveredFen)}（未交付{moneyText(r.undeliveredFen)}、已交付冲减{moneyText(r.deliveredFen)}）。</p><p>{r.reason}；实际付款与未结应付见本主体原账。</p></article>)}</details>
 {co.closedAt===null?<button type="button" disabled={disabled} onClick={()=>props.request('AdvanceTime',{date:addDays(co.refundUntil,1)},'推进班期退款窗口与结算')}>推进至退款窗口后的结算日（先处理沿途事项）</button>:null}</section>
}
