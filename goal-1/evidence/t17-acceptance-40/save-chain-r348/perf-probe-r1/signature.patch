+const parsedLedgerSignatures=new WeakMap<LedgerReceipt,{signature:string;operation:LedgerOperation}>()
+function parseLedgerSignature(receipt:LedgerReceipt):LedgerOperation{
+ const signature=receipt.signature
+ if(typeof signature!=='string')return JSON.parse(signature) as LedgerOperation
+ const previous=parsedLedgerSignatures.get(receipt)
+ if(previous?.signature===signature)return previous.operation
+ const operation=JSON.parse(signature) as LedgerOperation
+ parsedLedgerSignatures.set(receipt,{signature,operation});return operation
+}
