 0) })), publications: s.publications.map(({ factId: _, ...p }) => p), applications: s.applications.map(({ factId, ...a }) => ({ ...a, resultRead: run.facts.some(f => f.id === factId && f.evidence !== null), job: run.operations?.jobs.find(j => j.id === a.jobId) })), marketing: s.marketing.map(({ factId: _, ...m }) => ({ ...m, job: run.operations?.jobs.find(j => j.id === m.jobId) })), settlements: s.settlements, resources: [{ id: 'player-production', label: '本人制作时间' }, ...(run.operations?.workers.filter(w => w.to === null).map(w => ({ id: w.id, label: `员工 ${w.definitionId}（按日计薪）` })) ?? [])], modes: runtime.catalog.modes.map(m => ({ ...m, reasonCodes: runtime.capabilityReasons(run, m.capability, date) })) });
