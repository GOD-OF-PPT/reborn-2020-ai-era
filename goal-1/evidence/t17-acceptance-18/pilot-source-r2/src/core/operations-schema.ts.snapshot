import { z } from 'zod'
import { idSchema as id, dateSchema as date, moneySchema as money, safeCount, rows } from './record-schemas.ts'
import { addDays } from './calendar.ts'
import { ROUTES } from './content-types.ts'
import { assertJsonInput } from './json-input.ts'
import { requireRule } from './errors.ts'
import type { OperationsCatalog } from './operations-types.ts'
const positiveDays = safeCount.min(1).max(3650)
const lifecycle = z.enum(['discovered','preparing','operating','paused','winding_down','closed'])
const month = z.string().regex(/^\d{4}-\d{2}$/)
export const operationsCatalogSchema = z.strictObject({ version: id, profiles: rows(z.strictObject({ id, monthlySalaryFen: money })), businesses: rows(z.strictObject({ id, route: z.enum(ROUTES), company: z.boolean(), capabilities: rows(id), preparationKey: id.nullable(), minCashFen: money, capacityUnits: safeCount.max(1000), monthlyMaintenanceFen: money, requiresPreparationJob: z.boolean() })), jobs: rows(z.strictObject({ id, purpose: z.enum(['prepare','production','maintenance']), routes: rows(z.enum(ROUTES)), skill: id, durationDays: positiveDays, actionPoints: safeCount.max(4), costFen: money, output: id })), offers: rows(z.strictObject({ id, route: z.enum(ROUTES), from: date, to: date, jobDefinitionId: id, priceFen: money.min(1), prepaymentFen: money, deliveryDueAt: date, reviewDays: positiveDays, paymentDays: safeCount.max(3650), acceptBps: safeCount.max(10000), classification:z.enum(['fictional','counterfactual']).default('fictional'),startWindow:z.strictObject({from:date,to:date}).nullable().default(null),caseKey:id.nullable().default(null) })), workers: rows(z.strictObject({ id, skills: rows(id), units: safeCount.min(1).max(1000), monthlyWageFen: money.min(1), recruitmentCostFen: money })), loans: rows(z.strictObject({ id, principalFen: money.min(1), feeFen: money, termDays: positiveDays })) })
export function loadOperationsCatalog(value: unknown): OperationsCatalog {
 assertJsonInput(value); const parsed=operationsCatalogSchema.safeParse(value); requireRule(parsed.success,'INVALID_OPERATIONS_CATALOG'); const catalog=parsed.data
 for(const list of [catalog.profiles,catalog.businesses,catalog.jobs,catalog.offers,catalog.workers,catalog.loans]) requireRule(new Set(list.map(item=>item.id)).size===list.length,'DUPLICATE_OPERATING_DEFINITION')
 for(const offer of catalog.offers) { const job=catalog.jobs.find(item=>item.id===offer.jobDefinitionId); requireRule(job?.purpose==='production'&&job.routes.includes(offer.route)&&offer.from>='2020-01-01'&&offer.to<='2025-12-31'&&offer.from<=offer.to&&offer.to<=offer.deliveryDueAt&&offer.prepaymentFen<=offer.priceFen&&(offer.startWindow===null||(offer.from<=offer.startWindow.from&&offer.startWindow.from<=offer.startWindow.to&&addDays(offer.startWindow.to,job.durationDays)<=offer.deliveryDueAt)),'INVALID_CONTRACT_OFFER') }
 return catalog
}
export const operatingEventSchema=z.strictObject({ kind:z.literal('operating_event'), type:z.enum(['salary','wage','maintenance','start_job','finish_job','customer_response','collection','loan_due','offer_expiry']), entityId:id,month:month.nullable(),date })
export const operationsStateSchema=z.strictObject({catalogVersion:id,catalogHash:z.string().regex(/^[0-9a-f]{64}$/),profileId:id,offerDecisions:rows(z.strictObject({offerId:id,kind:z.enum(['declined','skipped','expired']),date,sourceId:id})),
 employment:rows(z.strictObject({id,quarter:z.string().regex(/^\d{4}-Q[1-4]$/),limit:date,actionId:id,salaryFen:money,segments:rows(z.strictObject({from:date,to:date.nullable()}))})),
 businesses:rows(z.strictObject({id,definitionId:id,route:z.enum(ROUTES),accountId:id,company:z.boolean(),lifecycle,prepared:z.boolean(),activeFrom:date.nullable(),stoppedAt:date.nullable(),distributedFen:money,monthlyMaintenanceFen:money,history:rows(z.strictObject({date,state:lifecycle,sourceId:id}))})),
 workers:rows(z.strictObject({id,definitionId:id,sponsorBusinessId:id,from:date,to:date.nullable(),units:safeCount.min(1).max(1000),monthlyWageFen:money})),
 jobs:rows(z.strictObject({id,businessId:id,definitionId:id,contractId:id.nullable(),actionId:id,resources:rows(id),startAt:date,completeAt:date,releasedAt:date.nullable(),status:z.enum(['planned','running','completed','interrupted','cancelled']),outputId:id.nullable()})),
 contracts:rows(z.strictObject({id,businessId:id,offerId:id,jobId:id,factId:id,acceptedAt:date,status:z.enum(['production','review','delivered','settled','rejected','cancelled']),submittedAt:date.nullable(),reviewedAt:date.nullable(),settledAt:date.nullable(),classification:z.enum(['fictional','counterfactual']),caseKey:id.nullable()})),
 payroll:rows(z.strictObject({id,entityId:id,kind:z.enum(['salary','wage','maintenance']),month,through:date,amountFen:money,operationId:id.nullable()})),loans:rows(z.strictObject({id,offerId:id,accountId:id,date,dueAt:date,principalObligationId:id,feePosted:z.boolean()})),logs:rows(z.strictObject({id,date,sourceEventId:id,text:z.string().min(1).max(4000),visibility:z.literal('visible'),parentIds:rows(id)}))})
