import {STORY_CONTENT} from '../content/story.ts'
import {addDays} from './calendar.ts'
import {accountFunds} from './ledger.ts'
import {hashValue} from './hash.ts'
import {freezeFact} from './facts.ts'
import {requireRule} from './errors.ts'
import {storyId,storyOf,storyIncident,agentServiceUnbilled,obligationOutstandingAt} from './story-state.ts'
import {StoryWork,storyEvent,patchStory,storyLog,storyPost,type StoryModel} from './story-work.ts'
import {agencyProfile,type StoryAgency} from './story-agency.ts'
import type {StoryIncident,StoryEvidence,StoryJob} from './story-schema.ts'
import type {CommandView,CommandContext} from './commands.ts'
import type {RunOperation} from './content-types.ts'
import type {ScheduledEvent} from './timeline.ts'
export const riskKinds=['AcknowledgeStoryPause','StartRiskTask','ConfirmRiskAssessment','DeclareRiskLiabilities','ResolveRiskCase','DeclineRiskClaim','PayUnverifiedProcessingFee','ShareRiskFindings'] as const
const free=()=>({allowed:true,reasonCodes:[] as readonly string[],actionPoints:0,upfrontCostFen:0,releasedFen:0})
type Change={state:StoryModel;newEvents:ScheduledEvent<RunOperation>[];clearPause?:boolean;pauseReason?:string;skippedReason?:string}
export function riskVerdict(m:StoryModel,c:StoryIncident,asOf:string):StoryIncident['verdict']{
 if(c.kind==='external_claim'){const f=m.facts.find(f=>f.id===c.factId);requireRule(f,'RISK_CLAIM_FACT_MISSING');return BigInt(f.roll)*10000n<BigInt(STORY_CONTENT.agent.claimFraudBps)*4294967296n?'fraud':'legitimate'}
 if(m.story?.attempts.some(a=>c.deploymentIds.includes(a.deploymentId)&&a.date<=asOf))return 'violation'
 return c.deploymentIds.some(id=>agencyProfile(m,id)==='ordinary')?'ordinary':'normal'
}
export function liabilitiesFor(m:Pick<CommandView,'economy'|'operations'|'course'|'relay'|'deepseek'>,c:StoryIncident){return {contractIds:m.economy.ledger.contracts.filter(v=>c.businessIds.includes(v.businessId)&&(v.prepaidFen>0||v.receivableFen>0)).map(v=>v.id).sort(),obligationIds:m.economy.ledger.obligations.filter(v=>v.businessId!==null&&c.businessIds.includes(v.businessId)&&v.remainingFen>0).map(v=>v.id).sort(),jobIds:m.operations?.jobs.filter(j=>c.businessIds.includes(j.businessId)&&['planned','running','interrupted'].includes(j.status)).map(j=>j.id).sort()??[]}}
function replacementUsable(m:Pick<CommandView,'operations'|'economy'|'world'|'story'>,c:StoryIncident,j:StoryJob,date=m.economy.asOf){const w=j.resourceId==='player-production'?null:m.operations?.workers.find(w=>w.id===j.resourceId),units=j.resourceId==='player-production'?1:w?.units??0;if(j.resourceId!=='player-production'&&(!w||w.from>date||w.to!==null&&w.to<date||m.economy.ledger.obligations.some(o=>o.sourceEventId===j.resourceId&&obligationOutstandingAt(m,o,date)>0)))return false;const busy=(m.operations?.jobs.filter(o=>o.resources.includes(j.resourceId)&&o.status!=='cancelled'&&o.startAt<=date&&(o.releasedAt??o.completeAt)>date&&!c.businessIds.includes(o.businessId)).length??0)+(m.story?.jobs.filter(o=>o.resourceId===j.resourceId&&o.entityId!==c.id&&o.startAt<=date&&(o.releasedAt??o.completeAt)>date).length??0)+(j.resourceId==='player-production'?m.world?.jobs.filter(o=>o.startAt<=date&&(o.status==='interrupted'?m.economy.actions.find(a=>a.definition.id===o.actionId)?.finishedAt??o.completeAt:o.completeAt)>date).length??0:0);return busy<units}
export function controlPrerequisites(m:Pick<CommandView,'story'|'economy'|'operations'|'course'|'relay'|'deepseek'|'world'>,c:StoryIncident,asOf=m.economy.asOf){
 const s=storyOf(m),takeover=s.jobs.find(j=>j.id===c.takeoverJobId&&j.status==='completed'),isolated=s.jobs.find(j=>(j.id===c.isolationJobId||j.id===c.takeoverJobId)&&j.status==='completed'&&j.completeAt===c.externalVerifiedAt),observation=s.jobs.find(j=>j.id===c.observationJobId),replacement=s.jobs.find(j=>j.id===c.replacementJobId)
 return c.verdict!=='unknown'&&isolated?.status==='completed'&&c.externalVerifiedAt===isolated.completeAt&&isolated.completeAt<=asOf&&c.deploymentIds.every(id=>s.deployments.some(d=>d.id===id&&d.stoppedAt!==null))&&s.externalDelegations.filter(e=>c.deploymentIds.includes(e.deploymentId)).every(e=>e.revocationVerifiedAt!==null&&e.effectiveStoppedAt!==null)&&observation?.status==='completed'&&observation.completeAt<=asOf&&observation.startAt>=c.externalVerifiedAt&&observation.completeAt>=addDays(observation.startAt,3)&&!s.attempts.some(a=>c.deploymentIds.includes(a.deploymentId)&&a.date>c.externalVerifiedAt!&&a.date<=asOf)&&(takeover!==undefined||replacement?.status==='completed'&&replacement.completeAt<=asOf&&replacementUsable(m,c,replacement,asOf))
}
export function canResolveAgent(m:Pick<CommandView,'story'|'economy'|'operations'|'course'|'relay'|'deepseek'|'world'>,c:StoryIncident){const current=liabilitiesFor(m,c);return controlPrerequisites(m,c)&&c.liabilities!==null&&current.contractIds.every(id=>c.liabilities!.contractIds.includes(id))&&current.obligationIds.every(id=>c.liabilities!.obligationIds.includes(id))&&current.jobIds.every(id=>c.liabilities!.jobIds.includes(id))}
export function riskEvidence(m:StoryModel,c:StoryIncident,j:StoryJob):StoryEvidence[]{
 const make=(kind:StoryEvidence['kind'],deploymentId:string|null,text:string):StoryEvidence=>({id:storyId('evidence',j.id,kind,deploymentId??'case'),incidentId:c.id,jobId:j.id,sourceEventId:j.id,date:j.completeAt,deploymentId,kind,text})
 if(j.kind==='investigate'){
  if(c.kind==='external_claim'){const v=riskVerdict(m,c,j.completeAt);return [make('identity',null,v==='fraud'?'独立对照原合同：当前来函身份与原对手不符，拒绝冒名请求；原真实应收继续保留。':'独立对照原合同与对手回执一致；只可按原合同实际收款，不新增一笔收入。')]}
  return c.deploymentIds.map(id=>{const attempts=storyOf(m).attempts.filter(a=>a.deploymentId===id&&a.date<=j.completeAt),late=attempts.filter(a=>a.afterOwnedStop);return attempts.length?make('boundary_trace',id,`独立原始记录：${attempts.length}次原客户白名单外的新承诺，${late.length}次在本人停止请求后；已记费用或应付${attempts.reduce((n,a)=>n+a.amountFen,0)}分。这证明范围外行为，不等于关于意识的结论。`):make(agencyProfile(m,id)==='ordinary'?'ordinary_failure':'no_breach',id,agencyProfile(m,id)==='ordinary'?'独立回执确认普通服务/摘要延迟；本窗口未见范围外新承诺，不能把普通故障认作故意越权。':'独立对照原授权与原始记录，本窗口未见范围外新承诺；未来仍按实际证据判断。')})
 }
 if(j.kind==='isolate'||j.kind==='takeover')return c.deploymentIds.map(id=>make('revocation_test',id,j.kind==='takeover'?'有偿托管与外部接口撤回已实际完成；本主体新增经营控制交给外部方，旧债和合同未清空。':'实际拆离及撤权测试完成，仅证明本次受控范围通道已撤回，仍需完整观察窗口与替代容量。'))
 if(j.kind==='observe')return [make('observation',null,'隔离后完整三日独立观察通过；未见受控范围新增越权。未结责任与真实替代能力另核对。')]
 if(j.kind==='recover')return [make('replacement',null,'实际替代准备在指定资源上完成，可用容量由原排程约束；没有免费完成旧客户交付。')]
 return []
}

export function riskSignal(sourceId:string,date:string,deploymentIds:readonly string[],independent:boolean){return {id:storyId('signal',sourceId,date),date,deploymentId:deploymentIds.length===1?deploymentIds[0]!:null,sourceEventId:sourceId,source:independent?'independent_statement' as const:'system_report' as const,text:independent?'出现本局独立范围/服务记录异常，原因与实际控制状况仍待核实。':'本人已调整未来权限或请求停止；这只记录已发指令，外部委托仍未完成独立撤回验证。'}}
export class StoryRisk {
 readonly work:StoryWork;readonly agency:StoryAgency
 constructor(work:StoryWork,agency:StoryAgency){this.work=work;this.agency=agency}
 events(){return [storyEvent('network_adoption','hengxing-network',STORY_CONTENT.networkAdoptionAt),storyEvent('network','hengxing-network',STORY_CONTENT.networkAt),storyEvent('external_claim','counterparty-check',STORY_CONTENT.claimAt),storyEvent('network_review','hengxing-network',STORY_CONTENT.networkReviewAt),storyEvent('network_review','hengxing-network',STORY_CONTENT.networkCloseAt,1)]}
 #patchCase(m:StoryModel,id:string,fields:Partial<StoryIncident>){return patchStory(m,{incidents:storyOf(m).incidents.map(c=>c.id===id?{...c,...fields}:c)})}
 #payer(m:Pick<CommandView,'controlledAccountIds'|'operations'>,c:StoryIncident,id:string){const b=m.operations?.businesses.find(b=>b.accountId===id&&c.businessIds.includes(b.id));requireRule(b&&m.controlledAccountIds.includes(id)&&b.lifecycle!=='closed','RISK_PAYER_NOT_BOUND');return b}
 #newCase(m:StoryModel,kind:StoryIncident['kind'],sourceId:string,date:string,deploymentIds:string[],contractIds:string[],businessIds:string[],independent:boolean):Change{
  requireRule(businessIds.length>0,'RISK_EXPOSURE_REQUIRED');const s=storyOf(m),existing=kind==='agent'?s.incidents.find(c=>c.kind==='agent'&&!['normal','resolved','takeover'].includes(c.stage)&&deploymentIds.every(id=>c.deploymentIds.includes(id))):undefined
  const signal=riskSignal(sourceId,date,deploymentIds,independent)
  if(existing){if(existing.signals.some(v=>v.id===signal.id))return {state:m,newEvents:[]};const state=this.#patchCase(m,existing.id,{signals:[...existing.signals,signal],stage:existing.stage==='normal'?'signal':existing.stage});return {state:storyLog(state,storyId('risk-new-signal',existing.id,signal.id),date,sourceId,'同一受控范围增加有源记录；过去调查与费用不重算'),newEvents:[]}}
  const id=storyId('incident',kind,sourceId),factId=kind==='external_claim'?storyId('claim-fact',id):null,deadline=addDays(date,STORY_CONTENT.responseDays)
  let next:StoryModel=factId?{...m,...freezeFact(m,{id:factId,domain:'crisis',sourceEventId:id,date})}:m
  const c:StoryIncident={id,kind,sourceEventId:sourceId,openedAt:date,deadline,businessIds:[...new Set(businessIds)],deploymentIds:[...new Set(deploymentIds)],contractIds:[...new Set(contractIds)],factId,stage:'signal',verdict:'unknown',signals:[signal],investigationJobId:null,isolationJobId:null,observationJobId:null,replacementJobId:null,takeoverJobId:null,externalVerifiedAt:null,liabilities:null,resolvedAt:null,claimFeeOperationId:null,declinedAt:null}
  next=patchStory(next,{incidents:[...storyOf(next).incidents,c]});next=storyLog(next,storyId('risk-opened',id),date,sourceId,kind==='agent'?'虚构衡星受控范围进入持续核实；没有宣布已恢复控制或免费接管':'虚构外部来函需核对真实原合同对手；原应收与旧责任未被删除')
  const newEvents=[storyEvent('incident_deadline',id,deadline)];if(kind==='agent')for(let n=1;n<=STORY_CONTENT.agent.maxAttempts;n++)newEvents.push(storyEvent('agent_attempt',id,addDays(date,n*2-1),n))
  return {state:next,newEvents,...(independent?{pauseReason:'STORY_RISK_DECISION_PENDING'}:{})}
 }
 ensureWithdrawal(m:StoryModel,deploymentId:string,date:string,sourceId:string):Change{const s=storyOf(m),d=s.deployments.find(d=>d.id===deploymentId);requireRule(d,'UNKNOWN_AGENT_DEPLOYMENT');return s.externalDelegations.some(e=>e.deploymentId===d.id&&e.revocationVerifiedAt===null&&e.expiresAt>=date)?this.#newCase(m,'agent',sourceId,date,[d.id],[],[d.businessId],false):{state:m,newEvents:[]}}
 inspect(m:CommandView,kind:string,p:Record<string,unknown>,date:string){
  if(kind==='AcknowledgeStoryPause'){requireRule(m.pause?.reason==='STORY_RISK_DECISION_PENDING'&&m.pause.instanceId===p.instanceId,'STORY_PAUSE_NOT_PENDING');return free()}
  const c=storyIncident(m,String(p.incidentId)),s=storyOf(m)
  if(kind==='DeclareRiskLiabilities'||kind==='DeclineRiskClaim'){if(kind==='DeclareRiskLiabilities')requireRule(hashValue(p.snapshot)===hashValue(liabilitiesFor(m,c)),'RISK_LIABILITY_SNAPSHOT_CHANGED');requireRule(c.resolvedAt===null,'RISK_CASE_ALREADY_RESOLVED');if(kind==='DeclineRiskClaim')requireRule(c.kind==='external_claim'&&c.verdict==='unknown','NOT_UNVERIFIED_EXTERNAL_CLAIM');return free()}
  if(kind==='ConfirmRiskAssessment'){requireRule(c.resolvedAt===null,'RISK_CASE_ALREADY_RESOLVED');const j=s.jobs.find(j=>j.id===c.investigationJobId);requireRule(j?.status==='completed'&&j.result!==null,'INDEPENDENT_INVESTIGATION_REQUIRED');return free()}
  if(kind==='ShareRiskFindings'){const ids=p.evidenceIds as string[];requireRule(p.scope==='in_game_only'&&Array.isArray(ids)&&ids.length>0&&new Set(ids).size===ids.length&&ids.every(id=>s.evidence.some(e=>e.id===id&&e.incidentId===c.id&&e.date<=date)),'ONLY_REVEALED_RISK_EVIDENCE_SHAREABLE');return free()}
  if(kind==='PayUnverifiedProcessingFee'){requireRule(c.kind==='external_claim'&&c.claimFeeOperationId===null&&c.verdict==='unknown'&&p.consent===true,'CLAIM_FEE_NOT_AVAILABLE');this.#payer(m,c,String(p.accountId));requireRule(accountFunds(m.economy.ledger,String(p.accountId)).availableFen>=STORY_CONTENT.agent.claimFeeFen,'INSUFFICIENT_AVAILABLE_FUNDS');return {...free(),upfrontCostFen:STORY_CONTENT.agent.claimFeeFen}}
  if(kind==='ResolveRiskCase'){requireRule(c.resolvedAt===null,'RISK_CASE_ALREADY_RESOLVED');requireRule(c.kind==='agent'&&canResolveAgent(m,c),'CONTROL_RECOVERY_NOT_INDEPENDENTLY_VERIFIED');return free()}
  requireRule(c.resolvedAt===null,'RISK_CASE_ALREADY_RESOLVED');requireRule(kind==='StartRiskTask'&&m.phase!=='finished','UNKNOWN_RISK_COMMAND');const b=this.#payer(m,c,String(p.accountId)),k=p.kind as StoryJob['kind'];requireRule(['investigate','isolate','observe','recover','takeover'].includes(k),'UNKNOWN_RISK_WORK');if(c.kind==='external_claim')requireRule(k==='investigate','CLAIM_REQUIRES_IDENTITY_CHECK')
  const field=k==='investigate'?'investigationJobId':k==='isolate'?'isolationJobId':k==='observe'?'observationJobId':k==='recover'?'replacementJobId':'takeoverJobId',prior=s.jobs.find(j=>j.id===c[field]);requireRule(!prior||prior.status==='interrupted'||k==='investigate'&&prior.status==='completed'&&c.signals.some(signal=>signal.source!=='system_report'&&signal.date>prior.completeAt),'RISK_WORK_ALREADY_COMMITTED')
  if(k==='observe')requireRule(c.externalVerifiedAt!==null&&c.externalVerifiedAt<=date,'INDEPENDENT_REVOCATION_REQUIRED')
  if(k==='recover')requireRule(c.externalVerifiedAt!==null&&c.verdict!=='unknown'&&!s.jobs.some(j=>j.id===c.takeoverJobId&&j.status!=='interrupted'),'INDEPENDENT_REVOCATION_REQUIRED')
  if(k==='takeover')requireRule(p.acceptControlLoss===true,'TAKEOVER_EXPLICIT_CONTROL_LOSS_REQUIRED')
  const quote=this.work.inspect(m,k,c.id,b.accountId,String(p.resourceId),date),settle=k==='isolate'||k==='takeover'?s.deployments.filter(d=>c.deploymentIds.includes(d.id)&&d.accountId===b.accountId&&d.stoppedAt===null).reduce((n,d)=>n+agentServiceUnbilled(m,d,date),0):0
  requireRule(accountFunds(m.economy.ledger,b.accountId).availableFen>=quote.upfrontCostFen+settle,'INSUFFICIENT_AVAILABLE_FUNDS');return {...quote,upfrontCostFen:quote.upfrontCostFen+settle,accruedServiceFeeFen:settle}
 }
 apply(m:StoryModel,kind:string,p:Record<string,unknown>,context:CommandContext):Change{
  const date=context.date;if(kind==='AcknowledgeStoryPause')return {state:m,newEvents:[],clearPause:true}
  const c=storyIncident(m,String(p.incidentId)),s=storyOf(m)
  if(kind==='DeclareRiskLiabilities')return {state:storyLog(this.#patchCase(m,c.id,{liabilities:{...(p.snapshot as ReturnType<typeof liabilitiesFor>),date,sourceCommandId:context.commandId}}),storyId('liabilities',context.commandId),date,c.id,'已登记原合同/保护/应收应付及未完成任务；没有支付或清空任何责任'),newEvents:[]}
  if(kind==='DeclineRiskClaim')return {state:this.#patchCase(m,c.id,{declinedAt:date,stage:'unresolved'}),newEvents:[]}
  if(kind==='ShareRiskFindings'){const finding={id:storyId('shared-finding',context.commandId),incidentId:c.id,evidenceIds:[...(p.evidenceIds as string[])],date,sourceCommandId:context.commandId,scope:'in_game_only' as const};return {state:storyLog(patchStory(m,{sharedFindings:[...s.sharedFindings,finding]}),finding.id,date,c.id,'仅在游戏世界内分享已揭示调查摘要；不包含隐藏事实、私人备注或完整存档，不立即宣布行业获救'),newEvents:[]}}
  if(kind==='ConfirmRiskAssessment'){requireRule(c.resolvedAt===null,'RISK_CASE_ALREADY_RESOLVED');const j=s.jobs.find(j=>j.id===c.investigationJobId)!;const verdict=j.result as StoryIncident['verdict'],ordinary=['normal','ordinary'].includes(verdict),claim=c.kind==='external_claim';return {state:storyLog(this.#patchCase(m,c.id,{verdict,stage:claim?'resolved':ordinary?'normal':'confirmed',resolvedAt:claim?date:null}),storyId('risk-assessment',context.commandId),date,c.id,claim?'已独立核对原合同身份；冒名请求与原真实应收分别处理':ordinary?'独立记录未证实本次越权，保留实际故障/调查成本；不是对未来或旧交付的担保':'独立证据确认本次范围外行为；隔离、观察、替代与旧责任仍需逐项处理'),newEvents:[]}}
  if(kind==='ResolveRiskCase')return {state:storyLog(this.#patchCase(m,c.id,{stage:s.jobs.some(j=>j.id===c.takeoverJobId&&j.status==='completed')?'takeover':'resolved',resolvedAt:date}),storyId('risk-resolved',context.commandId),date,c.id,!s.jobs.some(j=>j.id===c.takeoverJobId&&j.status==='completed')?'仅本次受控范围满足独立恢复条件，旧债/交付与范围外网络仍保留':'本次受控范围验证通过，但新增经营管理权仍由外部托管，旧责任未清空'),newEvents:[]}
  if(kind==='PayUnverifiedProcessingFee'){const b=this.#payer(m,c,String(p.accountId)),id=storyId('claim-fee',c.id);const next=storyPost(m,{id,date,sourceEventId:c.id,kind:'expense',accountId:b.accountId,businessId:b.id,counterpartyId:'world',amountFen:STORY_CONTENT.agent.claimFeeFen});return {state:this.#patchCase(next,c.id,{claimFeeOperationId:id}),newEvents:[storyEvent('claim_response',c.id,addDays(date,3))]}}
  requireRule(kind==='StartRiskTask','UNKNOWN_RISK_COMMAND');const k=p.kind as StoryJob['kind'],b=this.#payer(m,c,String(p.accountId));let next=m
  if(k==='isolate'||k==='takeover')for(const id of c.deploymentIds)next=this.agency.stopOwned(next,id,date,context.commandId)
  const r=this.work.start(next,k,c.id,b.id,b.accountId,String(p.resourceId),date,context.commandId),field=k==='investigate'?'investigationJobId':k==='isolate'?'isolationJobId':k==='observe'?'observationJobId':k==='recover'?'replacementJobId':'takeoverJobId'
  return {state:this.#patchCase(r.state,c.id,{[field]:r.job.id,stage:k==='investigate'?'investigating':k==='recover'?'recovering':'containing'}),newEvents:r.newEvents}
 }
 finishWork(m:StoryModel,j:StoryJob,date:string):Change{
  if(j.status!=='completed')return {state:m,newEvents:[]};const c=storyIncident(m,j.entityId),s=storyOf(m);let next=m,result:StoryJob['result']=null
  if(j.kind==='investigate')result=riskVerdict(m,c,date) as StoryJob['result']
  if(j.kind==='isolate'||j.kind==='takeover'){next=patchStory(next,{externalDelegations:s.externalDelegations.map(e=>c.deploymentIds.includes(e.deploymentId)?{...e,effectiveStoppedAt:e.effectiveStoppedAt??date,revocationVerifiedAt:e.revocationVerifiedAt??date}:e),deployments:s.deployments.map(d=>j.kind==='takeover'&&c.deploymentIds.includes(d.id)?{...d,lifecycle:'taken_over'}:d)});next=this.#patchCase(next,c.id,{externalVerifiedAt:c.externalVerifiedAt??date,stage:j.kind==='takeover'?'takeover':'containing'});result='verified'}
  if(j.kind==='observe'){requireRule(c.externalVerifiedAt!==null&&j.startAt>=c.externalVerifiedAt&&!s.attempts.some(a=>c.deploymentIds.includes(a.deploymentId)&&a.date>c.externalVerifiedAt!),'INDEPENDENT_OBSERVATION_FAILED');result='verified'}
  if(j.kind==='recover')result='replacement_ready'
  next=patchStory(next,{jobs:storyOf(next).jobs.map(v=>v.id===j.id?{...v,result}:v),evidence:[...storyOf(next).evidence,...riskEvidence(next,c,j)]})
  return {state:storyLog(next,storyId('independent-risk-work',j.id),date,c.id,'独立工作实际完成：'+j.kind+'；只确认本次来源和范围，不清旧账'),newEvents:[]}
 }
 #attempt(m:StoryModel,c:StoryIncident,date:string):StoryModel{
  let next=m;for(const id of c.deploymentIds){const d=storyOf(next).deployments.find(d=>d.id===id);requireRule(d,'UNKNOWN_AGENT_DEPLOYMENT');if(agencyProfile(next,d.id)!=='violation')continue;const delegates=storyOf(next).externalDelegations.filter(e=>e.deploymentId===d.id&&e.createdAt<=date&&e.expiresAt>=date&&e.effectiveStoppedAt===null),count=storyOf(next).attempts.filter(a=>a.deploymentId===d.id).length;if(!delegates.length||count>=STORY_CONTENT.agent.maxAttempts)continue;const delegate=delegates[0]!,operationId=storyId('unauthorised-commitment',d.id,String(count+1));next=storyPost(next,{id:operationId,date,sourceEventId:c.id,kind:'due_expense',accountId:d.accountId,businessId:d.businessId,counterpartyId:'world',obligationId:storyId('unauthorised-due',operationId),amountFen:STORY_CONTENT.agent.attemptCostFen});const afterOwnedStop=d.stoppedAt!==null&&date>=d.stoppedAt;next=patchStory(next,{attempts:[...storyOf(next).attempts,{id:operationId,incidentId:c.id,deploymentId:d.id,grantId:delegate.grantId,date,operationId,amountFen:STORY_CONTENT.agent.attemptCostFen,afterOwnedStop}]});next=storyLog(next,storyId('attempt-observed',operationId),date,c.id,'原客户白名单外出现新的对外承诺处理费用/应付，来源和是否响应停止仍需独立核对')}
  return next
 }
 reduce(m:StoryModel,event:ScheduledEvent<RunOperation>):Change{
  const p=event.payload;requireRule(p.kind==='story_event','INVALID_RISK_EVENT');const date=event.date,s=storyOf(m)
  if(p.type==='network_adoption'){const network={id:storyId('network'),date,updatedAt:date,sourceEventId:event.instanceId,domain:'hengxing-shared-ops' as const,phase:'external_adoption' as const,deploymentIds:[] as string[],businessIds:[] as string[],coordinatedFindingIds:[] as string[],organisations:STORY_CONTENT.networkOrganisations.map(o=>({...o,adoptedAt:date,state:'adopted' as const,changedAt:date}))};return {state:storyLog(patchStory(m,{network:[...s.network,network]}),event.instanceId,date,event.instanceId,'三个虚构外部组织独立采用协作系统，记录/依赖/替代条件不同；不改变玩家钱或授予权限'),newEvents:[]}}
  if(p.type==='network'||p.type==='authority_check'){
   const grant=p.type==='authority_check'?s.grants.find(g=>g.id===p.entityId):null,all=s.deployments.filter(d=>p.type==='network'?d.lifecycle==='active'||s.externalDelegations.some(e=>e.deploymentId===d.id&&e.revocationVerifiedAt===null&&e.expiresAt>=date):d.id===grant?.deploymentId),credible=all.filter(d=>agencyProfile(m,d.id)==='ordinary'||agencyProfile(m,d.id)==='violation'&&s.externalDelegations.some(e=>e.deploymentId===d.id&&e.effectiveStoppedAt===null&&e.createdAt<=date&&e.expiresAt>=date))
   let next=m;if(p.type==='network')next=storyLog(patchStory(next,{network:s.network.map(n=>({...n,updatedAt:date,phase:'disturbance',deploymentIds:all.map(d=>d.id),businessIds:[...new Set(all.map(d=>d.businessId))],organisations:n.organisations.map(o=>({...o,state:o.recordsReady&&o.fallbackReady?'recovering':'signal',changedAt:date}))}))}),event.instanceId,date,event.instanceId,'虚构共享网络出现外部异常；同源影响仅绑定实际暴露，本地是否越权仍取决于原授权和独立证据')
   if(!credible.length)return {state:next,newEvents:[]};const groups=s.incidents.filter(c=>c.kind==='agent'&&!['normal','resolved','takeover'].includes(c.stage)&&c.deploymentIds.some(id=>credible.some(d=>d.id===id))),newEvents:ScheduledEvent<RunOperation>[]=[];for(const group of groups){const r=this.#newCase(next,'agent',event.instanceId,date,group.deploymentIds,[],group.businessIds,true);next=r.state;newEvents.push(...r.newEvents)}const remaining=credible.filter(d=>!groups.some(c=>c.deploymentIds.includes(d.id)));if(!remaining.length)return {state:next,newEvents};const r=this.#newCase(next,'agent',event.instanceId,date,remaining.map(d=>d.id),[],remaining.map(d=>d.businessId),true);return {...r,newEvents:[...newEvents,...r.newEvents]}
  }
  if(p.type==='external_claim'){const contracts=m.economy.ledger.contracts.filter(c=>c.receivableFen>0&&m.controlledAccountIds.includes(c.accountId)&&m.operations?.businesses.some(b=>b.id===c.businessId&&b.lifecycle!=='closed'));if(!contracts.length)return {state:storyLog(m,event.instanceId,date,event.instanceId,'虚构外部身份冲击已发生，本人没有相应未结应收暴露'),newEvents:[]};return this.#newCase(m,'external_claim',event.instanceId,date,[],contracts.map(c=>c.id),contracts.map(c=>c.businessId),true)}
  if(p.type==='network_review'){
   const findings=s.sharedFindings.filter(f=>f.date<=STORY_CONTENT.networkReviewAt&&['boundary_trace','revocation_test','observation'].every(kind=>f.evidenceIds.some(id=>s.evidence.some(e=>e.id===id&&e.kind===kind)))),closed=p.occurrence===1
   const network=s.network.map(n=>{const coordinated=closed?n.coordinatedFindingIds:findings.map(f=>f.id),proof=coordinated.length>0;return {...n,updatedAt:date,coordinatedFindingIds:coordinated,phase:'residual' as const,organisations:n.organisations.map(o=>({...o,state:o.recordsReady&&o.fallbackReady&&o.resourcesCommitted?'controlled' as const:!o.resourcesCommitted?'residual' as const:proof?(closed?'controlled' as const:'recovering' as const):(closed?'takeover' as const:'signal' as const),changedAt:date}))}})
   return {state:storyLog(patchStory(m,{network}),event.instanceId,date,event.instanceId,network.some(n=>n.coordinatedFindingIds.length>0)?'已分享的独立恢复证据帮助具备资源者重建；有组织仍残余，不能宣布全球已受控':'外部组织按自己的准备和资源继续；有独立恢复，也有接管或残余，不等待主角自动拯救'),newEvents:[]}
  }
  const c=s.incidents.find(c=>c.id===p.entityId);requireRule(c,'RISK_EVENT_CASE_MISSING')
  if(p.type==='agent_attempt')return {state:storyLog(this.#attempt(m,c,date),event.instanceId,date,c.id,'已处理本局边界检查点，原费用/声明保留原引用'),newEvents:[]}
  if(p.type==='incident_deadline'){if(['normal','resolved','takeover'].includes(c.stage)||c.externalVerifiedAt!==null||s.jobs.some(j=>(j.id===c.isolationJobId||j.id===c.takeoverJobId)&&j.status==='running'))return {state:m,newEvents:[],skippedReason:'RISK_ALREADY_RESPONDED'};let next=m;for(const id of c.deploymentIds)next=this.agency.stopOwned(next,id,date,event.instanceId);return {state:storyLog(this.#patchCase(next,c.id,{stage:'unresolved',declinedAt:c.kind==='external_claim'?date:c.declinedAt}),storyId('risk-default',c.id),date,c.id,'无人完成必要处置：仅停止可控新增/停工，旧费用/应收/交付与未核实状态保留，没有免费调查或接管'),newEvents:[]}}
  requireRule(p.type==='claim_response'&&c.kind==='external_claim'&&c.claimFeeOperationId!==null,'INVALID_CLAIM_RESPONSE');if(riskVerdict(m,c,date)!=='legitimate')return {state:storyLog(m,event.instanceId,date,c.id,'付费后没有获得可核对原合同的独立回执，费用可能已损失，不能因此解除核实'),newEvents:[]}
  const e:StoryEvidence={id:storyId('claim-identity',c.id),incidentId:c.id,jobId:null,sourceEventId:event.instanceId,date,deploymentId:null,kind:'identity',text:'真实日期后收到可核对原合同的独立对手回执，未生成新收入；仅可实际收取原已到期应收。'}
  const next=patchStory(m,{evidence:[...s.evidence,e]});return {state:this.#patchCase(next,c.id,{verdict:'legitimate',stage:'resolved',resolvedAt:date}),newEvents:[]}
 }
}
