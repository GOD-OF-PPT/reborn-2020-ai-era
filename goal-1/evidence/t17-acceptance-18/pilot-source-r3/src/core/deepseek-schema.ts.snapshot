import {z} from 'zod'
import {idSchema as id,dateSchema as date,moneySchema as money,safeCount as count,rows} from './record-schemas.ts'
export const dsModel=z.enum(['v2','v3','r1']),dsProduct=z.enum(['deployment','training']),dsTerms=z.enum(['financial','liquidity','board'])
export const deepseekParametersSchema=z.strictObject({proposalAcceptBps:count.max(10000),deliveryAcceptBps:count.max(10000),invitationAuthorityBps:count.max(10000),financingConsentBps:count.max(10000),negotiationAcceptBps:count.max(10000),buyerAcceptBps:count.max(10000),governanceAcceptBps:count.max(10000)})
export type DeepseekParameters=z.infer<typeof deepseekParametersSchema>
const prep=z.strictObject({id,businessId:id,kind:z.enum(['materials','basics','relationship','eligibility']),jobId:id})
const adapter=z.strictObject({id,businessId:id,modelId:dsModel,purpose:dsProduct,jobId:id,consentedAt:date,expiresAt:date})
const outreach=z.strictObject({id,businessId:id,jobId:id,mode:z.enum(['paid','referral']),productId:dsProduct,modelId:dsModel,sourceCohortIds:rows(id),completedAt:date.nullable(),personIds:rows(id)})
const lead=z.strictObject({id,businessId:id,outreachId:id,personId:id,productId:dsProduct,modelId:dsModel,factId:id,maxPriceFen:money,createdAt:date,expiresAt:date,status:z.enum(['open','accepted','declined','expired'])})
const contract=z.strictObject({id,businessId:id,leadId:id,personId:id,productId:dsProduct,modelId:dsModel,scope:z.enum(['pilot','standard']),priceFen:money,prepaymentFen:money,acceptedAt:date,prepaymentOperationId:id,productionJobId:id,originalSupportJobId:id,supportJobId:id,reviewFactId:id,submittedAt:date.nullable(),reviewAt:date.nullable(),accepted:z.boolean().nullable(),remediationJobId:id.nullable(),deliveredAt:date.nullable(),supportPostedAt:date.nullable(),cancelledAt:date.nullable(),status:z.enum(['production','review','rejected','support','completed','cancelled'])})
const delivery=z.strictObject({id,contractId:id,stage:z.enum(['production','support']),date,amountFen:money,prepaidFen:money,creditFen:money,operationIds:rows(id),dueAt:date})
const collection=z.strictObject({id,deliveryId:id,date,amountFen:money,operationId:id})
const refund=z.strictObject({id,contractId:id,date,amountFen:money,operationId:id})
const invitation=z.strictObject({id,businessId:id,source:z.enum(['referral','broker']),createdAt:date,expiresAt:date,classification:z.literal('counterfactual'),authorityFactId:id,consentFactId:id,termsFactId:id,diligenceJobId:id.nullable(),reportAt:date.nullable(),authority:z.boolean().nullable(),financingConsent:z.boolean().nullable(),status:z.enum(['open','declined','expired','used']),brokerPaymentId:id.nullable()})
const negotiation=z.strictObject({id,invitationId:id,businessId:id,jobId:id,classification:z.literal('counterfactual'),kind:z.enum(['new_capital','secondary']),termsId:dsTerms,amountFen:money,unitPriceFen:money,shares:count.min(1),factId:id,createdAt:date,respondedAt:date.nullable(),accepted:z.boolean().nullable(),expiresAt:date,closedAt:date.nullable()})
const agreement=z.strictObject({id,negotiationId:id,invitationId:id,businessId:id,accountId:id,investmentId:id,subjectId:z.literal('deepseek-counterfactual'),classification:z.literal('counterfactual'),kind:z.enum(['new_capital','secondary']),signedAt:date,lockUntil:date,termsId:dsTerms,board:z.boolean(),information:z.boolean(),preemptive:z.boolean(),transferConsent:z.boolean(),initialShares:count.min(1),initialCostFen:money.min(1),shares:count,costFen:money,disposedShares:count,disposedBasisFen:money,lots:rows(z.strictObject({originId:id,shares:count.min(1),costFen:money,remainingShares:count,remainingCostFen:money})),followDecision:z.enum(['pending','participated','declined','defaulted']).nullable(),followAmountFen:money,followAt:date.nullable(),acquisitionOperationIds:rows(id)})
const round=z.strictObject({id,kind:z.enum(['new_capital','secondary']),agreementId:id,date,preMoneyFen:money,newMoneyFen:money,playerMoneyFen:money,otherMoneyFen:money,issuedShares:count,transferredShares:count,totalShares:count,valuationFen:money})
const governance=z.strictObject({id,agreementId:id,businessId:id,jobId:id,policy:z.enum(['independent_audit','commercial_scope']),factId:id,createdAt:date,resolvedAt:date.nullable(),approved:z.boolean().nullable()})
const exit=z.strictObject({id,agreementId:id,businessId:id,jobId:id,factId:id,createdAt:date,shares:count.min(1),referenceUnitPriceFen:money.min(1),referenceRoundId:id,scopeRestricted:z.boolean(),buyerKind:z.enum(['financial','research_partner']).nullable(),responseAt:date.nullable(),buyerWilling:z.boolean().nullable(),unitPriceFen:money.nullable(),expiresAt:date,dueAt:date.nullable(),soldShares:count,operationId:id.nullable(),receivableId:id.nullable(),collectedFen:money,collectionOperationIds:rows(id)})
const policy=z.strictObject({governanceId:id,policy:z.enum(['independent_audit','commercial_scope']),date})
export const deepseekStateSchema=z.strictObject({version:id,catalogHash:z.string().regex(/^[0-9a-f]{64}$/),counterfactualEnabledAt:date.nullable(),preparations:rows(prep),adapters:rows(adapter),outreaches:rows(outreach),leads:rows(lead),contracts:rows(contract),deliveries:rows(delivery),collections:rows(collection),refunds:rows(refund),invitations:rows(invitation),negotiations:rows(negotiation),agreements:rows(agreement),rounds:rows(round),governance:rows(governance),exits:rows(exit),policies:rows(policy)})
export const deepseekEventSchema=z.strictObject({kind:z.literal('deepseek_event'),type:z.enum(['eco_review','eco_support','follow_round']),entityId:id,date})
export type DeepseekState=z.infer<typeof deepseekStateSchema>
export type DeepseekEvent=z.infer<typeof deepseekEventSchema>
export type DeepseekAgreement=z.infer<typeof agreement>
export type DeepseekContract=z.infer<typeof contract>
export type DeepseekContext=import('./operations-types.ts').OperatingContext&{readonly deepseek?:DeepseekState|null}
export type DeepseekIntent={kind:string;[key:string]:unknown}
