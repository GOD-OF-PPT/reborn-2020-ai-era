import type { GameRun,RuleModel } from './run-types.ts'
import type { ScheduledEvent } from './timeline.ts'
import type { RunOperation } from './content-types.ts'
export interface MarketRule {readonly id:string;readonly label:string;readonly lotSize:number;readonly bandBps:number|null;readonly commissionBps:number;readonly minimumCommissionFen:number;readonly sellTaxBps:number;readonly shareLagDays:number;readonly cashLagDays:number;readonly allowOddLotSale:boolean}
export interface MarketAsset {readonly symbol:string;readonly name:string;readonly exposure:'compute'|'interconnect'|'application'|'data'|'media';readonly classification:'simulation';readonly listedAt:string;readonly delistedAt:string|null;readonly initialPriceFen:number;readonly businessIndex:number;readonly themeIndex:number;readonly anchorImpacts:readonly {readonly anchorId:string;readonly bps:number}[];readonly requiredEntitlement:string|null;readonly regimes:readonly {readonly from:string;readonly to:string;readonly ruleId:string;readonly driftBps:number;readonly volatilityBps:number}[]}
export interface QuoteOverride {readonly symbol:string;readonly priceFen:number|null;readonly referencePriceFen:number|null;readonly volume:number;readonly status:'open'|'suspended'|'data_unavailable'}
export interface MarketCheckpoint {readonly id:string;readonly date:string;readonly dataAvailable:boolean;readonly overrides:readonly QuoteOverride[];readonly announcements:readonly {readonly id:string;readonly symbol:string;readonly text:string;readonly classification:'fictional'}[]}
export interface MarketResearchDefinition {readonly id:string;readonly actionPoints:number;readonly costFen:number;readonly days:number;readonly entitlementId:string|null;readonly explanation:string}
export interface MarketCatalog {readonly version:string;readonly mode:'simulation';readonly priceBasis:'raw_unadjusted';readonly rules:readonly MarketRule[];readonly assets:readonly MarketAsset[];readonly checkpoints:readonly MarketCheckpoint[];readonly initialEntitlements:readonly string[];readonly researches:readonly MarketResearchDefinition[];readonly dividends:readonly {readonly id:string;readonly symbol:string;readonly recordAt:string;readonly perShareFen:number;readonly paymentDays:number}[];readonly historical:{readonly status:'unverified';readonly reason:string;readonly requiredEvidence:readonly string[]}}
export interface MarketQuote {readonly checkpointId:string;readonly index:number;readonly date:string;readonly symbol:string;readonly priceFen:number|null;readonly volume:number;readonly status:'open'|'suspended'|'data_unavailable'|'not_listed'|'delisted'|'no_rule';readonly ruleId:string|null;readonly lowerFen:number|null;readonly upperFen:number|null;readonly businessIndex:number;readonly themeIndex:number;readonly anchorIds:readonly string[]}
export interface MarketOrder {readonly id:string;readonly accountId:string;readonly symbol:string;readonly side:'buy'|'sell';readonly quantity:number;readonly remaining:number;readonly limitPriceFen:number;readonly status:'planned'|'pending'|'partially_filled'|'filled'|'cancelled'|'expired';readonly reservationId:string|null;readonly ruleId:string;readonly quoteId:string;readonly submittedAt:string;readonly eligibleIndex:number;readonly expiresIndex:number;readonly sequence:number|null;readonly grossFilledFen:number;readonly feesPaidFen:number;readonly oddLot:boolean;readonly reason:string|null;readonly replacesId:string|null}
export interface MarketPosition {readonly id:string;readonly accountId:string;readonly symbol:string;readonly quantity:number;readonly principalFen:number;readonly buyFeesFen:number;readonly lastMarkIndex:number;readonly lots:readonly {readonly id:string;readonly quantity:number;readonly availableAt:string}[]}
export interface MarketFill {readonly id:string;readonly orderId:string;readonly checkpointId:string;readonly date:string;readonly quantity:number;readonly priceFen:number;readonly grossFen:number;readonly feeFen:number;readonly removedPrincipalFen:number;readonly removedBuyFeesFen:number;readonly realizedProfitFen:number|null;readonly ledgerId:string;readonly receivableId:string|null}
export interface MarketSettlement {readonly id:string;readonly accountId:string;readonly symbol:string;readonly sourceId:string;readonly amountFen:number;readonly dueAt:string;readonly paidAt:string|null;readonly kind:'sale'|'dividend'}
export interface MarketState {readonly catalogVersion:string;readonly catalogHash:string;readonly mode:'simulation';readonly lastQuoteIndex:number;readonly lastMatchedIndex:number;readonly quotes:readonly MarketQuote[];readonly history:readonly MarketQuote[];readonly orders:readonly MarketOrder[];readonly positions:readonly MarketPosition[];readonly fills:readonly MarketFill[];readonly settlements:readonly MarketSettlement[];readonly permissions:readonly {readonly id:string;readonly date:string;readonly sourceId:string}[];readonly researches:readonly {readonly id:string;readonly definitionId:string;readonly startAt:string;readonly completeAt:string;readonly actionId:string;readonly status:'running'|'completed'|'interrupted'}[];readonly appliedAnchorIds:readonly string[];readonly processedDividends:readonly string[];readonly nextSequence:number;readonly logs:readonly {readonly id:string;readonly date:string;readonly sourceEventId:string;readonly text:string;readonly parentIds:readonly string[];readonly visibility:'visible'}[]}
export interface MarketEvent {readonly kind:'market_event';readonly type:'quote'|'match'|'settlement'|'dividend'|'research';readonly entityId:string;readonly date:string}
export type MarketIntent = {readonly kind:'PlaceStockOrder'|'PlanStockOrder';readonly accountId:string;readonly symbol:string;readonly side:'buy'|'sell';readonly quantity:number;readonly limitPriceFen:number;readonly quoteId:string;readonly validUntil:string}|{readonly kind:'SubmitStockOrder';readonly orderId:string;readonly quoteId:string}|{readonly kind:'CancelStockOrder';readonly orderId:string}|{readonly kind:'AmendStockOrder';readonly orderId:string;readonly quantity:number;readonly limitPriceFen:number;readonly quoteId:string;readonly validUntil:string}|{readonly kind:'ResearchMarket';readonly definitionId:string}|{readonly kind:'StopMarketResearch';readonly researchId:string}|{readonly kind:'UseHistoricalReplay'}
export type MarketContext=Pick<RuleModel,'controlledAccountIds'|'economy'|'operations'|'market'|'phase'>
export type MarketModel=Omit<RuleModel,'timeline'>
export interface MarketReducer {reduce(state:MarketModel,event:ScheduledEvent<RunOperation>):{readonly state:MarketModel;readonly newEvents?:readonly ScheduledEvent<RunOperation>[];readonly pauseReason?:string;readonly skippedReason?:string};validate(run:GameRun):void}
