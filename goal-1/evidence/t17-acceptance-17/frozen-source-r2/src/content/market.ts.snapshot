import { monthEnd } from '../core/calendar.ts'
/** Fictional prices and calendar-day settlement. None of these rules claim historical A-share accuracy. */
const rule=(id:string,label:string,lotSize:number,bandBps:number|null,minimumCommissionFen:number,shareLagDays:number,cashLagDays:number,commissionBps=10,sellTaxBps=0)=>({id,label,lotSize,bandBps,commissionBps,minimumCommissionFen,sellTaxBps,shareLagDays,cashLagDays,allowOddLotSale:true})
const rows=[['SIM-AI01','衡川算力','compute','SIM-R1',11988,-10,100,100],['SIM-AI02','青棱互联','interconnect','SIM-R2',2500,15,80,110],['SIM-AI03','见微模型','application','SIM-R3',1800,30,50,130],['SIM-AI04','澄数数据','data','SIM-R4',3200,-15,120,90],['SIM-AI05','映河传媒','media','SIM-R5',900,-35,60,150]] as const
const assets=rows.map(([symbol,name,exposure,ruleId,initialPriceFen,driftBps,businessIndex,themeIndex])=>({symbol,name,exposure,classification:'simulation',listedAt:'2020-01-01',delistedAt:null,initialPriceFen,businessIndex,themeIndex,anchorImpacts:[{anchorId:'H001',bps:exposure==='application'?300:100},{anchorId:'H003',bps:exposure==='media'?-300:exposure==='application'?500:200},{anchorId:'H008',bps:exposure==='data'?-200:200},{anchorId:'H009',bps:exposure==='compute'?-200:exposure==='application'?300:0}],requiredEntitlement:'sim-basic',regimes:[{from:'2020-01-01',to:'2025-12-31',ruleId,driftBps,volatilityBps:100}]}))
const checkpoints=[]
for(let year=2020;year<=2025;year++)for(let month=1;month<=12;month++){const start=`${year}-${String(month).padStart(2,'0')}-01`;for(const date of [start.slice(0,8)+'10',start.slice(0,8)+'20',monthEnd(start)]){const overrides=[];if(date==='2020-01-10')overrides.push({symbol:'SIM-AI01',priceFen:11988,referencePriceFen:11988,volume:5000,status:'open'});if(date==='2020-03-31')overrides.push({symbol:'SIM-AI01',priceFen:11000,referencePriceFen:11988,volume:5000,status:'open'});if(date==='2020-01-10')overrides.push({symbol:'SIM-AI05',priceFen:900,referencePriceFen:900,volume:0,status:'open'});if(date==='2020-01-20')overrides.push({symbol:'SIM-AI04',priceFen:3200,referencePriceFen:3200,volume:0,status:'suspended'});checkpoints.push({id:`SIM-CP-${date}`,date,dataAvailable:true,overrides,announcements:date==='2022-11-30'?[{id:'SIM-NOTICE-CHAT',symbol:'SIM-AI03',text:'题材关注增加不等于订单收入，价格反应为模拟。',classification:'fictional'}]:[]})}}
export const MARKET_CONTENT={version:'simulation-market-work-v2',mode:'simulation',priceBasis:'raw_unadjusted',rules:[rule('SIM-R1','模拟研习段：100股/20%边界/最低12元费',100,2000,1200,1,0),rule('SIM-R2','模拟互联段：50股/10%边界',50,1000,500,1,1),rule('SIM-R3','模拟应用段：10股/30%边界',10,3000,0,1,2,15,5),rule('SIM-R4','模拟数据段：100股/20%边界',100,2000,500,1,1),rule('SIM-R5','模拟传媒段：100股/无固定价格边界',100,null,0,1,0)],assets:[...assets,{...assets[2],symbol:'SIM-EX01',name:'星野试验应用',listedAt:'2023-01-01',requiredEntitlement:'sim-experimental-access'}],checkpoints,initialEntitlements:['sim-basic'],researches:[{id:'market-overview',actionPoints:1,costFen:0,days:1,entitlementId:null,explanation:'整理已公开行情与行业链；不揭示未来价格。'},{id:'market-foundation-course',actionPoints:1,costFen:300000,days:7,entitlementId:'sim-researched',explanation:'模拟规则研习：区分现金、持仓、费用、流动性。不是现实投资建议。'},{id:'simulation-special-study',actionPoints:1,costFen:10000,days:7,entitlementId:'sim-experimental-access',explanation:'取得本游戏试验段资格，不代表真实券商或融资权限。'}],dividends:[{id:'SIM-DIV-2024-06',symbol:'SIM-AI03',recordAt:'2024-06-20',perShareFen:10,paymentDays:2}],historical:{status:'unverified',reason:'真实历史行情/板块逐期制度/公司行动/使用条件未核验，禁止启用。',requiredEvidence:['逐日期行情与上市/停牌覆盖','当时生效规则与公司行动口径','可追溯一手来源及使用条件']}}
