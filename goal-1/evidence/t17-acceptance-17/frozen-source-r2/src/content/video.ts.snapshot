import type { JobDefinition } from '../core/operations-types.ts';
/** All prices, conversion rates and platform terms below are fictional game parameters. */
export const VIDEO_CONTENT = { version: 'video-work-v2', products: [{ id: 'hotspot', label: '热点样片', priceFen: 0 }, { id: 'original_series', label: '原创系列', priceFen: 0 }, { id: 'commercial', label: '垂直商家商单', priceFen: 300000 }], modes: [{ id: 'manual', label: '手工剪辑', capability: 'manual_editing', from: '2020-01-01', anchorId: null }, { id: 'image_assisted', label: '图像辅助制作', capability: 'stable_diffusion_local', from: '2022-08-22', anchorId: 'H002' }, { id: 'generative_video', label: '生成式视频', capability: 'kling_video', from: '2024-06-06', anchorId: 'H007' }], programs: [{ id: 'image_rights', from: '2022-08-22', anchorId: 'H002', entitlement: 'local_model_rights_and_hardware', jobId: 'video-apply-image_rights' }, { id: 'video_access', from: '2024-06-06', anchorId: 'H007', entitlement: 'kling_access', jobId: 'video-apply-video_access' }, { id: 'ads', from: '2020-01-01', anchorId: null, entitlement: null, jobId: 'video-apply-ads' }, { id: 'affiliate', from: '2020-01-01', anchorId: null, entitlement: null, jobId: 'video-apply-affiliate' }], revisionCount: null, commercial: { priceFen: 300000, prepaymentFen: 90000, feeBps: 500, reviewDays: 2, paymentDays: 7, deadlineDays: 180, includedRevisions: 1 }, qualityDefectBps: 2000, marketingMatchBps: 8000, applicationAcceptBps: 7500, affiliateUnitPriceFen: 10000, affiliateCommissionFen: 1000, platformFeeBps: 500, labelEffectiveAt: '2025-09-01' } as const;
export const VIDEO_JOBS: readonly JobDefinition[] = [
    ...VIDEO_CONTENT.products.flatMap(product => VIDEO_CONTENT.modes.flatMap(mode => (['original', 'licensed'] as const).map(material => ({ id: `video-make-${product.id}-${mode.id}-${material}`, purpose: 'production' as const, routes: ['ai_video' as const], skill: 'manual_editing', durationDays: mode.id === 'manual' ? (product.id === 'hotspot' ? 7 : 14) : mode.id === 'image_assisted' ? 7 : 5, actionPoints: 1, costFen: (mode.id === 'manual' ? (product.id === 'hotspot' ? 60000 : 90000) : mode.id === 'image_assisted' ? 70000 : 60000) + (material === 'licensed' ? 30000 : 0), output: 'video-draft' })))),
    { id: 'video-rework', purpose: 'production', routes: ['ai_video'], skill: 'manual_editing', durationDays: 7, actionPoints: 1, costFen: 30000, output: 'video-revised' },
    { id: 'video-marketing', purpose: 'maintenance', routes: ['ai_video'], skill: 'general', durationDays: 7, actionPoints: 1, costFen: 60000, output: 'qualified-audience' },
    { id: 'video-negotiate', purpose: 'maintenance', routes: ['ai_video'], skill: 'general', durationDays: 3, actionPoints: 1, costFen: 0, output: 'client-negotiation' },
    ...VIDEO_CONTENT.programs.map(p => ({ id: p.jobId, purpose: 'maintenance' as const, routes: ['ai_video' as const], skill: 'general', durationDays: 7, actionPoints: 1, costFen: p.id === 'image_rights' ? 100000 : p.id === 'video_access' ? 50000 : 10000, output: 'fictional-program-review' }))
];
