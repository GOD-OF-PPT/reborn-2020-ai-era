/* The teaching folio and its paper are local to the existing cinematic room. */
.course-choice-paper .course-paper-kicker{color:#7b755f;font:13px/1.8 var(--serif);letter-spacing:1px}
.course-choice-paper .course-paper-terms{padding:12px 0;border-block:1px solid #ad967066;color:#5b573f;font:16px/1.9 var(--serif)}
.course-choice-paper .course-paper-choices{border:0;margin:14px 0;padding:0;display:grid;gap:0}
.course-choice-paper .course-paper-choices legend{font:18px/1.8 var(--serif);color:#65563f;margin-bottom:10px}
.course-choice-paper .course-paper-choices>label{display:flex;gap:13px;align-items:flex-start;padding:13px 3px;border-bottom:1px solid #ad967055;break-inside:avoid;cursor:pointer}
.course-choice-paper .course-paper-choices input{flex:none;accent-color:#806b48;margin-top:7px}
.course-choice-paper .course-paper-choices>label>span{font:17px/1.8 var(--serif);color:#5c533d}
.course-choice-paper .course-paper-choices small{display:block;font:14px/1.8 var(--serif);color:#746d58;margin-top:4px}
.course-choice-paper .course-paper-choices>label:has(input:checked){border-left:2px solid #99794b;padding-left:12px;background:#9b80540b}
.course-choice-paper .course-paper-choices>label:focus-within{outline:2px solid #91784e;outline-offset:3px}
.course-choice-paper .course-schedule-fields,.course-choice-paper .course-definition-fields{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:18px 24px;align-items:start;break-inside:avoid}
.course-choice-paper .course-schedule-fields>div{min-width:0}
.course-choice-paper .course-schedule-fields .field{margin:0}
.course-choice-paper .course-paper-directions{display:grid;gap:10px;margin:16px 0}
.course-choice-paper .course-paper-directions>button,.course-choice-paper .course-paper-direction{display:block;width:fit-content;max-width:100%;padding:10px 3px;border:0;border-bottom:1px solid #ad967066;background:none;text-align:left;font:17px/1.8 var(--serif);color:#725b3c}
.course-choice-paper .course-paper-directions small{display:block;font:14px/1.8 var(--serif);color:#756c54}
.course-choice-paper .course-paper-warning{border-left:2px solid #ad6d4d;padding:10px 12px;background:#ac80590a;color:#89583d;font:15px/1.85 var(--serif)}
.course-choice-paper .course-paper-check{display:flex;align-items:flex-start;gap:12px;font:16px/1.9 var(--serif);color:#655a42;break-inside:avoid}
.course-choice-paper .course-paper-receipt{border-left:3px double #9b7c4f;padding:12px 0 12px 14px;color:#67593f;font:16px/1.9 var(--serif)}
.course-choice-paper .preparation-capital{display:flex;gap:12px;flex-wrap:wrap;margin:14px 0}
.course-choice-paper .preparation-capital>button{padding:10px 14px;border:1px solid #b59b73;background:transparent;color:#67583f;font:16px/1.8 var(--serif)}
.course-choice-paper .preparation-capital>button[aria-pressed=true]{outline:2px solid #9b7c4f;outline-offset:3px}
.course-choice-paper .preparation-capital small{display:block;font:14px/1.8 var(--serif)}
.cinema-app .course-choice-paper>.course-choice-footer{flex:none;display:flex;align-items:center;gap:12px 20px;flex-wrap:wrap;padding-top:14px;margin-top:12px;border-top:1px solid #ad986566}
.course-choice-footer>button,.course-choice-footer .command>button{padding:10px 14px;font:15px/1.8 var(--serif)}
.course-choice-footer .course-record-link{border:0;border-bottom:1px solid #ad967055;padding-inline:0;background:none;color:#715c3e}
.course-choice-footer .clock-advance{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
.course-choice-footer .clock-main>button{padding:10px 14px;font:15px/1.8 var(--serif)}
.course-choice-footer .clock-review>button{padding:8px 0;border:0;border-bottom:1px solid #ad967055;background:none;color:#715c3e;font:13px/1.8 var(--serif)}
/* Keep the whole low folio above its separate text slip and the navigation band. */
.opening-room>.opening-object[data-appearance=course],.opening-room .opening-room-object>.opening-object[data-appearance=course]{grid-template-rows:minmax(0,1fr) auto;gap:10px}
.opening-room>.opening-object[data-appearance=course]>.opening-object-art,.opening-room .opening-room-object>.opening-object[data-appearance=course]>.opening-object-art{aspect-ratio:3/2;align-self:end;height:auto;width:100%;filter:drop-shadow(1px 8px 5px #00171b88)}
.opening-object[data-appearance=course] .opening-object-copy{transform:none;background:linear-gradient(90deg,#25302be8,#1b2e2cbb);border-left-color:#d1b583}
.opening-object[data-appearance=course] .opening-object-mark{right:21%;top:49%;border-radius:0;background:#e0cfaaeb;border-color:#96774f}
.opening-object[data-appearance=course][data-kind=calendar] .opening-object-mark{border-style:dashed}
.opening-object[data-appearance=course][data-kind=waiting] .opening-object-copy{border-left-style:dashed}
.opening-object[data-appearance=course][data-kind=receipt] .opening-object-copy{border-left:3px double #d1b583}
.opening-object[data-appearance=course][data-kind=receipt] .opening-object-mark{border-style:double;background:#e3d5b6e8}
.opening-room>.opening-object[data-appearance=course][data-text-only=true],.text-mode .opening-room>.opening-object[data-appearance=course],.opening-room .opening-room-object>.opening-object[data-appearance=course][data-text-only=true],.text-mode .opening-room .opening-room-object>.opening-object[data-appearance=course]{grid-template-rows:auto;gap:0;align-content:start}
