{
  "name": "reborn-2020-ai-era",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "npm@10.9.0",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --strictPort",
    "typecheck": "tsc -b",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:docs": "python3 -B -m unittest discover -s scripts -p 'test_*.py'",
    "check:docs": "python3 -B scripts/check_docs.py --text-only && python3 -B scripts/check_plan.py && python3 -B scripts/check_competitive_design.py",
    "check": "npm run typecheck && npm run test:unit && npm run test:docs && npm run check:docs && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "6.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
